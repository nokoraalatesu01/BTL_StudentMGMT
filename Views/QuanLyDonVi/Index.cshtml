@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.DonViListItemViewModel>
@{
    ViewData["Title"] = "Quản lý đơn vị";
    Layout = "_AdminLayout";
    var tuKhoa = ViewBag.TuKhoa as string;
    var loaiDonVi = ViewBag.LoaiDonVi as string;
    var trangThai = ViewBag.TrangThai as string;
}

<!-- ===== HEADER ===== -->
<div class="mb-4">
    <p class="mb-1" style="font-size:.8rem; color:#64748b;">
        <span style="color:#94a3b8;">HỆ THỐNG TỔ CHỨC</span>
        <span style="color:#cbd5e1; margin:0 6px;">›</span>
        <span style="color:#2563eb; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.07em;">CƠ CẤU ĐƠN VỊ</span>
    </p>
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
                Quản lý đơn vị &amp; Khoa phòng
            </h3>
            <p class="mb-0" style="font-size:.875rem; color:#64748b; max-width:640px;">
                Quản lý danh mục các trường, khoa đào tạo, viện, bộ môn và các phòng ban trực thuộc trong hệ thống UTC. Đơn vị được liên kết với giảng viên, ngành và môn học.
            </p>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <a asp-action="Create"
               class="btn d-inline-flex align-items-center gap-2 text-white"
               style="background:#2563eb; border:none; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 18px;">
                <i class="bi bi-plus-lg"></i> Thêm đơn vị mới
            </a>
        </div>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill"></i>
        <div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
<div class="content-card p-3 mb-4">
    <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center filter-card-form">
        <div class="input-group" style="max-width:360px; flex:1;">
            <span class="input-group-text border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control border-start-0" placeholder="Tìm theo mã đơn vị, tên đơn vị, email..." />
        </div>
        <select name="loaiDonVi" class="form-select" style="width:200px;">
            <option value="">-- Tất cả loại đơn vị --</option>
            <option value="TRUONG" selected="@(loaiDonVi == "TRUONG")">Trường / Ban Giám hiệu</option>
            <option value="KHOA" selected="@(loaiDonVi == "KHOA")">Khoa / Viện đào tạo</option>
            <option value="BO_MON" selected="@(loaiDonVi == "BO_MON")">Bộ môn</option>
            <option value="PHONG" selected="@(loaiDonVi == "PHONG")">Phòng ban chức năng</option>
            <option value="TRUNG_TAM" selected="@(loaiDonVi == "TRUNG_TAM")">Trung tâm</option>
        </select>
        <select name="trangThai" class="form-select" style="width:175px;">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="ACTIVE" selected="@(trangThai == "ACTIVE")">Hoạt động</option>
            <option value="INACTIVE" selected="@(trangThai == "INACTIVE")">Ngưng hoạt động</option>
        </select>
        <button type="submit" class="btn-filter"><i class="bi bi-funnel"></i> Lọc</button>
        <a asp-action="Index" class="btn-reset" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
    </form>
</div>

<!-- ===== BẢNG DANH SÁCH ĐƠN VỊ ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>MÃ ĐƠN VỊ</th>
                    <th>TÊN ĐƠN VỊ</th>
                    <th>LOẠI</th>
                    <th>ĐƠN VỊ CHA</th>
                    <th>LIÊN HỆ</th>
                    <th>DỮ LIỆU LIÊN KẾT</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end" style="padding-right:1.25rem;">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-inbox fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            Không tìm thấy đơn vị nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <span style="font-weight:700; color:#2563eb; font-family:monospace; font-size:.85rem;">@item.MaDonVi</span>
                            </td>
                            <td>
                                <div style="font-weight:700; color:#0f172a; font-size:.875rem;">@item.TenDonVi</div>
                            </td>
                            <td>
                                @if (item.LoaiDonVi == "TRUONG")
                                {
                                    <span class="badge-subtle" style="background:#eff6ff; color:#2563eb;">Trường</span>
                                }
                                else if (item.LoaiDonVi == "KHOA")
                                {
                                    <span class="badge-subtle" style="background:#e0f2fe; color:#0284c7;">Khoa / Viện</span>
                                }
                                else if (item.LoaiDonVi == "PHONG")
                                {
                                    <span class="badge-subtle" style="background:#f1f5f9; color:#475569;">Phòng ban</span>
                                }
                                else if (item.LoaiDonVi == "BO_MON")
                                {
                                    <span class="badge-subtle" style="background:#dcfce7; color:#16a34a;">Bộ môn</span>
                                }
                                else
                                {
                                    <span class="badge-subtle" style="background:#f1f5f9; color:#64748b;">@item.LoaiDonVi</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.TenDonViCha))
                                {
                                    <span style="color:#64748b; font-size:.83rem;"><i class="bi bi-arrow-return-right me-1"></i>@item.TenDonViCha</span>
                                }
                                else
                                {
                                    <span style="color:#94a3b8; font-style:italic; font-size:.83rem;">Trực tiếp</span>
                                }
                            </td>
                            <td>
                                <div style="font-size:.83rem; color:#475569;">
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <div><i class="bi bi-envelope text-muted me-1"></i>@item.Email</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.DienThoai))
                                    {
                                        <div><i class="bi bi-telephone text-muted me-1"></i>@item.DienThoai</div>
                                    }
                                    @if (string.IsNullOrEmpty(item.Email) && string.IsNullOrEmpty(item.DienThoai))
                                    {
                                        <span style="color:#94a3b8;">--</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap" style="font-size:.78rem;">
                                    <span class="badge-subtle" style="background:#f1f5f9; color:#64748b;" title="Số ngành đào tạo">
                                        <i class="bi bi-diagram-3 me-1"></i>@item.SoNganh Ngành
                                    </span>
                                    <span class="badge-subtle" style="background:#f1f5f9; color:#64748b;" title="Số giảng viên">
                                        <i class="bi bi-person-workspace me-1"></i>@item.SoGiangVien GV
                                    </span>
                                    <span class="badge-subtle" style="background:#f1f5f9; color:#64748b;" title="Số môn học">
                                        <i class="bi bi-book me-1"></i>@item.SoMonHoc Môn
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (item.TrangThai == "ACTIVE")
                                {
                                    <span class="badge-subtle" style="background:#dcfce7; color:#16a34a;">
                                        <i class="bi bi-check-circle me-1"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-subtle" style="background:#fee2e2; color:#dc2626;">
                                        <i class="bi bi-pause-circle me-1"></i>Ngưng HĐ
                                    </span>
                                }
                            </td>
                            <td class="text-end text-nowrap" style="padding-right:1.25rem;">
                                <a asp-action="Edit" asp-route-id="@item.DonViId" class="icon-action-btn edit" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="icon-action-btn delete" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.DonViId" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </button>

                                <!-- Modal Xác Nhận Xóa -->
                                <div class="modal fade" id="deleteModal-@item.DonViId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fs-6 fw-bold">Xác nhận xử lý đơn vị</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Bạn có chắc chắn muốn xóa đơn vị <strong style="color:#2563eb;">@item.TenDonVi</strong> (Mã: <code>@item.MaDonVi</code>)?</p>
                                                @if (item.SoGiangVien > 0 || item.SoMonHoc > 0 || item.SoNganh > 0 || item.SoDonViCon > 0)
                                                {
                                                    <div class="alert alert-warning py-2 px-3 mb-0" style="font-size:.85rem;">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                                        Đơn vị này đang có dữ liệu liên kết. Hệ thống sẽ tự động chuyển sang trạng thái <strong>NGẮNG HOẠT ĐỘNG</strong> để bảo toàn dữ liệu.
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                                                <form asp-action="Delete" asp-route-id="@item.DonViId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Xác nhận</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center px-3 py-2" style="border-top:1px solid #f1f5f9; background:#fafbfc; font-size:.82rem; color:#64748b;">
            <div>
                Trang <strong style="color:#1e293b;">@Model.Page</strong> / <strong style="color:#1e293b;">@Model.TotalPages</strong>
                &nbsp;&nbsp;|&nbsp;&nbsp; Tổng: <strong style="color:#1e293b;">@Model.TotalItems</strong> đơn vị
            </div>
            <nav aria-label="Phân trang đơn vị">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link sv-page-btn" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-tuKhoa="@tuKhoa" asp-route-loaiDonVi="@loaiDonVi" asp-route-trangThai="@trangThai">&#8249; Trước</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link sv-page-btn @(p == Model.Page ? "sv-page-active" : "")" asp-action="Index" asp-route-page="@p"
                               asp-route-tuKhoa="@tuKhoa" asp-route-loaiDonVi="@loaiDonVi" asp-route-trangThai="@trangThai">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link sv-page-btn" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-tuKhoa="@tuKhoa" asp-route-loaiDonVi="@loaiDonVi" asp-route-trangThai="@trangThai">Sau &#8250;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
