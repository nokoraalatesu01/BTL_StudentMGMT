@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.GiangVien>
@{
    ViewData["Title"] = "Quản lý giảng viên";

    var avatarColors = new[] { "gray", "pink", "cyan", "purple", "green" };
    int startRecord = (Model.Page - 1) * Model.PageSize + 1;
    int endRecord   = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<!-- ===== HEADER ===== -->
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <!-- Breadcrumb -->
        <p class="mb-1" style="font-size:.8rem; color:#64748b;">
            <span style="color:#94a3b8;">Đào tạo</span>
            <span style="color:#cbd5e1; margin:0 5px;">›</span>
            <span style="color:#6366f1; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.06em;">NHÂN SỰ HỌC THUẬT</span>
        </p>
        <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
            Quản lý giảng viên
        </h3>
        <p class="mb-0" style="font-size:.875rem; color:#64748b;">
            Danh sách hồ sơ giảng viên, học hàm học vị và tài khoản liên kết hệ thống.
        </p>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
        <button type="button" class="btn d-inline-flex align-items-center gap-2"
                style="border:1px solid #d1d5db; background:#fff; color:#374151; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 16px;">
            <i class="bi bi-download" style="font-size:.85rem;"></i> Xuất Excel
        </button>
        <a asp-action="Create"
           class="btn d-inline-flex align-items-center gap-2 text-white"
           style="background:#2563eb; border:none; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 18px;">
            <i class="bi bi-person-plus" style="font-size:.9rem;"></i> + Thêm giảng viên
        </a>
    </div>
</div>

@if (TempData["Msg"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><div>@message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i><div>@error</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== STAT CARDS ===== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">TỔNG SỐ GIẢNG VIÊN</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@Model.TotalItems</div>
                    <div style="font-size:.78rem; color:#16a34a; margin-top:2px; font-weight:600;">100% tài khoản kích hoạt</div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#eff6ff; display:flex; align-items:center; justify-content:center; color:#3b82f6; font-size:1.2rem;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">GIÁO SƯ / PHÓ GIÁO SƯ</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">
                        @Model.Items.Count(g => g.HoTen.Contains("GS.") || g.HoTen.Contains("PGS."))
                    </div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">Chiếm 28.5% nhân sự</div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#ede9fe; display:flex; align-items:center; justify-content:center; color:#7c3aed; font-size:1.2rem;">
                    <i class="bi bi-award"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">TIẾN SĨ / THẠC SĨ</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">
                        @Model.Items.Count(g => g.HoTen.Contains("TS.") || g.HoTen.Contains("ThS."))
                    </div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">
                        @Model.Items.Count(g => g.HoTen.Contains("TS.")) Tiến sĩ,
                        @Model.Items.Count(g => g.HoTen.Contains("ThS.")) Thạc sĩ
                    </div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#dcfce7; display:flex; align-items:center; justify-content:center; color:#16a34a; font-size:1.2rem;">
                    <i class="bi bi-mortarboard"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">LỚP PHỤ TRÁCH KỲ NÀY</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">54</div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">Học kỳ II (2025 – 2026)</div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#fef3c7; display:flex; align-items:center; justify-content:center; color:#d97706; font-size:1.2rem;">
                    <i class="bi bi-book"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== TÌM KIẾM ===== -->
<div class="content-card p-3 mb-3">
    <p style="font-size:.82rem; font-weight:600; color:#374151; margin-bottom:8px;">Tìm theo mã hoặc họ tên</p>
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group" style="flex:1; max-width:400px;">
            <span class="input-group-text bg-white border-end-0 pe-1 text-muted" style="border-color:#d1d5db;">
                <i class="bi bi-search" style="font-size:.85rem;"></i>
            </span>
            <input id="tuKhoa" name="tuKhoa" value="@ViewBag.TuKhoa"
                   class="form-control border-start-0 ps-1"
                   style="border-color:#d1d5db; font-size:.875rem;"
                   placeholder="Nhập mã hoặc họ tên giảng viên..." />
        </div>
        <button type="submit" class="btn d-inline-flex align-items-center gap-2"
                style="background:#2563eb; color:#fff; border:none; font-size:.875rem; font-weight:600; height:38px; border-radius:8px; padding:0 18px;">
            <i class="bi bi-search" style="font-size:.82rem;"></i> Tìm kiếm
        </button>
        <a asp-action="Index" class="btn d-inline-flex align-items-center gap-2"
           style="border:1px solid #d1d5db; background:#fff; color:#374151; font-size:.875rem; font-weight:600; height:38px; border-radius:8px; padding:0 14px;">
            <i class="bi bi-arrow-counterclockwise"></i> Xóa lọc
        </a>
        <span class="ms-auto" style="font-size:.82rem; color:#64748b; display:flex; align-items:center; gap:6px;">
            <i class="bi bi-shield-check" style="color:#16a34a;"></i>
            Dữ liệu đồng bộ máy chủ đào tạo
        </span>
    </form>
</div>

<!-- ===== BẢNG GIẢNG VIÊN ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width:130px;">
                        MÃ GIẢNG VIÊN <i class="bi bi-chevron-expand ms-1" style="font-size:.6rem; color:#94a3b8;"></i>
                    </th>
                    <th>
                        HỌ VÀ TÊN <i class="bi bi-chevron-expand ms-1" style="font-size:.6rem; color:#94a3b8;"></i>
                    </th>
                    <th>EMAIL LIÊN HỆ</th>
                    <th style="width:120px;">ĐIỆN THOẠI</th>
                    <th style="width:110px;">TÀI KHOẢN</th>
                    <th class="text-end" style="width:160px; padding-right:1.25rem;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 0; }
                @foreach (var item in Model.Items)
                {
                    var colorClass = avatarColors[idx % avatarColors.Length]; idx++;
                    string initials = string.IsNullOrWhiteSpace(item.HoTen) ? "?"
                        : item.HoTen.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[0].ToString().ToUpperInvariant();

                    // Tách học hàm & tên thuần
                    string[] parts = item.HoTen.Split('.', 2, StringSplitOptions.TrimEntries);
                    string hocHam  = parts.Length > 1 ? parts[0] + "." : "";
                    string tenThua = parts.Length > 1 ? parts[1].Trim() : item.HoTen;

                    // Khoa giả sử từ DonVi (nếu load), fallback
                    string khoaTen = item.DonVi?.TenDonVi ?? "Khoa chưa cập nhật";

                    <tr>
                        <!-- MÃ GV -->
                        <td>
                            <span style="font-weight:700; color:#2563eb; font-size:.875rem;">@item.MaGiangVien</span>
                        </td>

                        <!-- HỌ TÊN -->
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="@item.HinhAnh" alt="@item.HoTen" class="avatar-round" style="width:36px; height:36px; border-radius:50%; object-fit:cover; flex-shrink:0;" />
                                }
                                else
                                {
                                    <div class="avatar-round @colorClass"
                                         style="width:36px; height:36px; font-size:.82rem; font-weight:700; flex-shrink:0;">
                                        @initials
                                    </div>
                                }
                                <div>
                                    <div style="font-weight:700; color:#1e293b; font-size:.875rem; line-height:1.3;">@item.HoTen</div>
                                    <small style="color:#94a3b8; font-size:.775rem;">@khoaTen</small>
                                </div>
                            </div>
                        </td>

                        <!-- EMAIL -->
                        <td style="color:#475569; font-size:.875rem;">
                            @(item.Email ?? "—")
                        </td>

                        <!-- ĐIỆN THOẠI -->
                        <td style="color:#475569; font-size:.875rem; font-family:monospace; letter-spacing:.03em;">
                            @(item.SoDienThoai ?? "—")
                        </td>

                        <!-- TÀI KHOẢN -->
                        <td>
                            @if (item.User != null)
                            {
                                <span style="display:inline-block; padding:3px 10px; background:#eff6ff; color:#2563eb; font-size:.78rem; font-weight:700; border-radius:20px;">
                                    @item.User.UserName
                                </span>
                            }
                            else
                            {
                                <span style="color:#94a3b8; font-size:.8rem; font-style:italic;">Chưa cấp</span>
                            }
                        </td>

                        <!-- THAO TÁC -->
                        <td class="text-end text-nowrap" style="padding-right:1.25rem;">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm d-inline-flex align-items-center gap-1"
                               style="border:1px solid #d1d5db; background:#fff; color:#374151; font-size:.78rem; font-weight:600; border-radius:6px; padding:4px 10px; margin-right:4px;">
                                Xem
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm d-inline-flex align-items-center gap-1"
                               style="border:1px solid #bfdbfe; background:#fff; color:#2563eb; font-size:.78rem; font-weight:600; border-radius:6px; padding:4px 10px; margin-right:4px;">
                                <i class="bi bi-pencil" style="font-size:.72rem;"></i> Sửa
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa hồ sơ giảng viên @Html.Raw(item.HoTen.Replace("'","\\'")) và tài khoản liên kết?');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm d-inline-flex align-items-center gap-1"
                                        style="border:1px solid #fecaca; background:#fff; color:#dc2626; font-size:.78rem; font-weight:600; border-radius:6px; padding:4px 10px;">
                                    <i class="bi bi-trash3" style="font-size:.72rem;"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }

                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-inbox fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            <span style="font-size:.9rem;">Không tìm thấy giảng viên nào.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer phân trang -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 px-3 py-2"
         style="border-top:1px solid #f1f5f9; background:#fafbfc;">
        <div style="font-size:.82rem; color:#64748b;">
            Hiển thị <strong style="color:#1e293b;">@startRecord – @endRecord</strong>
            trên tổng số <strong style="color:#1e293b;">@Model.TotalItems</strong> giảng viên
            &nbsp;|&nbsp; Số dòng mỗi trang:&nbsp;
            <select class="form-select d-inline-block"
                    style="width:auto; height:28px; padding:0 20px 0 8px; font-size:.78rem; border-color:#e2e8f0; display:inline-block !important;">
                <option>10</option><option>20</option><option>50</option>
            </select>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link sv-page-btn"
                           asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-tuKhoa="@ViewBag.TuKhoa">
                            &lsaquo; Trước
                        </a>
                    </li>
                    @{
                        int totalP = Model.TotalPages; int curP = Model.Page;
                        var pages = new List<int?>();
                        if (totalP <= 7) { for (int i = 1; i <= totalP; i++) pages.Add(i); }
                        else {
                            pages.Add(1);
                            if (curP > 3) pages.Add(null);
                            for (int i = Math.Max(2, curP-1); i <= Math.Min(totalP-1, curP+1); i++) pages.Add(i);
                            if (curP < totalP-2) pages.Add(null);
                            pages.Add(totalP);
                        }
                    }
                    @foreach (var pg in pages)
                    {
                        if (pg == null) {
                            <li class="page-item disabled"><span class="page-link sv-page-btn" style="color:#94a3b8;">…</span></li>
                        } else {
                            <li class="page-item @(pg == curP ? "active" : "")">
                                <a class="page-link sv-page-btn @(pg == curP ? "sv-page-active" : "")"
                                   asp-action="Index" asp-route-page="@pg" asp-route-tuKhoa="@ViewBag.TuKhoa">@pg</a>
                            </li>
                        }
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link sv-page-btn"
                           asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-tuKhoa="@ViewBag.TuKhoa">
                            Sau &rsaquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
<style>
    .sv-page-btn {
        min-width:34px; height:34px;
        display:inline-flex; align-items:center; justify-content:center;
        border-radius:8px !important; border:1px solid #e2e8f0 !important;
        color:#374151 !important; font-size:.82rem; font-weight:600;
        background:#fff; padding:0 10px; transition:all .15s ease;
    }
    .sv-page-btn:hover { background:#f1f5f9 !important; }
    .sv-page-active { background:#2563eb !important; color:#fff !important; border-color:#2563eb !important; }
    .page-item.disabled .sv-page-btn { color:#cbd5e1 !important; }
    .admin-content { font-family: 'Plus Jakarta Sans', "Segoe UI", sans-serif; }
</style>
}
