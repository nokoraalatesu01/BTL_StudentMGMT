@model BTL_StudentMGMT.Models.GiangVien
@{
    ViewData["Title"] = "Chi tiết giảng viên";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="mb-1">Chi tiết giảng viên</h2>
        <p class="text-muted mb-0">@Model.MaGiangVien</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="stat-card" style="max-width:760px">
    <dl class="row mb-0">
        <dt class="col-sm-4">Mã giảng viên</dt><dd class="col-sm-8">@Model.MaGiangVien</dd>
        <dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "Chưa cập nhật")</dd>
        <dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@(Model.SoDienThoai ?? "Chưa cập nhật")</dd>
        <dt class="col-sm-4">Tài khoản</dt><dd class="col-sm-8">@(Model.User?.UserName ?? "Chưa cấp tài khoản")</dd>
    </dl>
    <hr />
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa hồ sơ</a>
</div>
