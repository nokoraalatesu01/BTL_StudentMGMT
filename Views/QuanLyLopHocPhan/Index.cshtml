@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.LopHocPhanListItemViewModel>
@{
    ViewData["Title"] = "Quản lý lớp học phần";
    int startRecord = Model.TotalItems > 0 ? (Model.Page - 1) * Model.PageSize + 1 : 0;
    int endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);

    int tongSoLop = ViewBag.TongSoLop ?? Model.TotalItems;
    int soLopDangMo = ViewBag.SoLopDangMo ?? Model.Items.Count(i => i.TrangThai == "OPEN");
    int soLopKhoaDK = ViewBag.SoLopKhoaDK ?? Model.Items.Count(i => i.TrangThai == "CLOSED");
    int tongDangKy = ViewBag.TongDangKy ?? Model.Items.Sum(i => i.SiSoHienTai);
}

<!-- ===== HEADER TRANG ===== -->
<div class="page-header">
    <div>
        <p class="page-breadcrumb">
            <span style="color:#94a3b8;">Đào tạo tín chỉ</span>
            <span class="bc-sep">›</span>
            <span class="bc-cur">Lớp học phần</span>
        </p>
        <h3 class="page-title">Quản lý lớp học phần tín chỉ</h3>
        <p class="page-subtitle">Quản lý các lớp học phần theo học kỳ, phân công giảng viên, xếp lịch học và điều phối sĩ số sinh viên.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn-action-primary">
            <i class="bi bi-plus-lg"></i> Thêm lớp học phần
        </a>
    </div>
</div>

<!-- ===== THÔNG BÁO HỆ THỐNG ===== -->
@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== THẺ THỐNG KÊ (STAT CARDS) ===== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">TỔNG LỚP HỌC PHẦN</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@tongSoLop</div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">Toàn hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue"><i class="bi bi-journal-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">ĐANG MỞ ĐĂNG KÝ</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@soLopDangMo</div>
                    <div style="font-size:.78rem; color:#16a34a; margin-top:2px; font-weight:600;">Cho phép SV ghi danh</div>
                </div>
                <div class="stat-icon-wrap green"><i class="bi bi-door-open"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">ĐÃ KHÓA ĐĂNG KÝ</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@soLopKhoaDK</div>
                    <div style="font-size:.78rem; color:#d97706; margin-top:2px; font-weight:600;">Ngừng nhận đăng ký</div>
                </div>
                <div class="stat-icon-wrap amber"><i class="bi bi-lock"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">LƯỢT SINH VIÊN ĐK</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@tongDangKy</div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">Ghi danh thành công</div>
                </div>
                <div class="stat-icon-wrap purple"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== BỘ TÌM KIẾM & BỘ LỌC ===== -->
<div class="content-card p-3 mb-3 filter-card-form">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="tuKhoa" class="form-control" placeholder="Nhập mã hoặc tên lớp học phần..." value="@ViewBag.TuKhoa" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="monHocId" class="form-select" asp-items="ViewBag.DanhSachMonHoc">
                <option value="">-- Tất cả môn học --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="giangVienId" class="form-select" asp-items="ViewBag.DanhSachGiangVien">
                <option value="">-- Tất cả giảng viên --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="trangThai" class="form-select">
                <option value="">-- Trạng thái --</option>
                <option value="OPEN" selected="@(ViewBag.TrangThai == "OPEN")">Đang mở (OPEN)</option>
                <option value="CLOSED" selected="@(ViewBag.TrangThai == "CLOSED")">Đã khóa (CLOSED)</option>
                <option value="FINISHED" selected="@(ViewBag.TrangThai == "FINISHED")">Hoàn thành (FINISHED)</option>
            </select>
        </div>
        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn-action-primary px-3 w-100 justify-content-center" title="Lọc dữ liệu">
                <i class="bi bi-funnel"></i>
            </button>
            <a asp-action="Index" class="btn-action-secondary px-2 justify-content-center" title="Xóa lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- ===== BẢNG DANH SÁCH LỚP HỌC PHẦN ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width:130px;">MÃ LHP</th>
                    <th>LỚP HỌC PHẦN & MÔN HỌC</th>
                    <th style="width:140px;">HỌC KỲ / NHÓM</th>
                    <th style="width:180px;">GIẢNG VIÊN</th>
                    <th style="width:180px;">THỜI KHÓA BIỂU & PHÒNG</th>
                    <th class="text-center" style="width:110px;">SĨ SỐ</th>
                    <th class="text-center" style="width:120px;">TRẠNG THÁI</th>
                    <th class="text-end" style="width:140px; padding-right:1.25rem;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-inbox fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            <span style="font-size:.9rem;">Không tìm thấy lớp học phần phù hợp.</span>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <!-- MÃ LHP -->
                        <td>
                            <span style="display:inline-block; padding:4px 10px; background:#eff6ff; color:#2563eb; font-weight:700; font-size:.8rem; border-radius:6px; letter-spacing:.03em; font-family:monospace;">
                                @item.MaLopHocPhan
                            </span>
                        </td>

                        <!-- TÊN LHP & MÔN -->
                        <td>
                            <div style="font-weight:700; color:#1e293b; font-size:.875rem; line-height:1.35;">@item.TenLopHocPhan</div>
                            <div style="font-size:.78rem; color:#64748b; margin-top:2px;">
                                @item.TenMon
                                <span class="badge" style="background:#f1f5f9; color:#475569; font-weight:600; font-size:.72rem; margin-left:4px;">@item.SoTinChi TC</span>
                            </div>
                        </td>

                        <!-- HỌC KỲ / NHÓM -->
                        <td>
                            <div style="font-weight:600; color:#334155; font-size:.82rem;">@(item.TenHocKy ?? "HK1")</div>
                            <span class="badge" style="background:#f8fafc; color:#64748b; border:1px solid #e2e8f0; font-size:.72rem; margin-top:2px;">Nhóm @item.Nhom</span>
                        </td>

                        <!-- GIẢNG VIÊN -->
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="stat-icon-wrap ink" style="width:30px; height:30px; font-size:.85rem; border-radius:6px;">
                                    <i class="bi bi-person"></i>
                                </span>
                                <div>
                                    <div style="font-weight:600; color:#1e293b; font-size:.82rem;">@(item.TenGiangVien ?? "Chưa phân công")</div>
                                    <small style="color:#94a3b8; font-size:.72rem;">Giảng viên phụ trách</small>
                                </div>
                            </div>
                        </td>

                        <!-- LỊCH HỌC & PHÒNG -->
                        <td>
                            <div style="font-size:.82rem; color:#1e293b; font-weight:600;">
                                <i class="bi bi-calendar3 me-1 text-primary" style="font-size:.78rem;"></i>@item.LichHoc
                            </div>
                            <div style="font-size:.78rem; color:#64748b; margin-top:2px;">
                                <i class="bi bi-geo-alt me-1 text-danger" style="font-size:.78rem;"></i>@item.PhongHoc
                            </div>
                        </td>

                        <!-- SĨ SỐ -->
                        <td class="text-center">
                            @{
                                bool isFull = item.SiSoHienTai >= item.SiSoToiDa;
                                string sisoBg = isFull ? "#fee2e2" : "#f0fdf4";
                                string sisoColor = isFull ? "#dc2626" : "#16a34a";
                            }
                            <span style="display:inline-flex; align-items:center; justify-content:center; padding:3px 10px; border-radius:20px; font-weight:700; font-size:.78rem; background:@sisoBg; color:@sisoColor;">
                                @item.SiSoHienTai / @item.SiSoToiDa
                            </span>
                        </td>

                        <!-- TRẠNG THÁI -->
                        <td class="text-center">
                            @if (item.TrangThai == "OPEN")
                            {
                                <span class="badge-status-danghoc">
                                    <span class="sv-status-dot"></span> Đang mở
                                </span>
                            }
                            else if (item.TrangThai == "CLOSED")
                            {
                                <span class="badge-status-baoluu">
                                    <span class="sv-status-dot"></span> Khóa ĐK
                                </span>
                            }
                            else
                            {
                                <span class="badge-status-totnghiep">
                                    <span class="sv-status-dot"></span> Hoàn thành
                                </span>
                            }
                        </td>

                        <!-- THAO TÁC -->
                        <td class="text-end text-nowrap" style="padding-right:1.25rem;">
                            <a asp-action="SinhVien" asp-route-id="@item.Id"
                               class="btn btn-sm d-inline-flex align-items-center gap-1"
                               style="border:1px solid #dbeafe; background:#eff6ff; color:#2563eb; font-size:.76rem; font-weight:600; border-radius:6px; padding:4px 8px; margin-right:4px;"
                               title="Danh sách sinh viên ghi danh">
                                <i class="bi bi-people-fill"></i> SV (@item.SiSoHienTai)
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="icon-action-btn edit"
                               title="Chỉnh sửa lớp học phần">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp học phần @item.MaLopHocPhan?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-action-btn delete" title="Xóa lớp học phần">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ===== FOOTER PHÂN TRANG ===== -->
    <div class="table-footer">
        <div>
            Hiển thị <strong style="color:#1e293b;">@startRecord – @endRecord</strong>
            trên tổng số <strong style="color:#1e293b;">@Model.TotalItems</strong> lớp học phần
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang lớp học phần">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link sv-page-btn"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-monHocId="@ViewBag.MonHocId"
                           asp-route-giangVienId="@ViewBag.GiangVienId"
                           asp-route-trangThai="@ViewBag.TrangThai">
                            &lsaquo; Trước
                        </a>
                    </li>
                    @{
                        int totalP = Model.TotalPages;
                        int curP = Model.Page;
                        var pages = new List<int?>();
                        if (totalP <= 7) { for (int i = 1; i <= totalP; i++) pages.Add(i); }
                        else {
                            pages.Add(1);
                            if (curP > 3) pages.Add(null);
                            for (int i = Math.Max(2, curP - 1); i <= Math.Min(totalP - 1, curP + 1); i++) pages.Add(i);
                            if (curP < totalP - 2) pages.Add(null);
                            pages.Add(totalP);
                        }
                    }
                    @foreach (var pg in pages)
                    {
                        if (pg == null)
                        {
                            <li class="page-item disabled"><span class="page-link sv-page-btn" style="color:#94a3b8;">…</span></li>
                        }
                        else
                        {
                            <li class="page-item @(pg == curP ? "active" : "")">
                                <a class="page-link sv-page-btn @(pg == curP ? "sv-page-active" : "")"
                                   asp-action="Index"
                                   asp-route-page="@pg"
                                   asp-route-tuKhoa="@ViewBag.TuKhoa"
                                   asp-route-monHocId="@ViewBag.MonHocId"
                                   asp-route-giangVienId="@ViewBag.GiangVienId"
                                   asp-route-trangThai="@ViewBag.TrangThai">@pg</a>
                            </li>
                        }
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link sv-page-btn"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-monHocId="@ViewBag.MonHocId"
                           asp-route-giangVienId="@ViewBag.GiangVienId"
                           asp-route-trangThai="@ViewBag.TrangThai">
                            Sau &rsaquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
