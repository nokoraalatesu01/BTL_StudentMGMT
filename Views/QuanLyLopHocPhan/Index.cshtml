@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.LopHocPhanListItemViewModel>
@{
    ViewData["Title"] = "Quản lý lớp học phần";
    int startRecord = (Model.Page - 1) * Model.PageSize + 1;
    int endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<!-- ===== HEADER ===== -->
<div class="mb-4">
    <p class="mb-1" style="font-size:.8rem; color:#64748b;">
        <span style="color:#94a3b8;">ĐÀO TẠO TÍN CHỈ</span>
        <span style="color:#cbd5e1; margin:0 6px;">/</span>
        <span style="color:#2563eb; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.07em;">LỚP HỌC PHẦN</span>
    </p>
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
                Quản lý lớp học phần
            </h3>
            <p class="mb-0" style="font-size:.875rem; color:#64748b; max-width:620px;">
                Quản lý các lớp học phần được mở theo học kỳ, phân công giảng viên, quản lý sĩ số và danh sách sinh viên đăng ký học phần (không phân biệt lớp hành chính).
            </p>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <a asp-action="Create"
               class="btn d-inline-flex align-items-center gap-2 text-white"
               style="background:#2563eb; border:none; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 18px;">
                <i class="bi bi-plus-lg"></i> + Mở lớp học phần mới
            </a>
        </div>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== FILTER CARD ===== -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background:#fff;">
    <div class="card-body p-4">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold" style="font-size:.8rem; color:#475569;">TỪ KHÓA TÌM KIẾM</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="tuKhoa" class="form-control border-start-0" placeholder="Mã hoặc tên lớp học phần..." value="@ViewBag.TuKhoa" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="font-size:.8rem; color:#475569;">MÔN HỌC</label>
                <select name="monHocId" class="form-select" asp-items="ViewBag.DanhSachMonHoc">
                    <option value="">-- Tất cả môn học --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="font-size:.8rem; color:#475569;">GIẢNG VIÊN</label>
                <select name="giangVienId" class="form-select" asp-items="ViewBag.DanhSachGiangVien">
                    <option value="">-- Tất cả giảng viên --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold" style="height:38px; border-radius:8px;">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" style="height:38px; border-radius:8px;" title="Đặt lại">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ===== TABLE LIST ===== -->
<div class="card border-0 shadow-sm rounded-4" style="background:#fff; overflow:hidden;">
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size:.875rem;">
            <thead style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                <tr style="color:#475569; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">
                    <th class="ps-4 py-3">Mã LHP</th>
                    <th class="py-3">Tên lớp học phần & Môn</th>
                    <th class="py-3">Học kỳ / Nhóm</th>
                    <th class="py-3">Giảng viên</th>
                    <th class="py-3">Lịch học & Phòng</th>
                    <th class="py-3 text-center">Sĩ số</th>
                    <th class="py-3 text-center">Trạng thái</th>
                    <th class="pe-4 py-3 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Chưa có lớp học phần nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td class="ps-4 py-3">
                            <span class="badge px-2 py-1 fw-bold font-monospace" style="background:#eff6ff; color:#2563eb; font-size:.82rem; border-radius:6px;">
                                @item.MaLopHocPhan
                            </span>
                        </td>
                        <td class="py-3">
                            <div class="fw-bold" style="color:#0f172a;">@item.TenLopHocPhan</div>
                            <div style="font-size:.8rem; color:#64748b;">
                                @item.TenMon <span class="badge bg-light text-dark ms-1">@item.SoTinChi TC</span>
                            </div>
                        </td>
                        <td class="py-3">
                            <div style="color:#1e293b;">@(item.TenHocKy ?? "HK1")</div>
                            <span class="badge bg-secondary-subtle text-secondary" style="font-size:.75rem;">Nhóm @item.Nhom</span>
                        </td>
                        <td class="py-3">
                            <div class="fw-semibold" style="color:#334155;">
                                <i class="bi bi-person-badge me-1 text-primary"></i>@(item.TenGiangVien ?? "Chưa phân công")
                            </div>
                        </td>
                        <td class="py-3">
                            <div style="color:#0f172a;"><i class="bi bi-calendar3 me-1 text-info"></i>@item.LichHoc</div>
                            <div style="font-size:.8rem; color:#64748b;"><i class="bi bi-geo-alt me-1 text-danger"></i>@item.PhongHoc</div>
                        </td>
                        <td class="py-3 text-center">
                            <span class="badge @(item.SiSoHienTai >= item.SiSoToiDa ? "bg-danger" : "bg-success-subtle text-success") px-2 py-1 fw-semibold">
                                @item.SiSoHienTai / @item.SiSoToiDa
                            </span>
                        </td>
                        <td class="py-3 text-center">
                            @if (item.TrangThai == "OPEN")
                            {
                                <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Đang mở</span>
                            }
                            else if (item.TrangThai == "CLOSED")
                            {
                                <span class="badge bg-warning-subtle text-warning px-2 py-1"><i class="bi bi-lock me-1"></i>Khóa ĐK</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1"><i class="bi bi-flag me-1"></i>Hoàn thành</span>
                            }
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="SinhVien" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Danh sách sinh viên">
                                    <i class="bi bi-people-fill"></i> SV (@item.SiSoHienTai)
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp học phần này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalItems > Model.PageSize)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted" style="font-size:.85rem;">Hiển thị @startRecord - @endRecord trên tổng số @Model.TotalItems lớp học phần</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-tuKhoa="@ViewBag.TuKhoa">Trước</a>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">@Model.Page</span>
                    </li>
                    <li class="page-item @(Model.Page * Model.PageSize >= Model.TotalItems ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-tuKhoa="@ViewBag.TuKhoa">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
