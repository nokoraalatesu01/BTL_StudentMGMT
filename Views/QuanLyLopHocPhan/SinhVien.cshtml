@model BTL_StudentMGMT.Models.LopHocPhanSinhVienViewModel
@{
    var lhp = Model.LopHocPhan;
    ViewData["Title"] = $"Sinh viên LHP: {lhp.MaLopHocPhan}";
    var avatarColors = new[] { "gray", "pink", "cyan", "purple", "green" };
}

<!-- ===== HEADER TRANG ===== -->
<div class="page-header">
    <div>
        <p class="page-breadcrumb">
            <a asp-action="Index" style="color:#64748b; text-decoration:none;">Đào tạo tín chỉ</a>
            <span class="bc-sep">›</span>
            <a asp-action="Index" style="color:#64748b; text-decoration:none;">Lớp học phần</a>
            <span class="bc-sep">›</span>
            <span class="bc-cur">Danh sách sinh viên</span>
        </p>
        <h3 class="page-title">@lhp.TenLopHocPhan</h3>
        <p class="page-subtitle">Quản lý danh sách sinh viên các lớp hành chính cùng tham gia đăng ký lớp học phần tín chỉ này.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn-action-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<!-- ===== THÔNG BÁO HỆ THỐNG ===== -->
@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== THÔNG TIN CHI TIẾT LỚP HỌC PHẦN ===== -->
<div class="content-card p-3 p-md-4 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-3">
            <small class="text-uppercase fw-bold text-muted" style="font-size:.72rem; letter-spacing:.06em;">MÃ HỌC PHẦN</small>
            <div class="mt-1">
                <span style="display:inline-block; padding:4px 12px; background:#eff6ff; color:#2563eb; font-weight:800; font-size:.9rem; border-radius:6px; font-family:monospace;">
                    @lhp.MaLopHocPhan
                </span>
            </div>
        </div>
        <div class="col-md-3">
            <small class="text-uppercase fw-bold text-muted" style="font-size:.72rem; letter-spacing:.06em;">MÔN HỌC & TÍN CHỈ</small>
            <div class="fw-bold mt-1" style="color:#0f172a; font-size:.92rem;">
                @(lhp.MonHoc?.TenMon ?? "-")
                <span class="badge" style="background:#f1f5f9; color:#475569; font-weight:700;">@(lhp.MonHoc?.SoTinChi ?? 0) TC</span>
            </div>
        </div>
        <div class="col-md-3">
            <small class="text-uppercase fw-bold text-muted" style="font-size:.72rem; letter-spacing:.06em;">GIẢNG VIÊN & LỊCH HỌC</small>
            <div class="mt-1" style="font-size:.875rem; color:#1e293b; font-weight:600;">
                <i class="bi bi-person-badge text-primary me-1"></i>@(lhp.GiangVien?.HoTen ?? "Chưa phân công")
            </div>
            <div class="text-muted" style="font-size:.78rem;">
                <i class="bi bi-calendar3 me-1"></i>@lhp.Thu, Tiết @lhp.TietBatDau-@(lhp.TietBatDau + lhp.SoTiet - 1) (@lhp.PhongHoc)
            </div>
        </div>
        <div class="col-md-3 text-md-end">
            <small class="text-uppercase fw-bold text-muted" style="font-size:.72rem; letter-spacing:.06em;">SĨ SỐ HIỆN TẠI</small>
            <div class="mt-1">
                @{
                    bool isFull = Model.DanhSachSinhVien.Count >= lhp.SiSoToiDa;
                    string sisoBg = isFull ? "#fee2e2" : "#f0fdf4";
                    string sisoColor = isFull ? "#dc2626" : "#16a34a";
                }
                <span style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; border-radius:20px; font-weight:800; font-size:.9rem; background:@sisoBg; color:@sisoColor;">
                    <i class="bi bi-people"></i> @Model.DanhSachSinhVien.Count / @lhp.SiSoToiDa SV
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ===== GHI DANH SINH VIÊN VÀO LỚP HỌC PHẦN ===== -->
<div class="content-card p-3 p-md-4 mb-4 filter-card-form">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i>
            Ghi danh sinh viên vào lớp học phần
        </h6>
        @if (isFull)
        {
            <span class="badge" style="background:#fee2e2; color:#dc2626; font-size:.75rem;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Lớp đã đầy sĩ số tối đa
            </span>
        }
    </div>
    <form asp-action="ThemSinhVien" method="post" class="row g-2 align-items-center">
        @Html.AntiForgeryToken()
        <input type="hidden" name="lopHocPhanId" value="@lhp.Id" />
        <div class="col-md-9">
            <select name="sinhVienId" class="form-select" asp-items="ViewBag.EligibleStudents" required disabled="@isFull">
                <option value="">-- Chọn sinh viên để ghi danh (từ mọi lớp hành chính) --</option>
            </select>
        </div>
        <div class="col-md-3">
                <button type="submit" class="btn-action-primary w-100 justify-content-center" disabled="@isFull">
                <i class="bi bi-plus-lg"></i> Ghi danh sinh viên
            </button>
        </div>
    </form>
</div>

<!-- ===== BẢNG DANH SÁCH SINH VIÊN ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width:60px;">STT</th>
                    <th style="width:130px;">MÃ SINH VIÊN</th>
                    <th>HỌ VÀ TÊN</th>
                    <th style="width:160px;">LỚP HÀNH CHÍNH</th>
                    <th style="width:200px;">NGÀNH ĐÀO TẠO</th>
                    <th class="text-center" style="width:120px;">LẦN HỌC</th>
                    <th class="text-center" style="width:140px;">ĐIỂM HỌC PHẦN</th>
                    <th class="text-end" style="width:110px; padding-right:1.25rem;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DanhSachSinhVien.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-people fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            <span style="font-size:.9rem;">Chưa có sinh viên nào đăng ký lớp học phần này.</span>
                        </td>
                    </tr>
                }
                @{ int stt = 0; }
                @foreach (var sv in Model.DanhSachSinhVien)
                {
                    stt++;
                    var color = avatarColors[Math.Abs(sv.MaSinhVien.GetHashCode()) % avatarColors.Length];
                    var initial = string.IsNullOrWhiteSpace(sv.HoTen) ? "S" : sv.HoTen.Trim().Substring(sv.HoTen.Trim().LastIndexOf(' ') + 1)[0].ToString().ToUpperInvariant();

                    <tr>
                        <!-- STT -->
                        <td style="color:#94a3b8; font-size:.82rem; font-weight:600;">@stt</td>

                        <!-- MÃ SV -->
                        <td>
                            <span style="display:inline-block; padding:3px 8px; background:#eff6ff; color:#2563eb; font-weight:700; font-size:.78rem; border-radius:6px; font-family:monospace;">
                                @sv.MaSinhVien
                            </span>
                        </td>

                        <!-- HỌ TÊN + AVATAR -->
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-round @color" style="width:32px; height:32px; font-size:.8rem;">
                                    @initial
                                </div>
                                <div>
                                    <div style="font-weight:700; color:#1e293b; font-size:.875rem;">@sv.HoTen</div>
                                    <small style="color:#94a3b8; font-size:.72rem;">Sinh viên chính quy</small>
                                </div>
                            </div>
                        </td>

                        <!-- LỚP HÀNH CHÍNH -->
                        <td>
                            <span class="badge" style="background:#f1f5f9; color:#334155; font-weight:700; font-size:.76rem; border:1px solid #e2e8f0; border-radius:6px; padding:4px 8px;">
                                @(sv.TenLopHanhChinh ?? "Chưa xếp lớp")
                            </span>
                        </td>

                        <!-- NGÀNH ĐÀO TẠO -->
                        <td style="font-size:.82rem; color:#475569;">
                            @(sv.TenNganh ?? "-")
                        </td>

                        <!-- LẦN HỌC -->
                        <td class="text-center">
                            @if (sv.LanHoc > 1)
                            {
                                <span class="badge" style="background:#fef3c7; color:#d97706; font-weight:700; font-size:.75rem; border-radius:6px; padding:3px 8px;">
                                    <i class="bi bi-arrow-repeat me-1"></i>Học lại (Lần @sv.LanHoc)
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background:#f1f5f9; color:#64748b; font-weight:600; font-size:.75rem; border-radius:6px; padding:3px 8px;">
                                    Lần đầu
                                </span>
                            }
                        </td>

                        <!-- ĐIỂM HỌC PHẦN -->
                        <td class="text-center">
                            @if (sv.DiemTongKet.HasValue)
                            {
                                bool isDat = sv.DiemTongKet.Value >= 4.0;
                                string badgeBg = isDat ? "#dcfce7" : "#fee2e2";
                                string badgeColor = isDat ? "#16a34a" : "#dc2626";

                                <span style="display:inline-flex; align-items:center; gap:4px; padding:3px 8px; border-radius:6px; font-weight:800; font-size:.82rem; background:@badgeBg; color:@badgeColor;">
                                    @sv.DiemTongKet.Value.ToString("0.0")
                                    <small style="font-size:.72rem;">(@sv.DiemChu)</small>
                                </span>
                            }
                            else
                            {
                                <span style="color:#94a3b8; font-size:.78rem; font-style:italic;">Chưa có điểm</span>
                            }
                        </td>

                        <!-- THAO TÁC -->
                        <td class="text-end text-nowrap" style="padding-right:1.25rem;">
                            <form asp-action="XoaSinhVien" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy đăng ký sinh viên @sv.HoTen (@sv.MaSinhVien) khỏi lớp học phần này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lopHocPhanId" value="@lhp.Id" />
                                <input type="hidden" name="sinhVienId" value="@sv.SinhVienId" />
                                <button type="submit" class="icon-action-btn delete" title="Hủy đăng ký học phần">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ===== FOOTER BẢNG ===== -->
    <div class="table-footer">
        <div>
            Tổng số sinh viên ghi danh: <strong style="color:#1e293b;">@Model.DanhSachSinhVien.Count</strong> / <strong style="color:#1e293b;">@lhp.SiSoToiDa</strong>
        </div>
        <div class="text-muted" style="font-size:.78rem;">
            Chế độ đào tạo theo hệ thống tín chỉ UTC
        </div>
    </div>
</div>
