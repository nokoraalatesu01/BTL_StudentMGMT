@model BTL_StudentMGMT.Models.LopHocPhanSinhVienViewModel
@{
    ViewData["Title"] = $"Sinh viên LHP: {Model.LopHocPhan.MaLopHocPhan}";
    var lhp = Model.LopHocPhan;
}

<div class="mb-4">
    <p class="mb-1" style="font-size:.8rem; color:#64748b;">
        <a asp-action="Index" style="color:#64748b; text-decoration:none;">LỚP HỌC PHẦN</a>
        <span style="color:#cbd5e1; margin:0 6px;">/</span>
        <span style="color:#2563eb; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.07em;">DANH SÁCH SINH VIÊN</span>
    </p>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
                @lhp.TenLopHocPhan
            </h3>
            <p class="mb-0" style="font-size:.875rem; color:#64748b;">
                Mã LHP: <span class="fw-bold text-dark font-monospace">@lhp.MaLopHocPhan</span> | 
                Môn: <span class="fw-semibold text-primary">@lhp.MonHoc?.TenMon (@lhp.MonHoc?.SoTinChi TC)</span> | 
                GV: <span class="fw-semibold text-dark">@(lhp.GiangVien?.HoTen ?? "Chưa phân công")</span> | 
                Lịch: <span class="badge bg-light text-dark">@lhp.Thu, Tiết @lhp.TietBatDau - @(lhp.TietBatDau + lhp.SoTiet - 1) (@lhp.PhongHoc)</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:8px; font-weight:600;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- THÊM SINH VIÊN VÀO LỚP HỌC PHẦN -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background:#fff;">
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0" style="font-size:1rem; color:#1e293b;">
                <i class="bi bi-person-plus me-2 text-primary"></i>Ghi danh sinh viên vào lớp học phần
            </h5>
            <span class="badge @(Model.DanhSachSinhVien.Count >= lhp.SiSoToiDa ? "bg-danger" : "bg-primary") px-3 py-2 fs-6">
                Sĩ số: @Model.DanhSachSinhVien.Count / @lhp.SiSoToiDa sinh viên
            </span>
        </div>
        <form asp-action="ThemSinhVien" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="lopHocPhanId" value="@lhp.Id" />
            <div class="col-md-9">
                <label class="form-label fw-semibold" style="font-size:.8rem; color:#475569;">CHỌN SINH VIÊN ĐĂNG KÝ (TỪ MỌI LỚP HÀNH CHÍNH)</label>
                <select name="sinhVienId" class="form-select" asp-items="ViewBag.EligibleStudents" required>
                    <option value="">-- Chọn sinh viên để ghi danh --</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 fw-semibold" style="height:38px; border-radius:8px;" @(Model.DanhSachSinhVien.Count >= lhp.SiSoToiDa ? "disabled" : "")>
                    <i class="bi bi-plus-lg me-1"></i> Ghi danh sinh viên
                </button>
            </div>
        </form>
    </div>
</div>

<!-- DANH SÁCH SINH VIÊN ĐÃ ĐĂNG KÝ -->
<div class="card border-0 shadow-sm rounded-4" style="background:#fff; overflow:hidden;">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0" style="font-size:1.05rem; color:#0f172a;">
            Danh sách sinh viên trong lớp học phần (@Model.DanhSachSinhVien.Count)
        </h5>
        <div class="text-muted small">
            Sinh viên từ nhiều lớp hành chính khác nhau cùng tham gia lớp học phần này
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size:.875rem;">
            <thead style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                <tr style="color:#475569; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">
                    <th class="ps-4 py-3">STT</th>
                    <th class="py-3">Mã SV</th>
                    <th class="py-3">Họ và tên</th>
                    <th class="py-3">Lớp hành chính</th>
                    <th class="py-3">Ngành đào tạo</th>
                    <th class="py-3 text-center">Lần học</th>
                    <th class="py-3 text-center">Điểm tổng kết</th>
                    <th class="pe-4 py-3 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DanhSachSinhVien.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            Lớp học phần này hiện chưa có sinh viên nào đăng ký.
                        </td>
                    </tr>
                }
                @{ int stt = 0; }
                @foreach (var sv in Model.DanhSachSinhVien)
                {
                    stt++;
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td class="ps-4 py-3 text-muted">@stt</td>
                        <td class="py-3 fw-bold font-monospace text-primary">@sv.MaSinhVien</td>
                        <td class="py-3 fw-semibold" style="color:#0f172a;">@sv.HoTen</td>
                        <td class="py-3">
                            <span class="badge px-2 py-1 fw-bold" style="background:#eff6ff; color:#1d4ed8; border-radius:6px;">
                                @(sv.TenLopHanhChinh ?? "Chưa xếp lớp")
                            </span>
                        </td>
                        <td class="py-3" style="color:#475569;">@(sv.TenNganh ?? "-")</td>
                        <td class="py-3 text-center">
                            <span class="badge @(sv.LanHoc > 1 ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary")">
                                Lần @sv.LanHoc
                            </span>
                        </td>
                        <td class="py-3 text-center">
                            @if (sv.DiemTongKet.HasValue)
                            {
                                <span class="fw-bold @(sv.DiemTongKet.Value >= 5.0 ? "text-primary" : "text-danger") fs-6">
                                    @sv.DiemTongKet.Value
                                </span>
                                <span class="badge bg-light text-dark ms-1">@sv.DiemChu</span>
                            }
                            else
                            {
                                <span class="text-muted small">Chưa nhập điểm</span>
                            }
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <form asp-action="XoaSinhVien" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy đăng ký sinh viên này khỏi lớp học phần?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lopHocPhanId" value="@lhp.Id" />
                                <input type="hidden" name="sinhVienId" value="@sv.SinhVienId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy đăng ký">
                                    <i class="bi bi-trash"></i> Hủy ĐK
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
