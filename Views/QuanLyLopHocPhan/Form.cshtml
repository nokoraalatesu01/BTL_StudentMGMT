@model BTL_StudentMGMT.Models.LopHocPhanFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cập nhật lớp học phần" : "Thêm mới lớp học phần";
}

<!-- ===== BREADCRUMB ===== -->
<div class="page-breadcrumb-title mb-3">
    Đào tạo tín chỉ / Lớp học phần / <strong>@(isEdit ? "Cập nhật lớp học phần" : "Thêm mới lớp học phần")</strong>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <!-- Header Card -->
            <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center bg-white">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                    <i class="bi bi-journal-check text-primary"></i>
                    @(isEdit ? "Chỉnh Sửa Thông Tin Lớp Học Phần" : "Mở Lớp Học Phần Tín Chỉ Mới")
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <!-- Form Content -->
            <div class="p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <!-- MỤC 1: THÔNG TIN HỌC PHẦN & MÔN HỌC -->
                    <div class="col-12">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-journal-text"></i>
                            1. Thông Tin Lớp Học Phần & Môn Học
                        </h6>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MaLopHocPhan" class="form-label small fw-semibold text-secondary">Mã lớp học phần *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-upc-scan"></i>
                            </span>
                            <input asp-for="MaLopHocPhan" class="form-control border-start-0 ps-0 font-monospace fw-bold" placeholder="VD: INT301.01" />
                        </div>
                        <span asp-validation-for="MaLopHocPhan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="TenLopHocPhan" class="form-label small fw-semibold text-secondary">Tên lớp học phần *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-card-text"></i>
                            </span>
                            <input asp-for="TenLopHocPhan" class="form-control border-start-0 ps-0" placeholder="VD: Lập trình Web ASP.NET Core - Nhóm 01" />
                        </div>
                        <span asp-validation-for="TenLopHocPhan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MonHocId" class="form-label small fw-semibold text-secondary">Môn học đào tạo *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-book"></i>
                            </span>
                            <select asp-for="MonHocId" class="form-select border-start-0 ps-0" asp-items="ViewBag.DanhSachMonHoc">
                                <option value="">-- Chọn môn học --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MonHocId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HocKyId" class="form-label small fw-semibold text-secondary">Học kỳ đào tạo *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-clock-history"></i>
                            </span>
                            <select asp-for="HocKyId" class="form-select border-start-0 ps-0" asp-items="ViewBag.DanhSachHocKy">
                                <option value="">-- Chọn học kỳ --</option>
                            </select>
                        </div>
                        <span asp-validation-for="HocKyId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="GiangVienId" class="form-label small fw-semibold text-secondary">Giảng viên giảng dạy</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person-badge"></i>
                            </span>
                            <select asp-for="GiangVienId" class="form-select border-start-0 ps-0" asp-items="ViewBag.DanhSachGiangVien">
                                <option value="">-- Chưa phân công --</option>
                            </select>
                        </div>
                        <span asp-validation-for="GiangVienId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Nhom" class="form-label small fw-semibold text-secondary">Nhóm lớp *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-collection"></i>
                            </span>
                            <input asp-for="Nhom" class="form-control border-start-0 ps-0" placeholder="01" />
                        </div>
                        <span asp-validation-for="Nhom" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="SiSoToiDa" class="form-label small fw-semibold text-secondary">Sĩ số tối đa *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-people"></i>
                            </span>
                            <input asp-for="SiSoToiDa" type="number" class="form-control border-start-0 ps-0" min="1" max="250" />
                        </div>
                        <span asp-validation-for="SiSoToiDa" class="text-danger small"></span>
                    </div>

                    <!-- MỤC 2: THỜI KHÓA BIỂU & PHÒNG HỌC -->
                    <div class="col-12 mt-4">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-week"></i>
                            2. Thời Khóa Biểu & Địa Điểm
                        </h6>
                    </div>

                    @if (isEdit && (Model.Ca == null || !CaHocHelper.IsSingleCa(Model.TietBatDau, Model.SoTiet)))
                    {
                        <div class="col-12">
                            <div class="alert alert-warning py-2 px-3 mb-2 d-flex align-items-center gap-2 rounded-3 border-warning">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                                <div>
                                    <strong>Lịch cũ không theo ca:</strong> Lớp học này đang lưu <em>@Model.Thu, Tiết @Model.TietBatDau – @(Model.TietBatDau + Model.SoTiet - 1) (@Model.SoTiet tiết)</em>. Lịch cũ không theo ca, vui lòng chọn lại ca.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-md-3">
                        <label asp-for="Thu" class="form-label small fw-semibold text-secondary">Thứ trong tuần *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-calendar3"></i>
                            </span>
                            <select asp-for="Thu" class="form-select border-start-0 ps-0">
                                <option value="Thứ 2">Thứ 2</option>
                                <option value="Thứ 3">Thứ 3</option>
                                <option value="Thứ 4">Thứ 4</option>
                                <option value="Thứ 5">Thứ 5</option>
                                <option value="Thứ 6">Thứ 6</option>
                                <option value="Thứ 7">Thứ 7</option>
                            </select>
                        </div>
                        <span asp-validation-for="Thu" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Ca" class="form-label small fw-semibold text-secondary">Ca học (Quy chuẩn 1 ca/lớp) *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-clock"></i>
                            </span>
                            <select asp-for="Ca" class="form-select border-start-0 ps-0">
                                <option value="">-- Chọn ca học --</option>
                                @foreach (var ca in CaHocHelper.DanhSachCa)
                                {
                                    <option value="@ca.Ca">@ca.TenCa (@ca.KhungGio, @ca.MoTaTiet)</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Ca" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PhongHoc" class="form-label small fw-semibold text-secondary">Phòng học *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-geo-alt"></i>
                            </span>
                            <input asp-for="PhongHoc" class="form-control border-start-0 ps-0" placeholder="VD: P.302-A1" />
                        </div>
                        <span asp-validation-for="PhongHoc" class="text-danger small"></span>
                    </div>

                    <!-- MỤC 3: TRẠNG THÁI & GHI CHÚ -->
                    <div class="col-12 mt-4">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-toggles"></i>
                            3. Trạng Thái & Tùy Chọn
                        </h6>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TrangThai" class="form-label small fw-semibold text-secondary">Trạng thái đăng ký *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-toggle-on"></i>
                            </span>
                            <select asp-for="TrangThai" class="form-select border-start-0 ps-0">
                                <option value="OPEN">OPEN - Đang mở cho SV đăng ký</option>
                                <option value="CLOSED">CLOSED - Đã khóa đăng ký</option>
                                <option value="FINISHED">FINISHED - Đã kết thúc học phần</option>
                            </select>
                        </div>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="GhiChu" class="form-label small fw-semibold text-secondary">Ghi chú bổ sung</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-pencil-square"></i>
                            </span>
                            <input asp-for="GhiChu" class="form-control border-start-0 ps-0" placeholder="Ghi chú thêm về yêu cầu, điều kiện học phần..." />
                        </div>
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>

                    <!-- NÚT THAO TÁC -->
                    <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn-action-primary px-4">
                            <i class="bi bi-check-lg"></i> @(isEdit ? "Lưu thay đổi" : "Tạo mới lớp học phần")
                        </button>
                        <a asp-action="Index" class="btn-action-secondary px-3">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
