@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.LopListItemViewModel>
@{
    ViewData["Title"] = "Quản lý lớp";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý lớp</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm lớp</a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo tên lớp" />
    </div>
    <div class="col-md-5">
        <select name="nganhId" asp-items="ViewBag.DanhSachNganh" class="form-select">
            <option value="">-- Tất cả ngành --</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Tên lớp</th>
                <th>Mã ngành</th>
                <th>Ngành</th>
                <th class="text-center">Sinh viên</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lop in Model.Items)
            {
                <tr>
                    <td>@lop.TenLop</td>
                    <td>@lop.MaNganh</td>
                    <td>@lop.TenNganh</td>
                    <td class="text-center">@lop.SoSinhVien</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@lop.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@lop.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa lớp này?');">
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">Không có dữ liệu lớp.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang lớp">
        <ul class="pagination">
            @for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++)
            {
                <li class="page-item @(currentPage == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@currentPage"
                       asp-route-tuKhoa="@ViewBag.TuKhoa"
                       asp-route-nganhId="@ViewBag.NganhId">@currentPage</a>
                </li>
            }
        </ul>
    </nav>
}
