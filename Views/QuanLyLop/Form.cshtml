@model BTL_StudentMGMT.Models.LopFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa lớp" : "Thêm lớp";
}

<h2>@ViewData["Title"]</h2>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" class="row g-3" style="max-width:720px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <label asp-for="NganhId" class="form-label"></label>
        <select asp-for="NganhId" asp-items="ViewBag.DanhSachNganh" class="form-select">
            <option value="0">-- Chọn ngành --</option>
        </select>
        <span asp-validation-for="NganhId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="TenLop" class="form-label"></label>
        <input asp-for="TenLop" class="form-control" />
        <span asp-validation-for="TenLop" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
