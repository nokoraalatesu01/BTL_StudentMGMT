@model BTL_StudentMGMT.Models.LopFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa lớp" : "Thêm lớp";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">@(isEdit ? "Cập nhật thông tin lớp học và chương trình đào tạo." : "Thêm mới lớp học thuộc ngành và chương trình đào tạo.")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" class="row g-3" style="max-width:720px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <label asp-for="NganhId" class="form-label"></label>
        <select asp-for="NganhId" asp-items="ViewBag.DanhSachNganh" class="form-select">
            <option value="0">-- Chọn ngành --</option>
        </select>
        <span asp-validation-for="NganhId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="ChuongTrinhDaoTaoId" class="form-label"></label>
        <select asp-for="ChuongTrinhDaoTaoId" asp-items="ViewBag.DanhSachChuongTrinh" class="form-select">
            <option value="">-- Chương trình chuẩn (Mặc định theo ngành) --</option>
        </select>
        <span asp-validation-for="ChuongTrinhDaoTaoId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="TenLop" class="form-label"></label>
        <input asp-for="TenLop" class="form-control" />
        <span asp-validation-for="TenLop" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
