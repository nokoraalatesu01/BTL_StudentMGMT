@model BTL_StudentMGMT.Models.TaiKhoanListViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";

    var avatarColors = new[] { "gray", "pink", "cyan", "purple", "green" };

    // Phân trang client-side (tất cả đã load sẵn)
    int pageSize    = 10;
    int totalItems  = Model.TaiKhoans.Count;
    int totalPages  = Math.Max(1, (int)Math.Ceiling(totalItems / (double)pageSize));
    int startRecord = 1;
    int endRecord   = Math.Min(pageSize, totalItems);
}

<!-- ===== HEADER ===== -->
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
            Quản lý tài khoản
        </h3>
        <p class="mb-0" style="font-size:.875rem; color:#64748b;">
            Tạo tài khoản Identity, quản lý trạng thái và đặt lại mật khẩu.
        </p>
    </div>
    <a asp-action="Create"
       class="btn d-inline-flex align-items-center gap-2 text-white flex-shrink-0"
       style="background:#2563eb; border:none; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 20px;">
        <i class="bi bi-plus-lg" style="font-size:.9rem;"></i> Tạo tài khoản hồ sơ
    </a>
</div>

@if (TempData["Msg"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><div>@message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i><div>@error</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== BỘ LỌC ===== -->
<div class="content-card p-3 mb-3">
    <div class="row g-2 align-items-center filter-card-form">
        <!-- 1. Ô tìm kiếm -->
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 pe-2 text-muted" style="border-color:#cbd5e1; height:40px; border-radius:10px 0 0 10px;">
                    <i class="bi bi-search" style="font-size:.85rem; color:#64748b;"></i>
                </span>
                <input id="tkSearch" type="text"
                       class="form-control border-start-0 ps-1"
                       style="border-color:#cbd5e1; font-size:.875rem; height:40px; border-radius:0 10px 10px 0;"
                       placeholder="Tìm theo tên đăng nhập, họ tên hoặc vai trò..." />
            </div>
        </div>

        <!-- 2. Lọc vai trò -->
        <div class="col-12 col-sm-6 col-md-3">
            <select id="tkVaiTro" class="form-select"
                    style="font-size:.875rem; border-color:#cbd5e1; height:40px; width:100%; border-radius:10px;">
                <option value="">-- Tất cả vai trò --</option>
                <option value="Admin">Quản trị viên</option>
                <option value="GiangVien">Giảng viên</option>
                <option value="SinhVien">Sinh viên</option>
            </select>
        </div>

        <!-- 3. Lọc trạng thái -->
        <div class="col-12 col-sm-6 col-md-3">
            <select id="tkTrangThai" class="form-select"
                    style="font-size:.875rem; border-color:#cbd5e1; height:40px; width:100%; border-radius:10px;">
                <option value="">-- Trạng thái --</option>
                <option value="active">Đang hoạt động</option>
                <option value="locked">Đã khóa</option>
            </select>
        </div>

        <!-- 4. Nút Thao tác (Lọc + Đặt lại) -->
        <div class="col-12 col-md-2">
            <div class="d-flex gap-2 w-100">
                <button type="button" onclick="filterTable()"
                        class="btn-filter-submit flex-grow-1"
                        style="height:40px; border-radius:10px;">
                    <i class="bi bi-funnel-fill"></i> Lọc
                </button>
                <button type="button" onclick="resetFilter()"
                        class="btn-filter-reset"
                        title="Đặt lại bộ lọc"
                        style="height:40px; width:40px; min-width:40px; border-radius:10px;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===== BẢNG TÀI KHOẢN ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table" id="tkTable">
            <thead>
                <tr>
                    <th style="width:160px;">TÊN ĐĂNG NHẬP</th>
                    <th>HỌ TÊN</th>
                    <th style="width:120px;">VAI TRÒ</th>
                    <th>HỒ SƠ LIÊN KẾT</th>
                    <th style="width:140px;" class="text-center">TRẠNG THÁI</th>
                    <th style="width:260px;" class="text-end pe-3">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 0; }
                @foreach (var account in Model.TaiKhoans)
                {
                    var colorClass = avatarColors[idx % avatarColors.Length]; idx++;
                    string initial = string.IsNullOrWhiteSpace(account.HoTen) ? "?"
                        : account.HoTen.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[0].ToString().ToUpperInvariant();

                    // Kiểu badge theo vai trò
                    string roleBg    = account.VaiTro == "Admin"      ? "#f1f5f9"
                                     : account.VaiTro == "GiangVien"  ? "#e0f2fe"
                                     : "#ede9fe";
                    string roleColor = account.VaiTro == "Admin"      ? "#475569"
                                     : account.VaiTro == "GiangVien"  ? "#0284c7"
                                     : "#7c3aed";
                    string roleLabel = account.VaiTro == "Admin"      ? "Quản trị viên"
                                     : account.VaiTro == "GiangVien"  ? "Giảng viên"
                                     : account.VaiTro == "SinhVien"   ? "Sinh viên"
                                     : account.VaiTro;

                    string dataStatus = account.IsLocked ? "locked" : "active";
                    string dataRole   = account.VaiTro;

                    <tr data-status="@dataStatus" data-role="@dataRole"
                        data-name="@account.UserName.ToLower() @(account.HoTen?.ToLower() ?? "") @account.VaiTro.ToLower()">

                        <!-- TÊN ĐĂNG NHẬP -->
                        <td>
                            <div style="font-weight:700; color:#1e293b; font-size:.9rem; font-family:monospace;">
                                @account.UserName
                                @if (account.IsCurrentUser)
                                {
                                    <span style="font-size:.72rem; font-weight:600; color:#2563eb; font-family:sans-serif; margin-left:4px;">(bạn)</span>
                                }
                            </div>
                        </td>

                        <!-- HỌ TÊN -->
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-round @colorClass"
                                     style="width:34px; height:34px; font-size:.8rem; font-weight:700; flex-shrink:0;">
                                    @initial
                                </div>
                                <span style="font-weight:600; color:#1e293b; font-size:.875rem;">
                                    @(account.HoTen ?? "—")
                                </span>
                            </div>
                        </td>

                        <!-- VAI TRÒ -->
                        <td>
                            <span style="display:inline-block; padding:4px 12px; border-radius:6px;
                                         font-size:.78rem; font-weight:700;
                                         background:@roleBg; color:@roleColor;">
                                @roleLabel
                            </span>
                        </td>

                        <!-- HỒ SƠ LIÊN KẾT -->
                        <td style="font-size:.875rem; color:#475569;">
                            @if (!string.IsNullOrWhiteSpace(account.HoSoLienKet))
                            {
                                @account.HoSoLienKet
                            }
                            else
                            {
                                <span style="color:#94a3b8; font-style:italic;">Chưa liên kết hồ sơ</span>
                            }
                        </td>

                        <!-- TRẠNG THÁI -->
                        <td class="text-center">
                            @if (account.IsLocked)
                            {
                                <span class="badge-status-dinhchi">
                                    <span class="sv-status-dot"></span> Đã khóa
                                </span>
                            }
                            else
                            {
                                <span class="badge-status-danghoc">
                                    <span class="sv-status-dot"></span> Đang hoạt động
                                </span>
                            }
                        </td>

                        <!-- THAO TÁC -->
                        <td class="text-end text-nowrap pe-3">
                            <!-- Đổi mật khẩu tùy chỉnh -->
                            <a asp-action="ResetPassword" asp-route-id="@account.UserId"
                               class="btn btn-sm d-inline-flex align-items-center gap-1"
                               style="border:1px solid #fde68a; background:#fef3c7; color:#b45309; font-size:.76rem; font-weight:600; border-radius:6px; padding:3px 8px; margin-right:2px;"
                               title="Nhập mật khẩu mới cho tài khoản">
                                <i class="bi bi-key-fill"></i> Đổi MK
                            </a>

                            <!-- Reset nhanh về User@123 -->
                            <form asp-action="QuickReset" asp-route-id="@account.UserId" method="post" class="d-inline"
                                  onsubmit="return confirm('Đặt lại mật khẩu tài khoản @account.UserName về mặc định (User@123)?');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm d-inline-flex align-items-center gap-1"
                                        style="border:1px solid #e2e8f0; background:#f8fafc; color:#475569; font-size:.76rem; font-weight:600; border-radius:6px; padding:3px 8px; margin-right:2px;"
                                        title="Reset nhanh mật khẩu về User@123">
                                    <i class="bi bi-arrow-repeat"></i> Reset 123
                                </button>
                            </form>

                            @if (!account.IsCurrentUser)
                            {
                                @if (account.IsLocked)
                                {
                                    <!-- Mở khóa -->
                                    <form asp-action="Unlock" asp-route-id="@account.UserId" method="post" class="d-inline"
                                          onsubmit="return confirm('Mở khóa cho tài khoản @account.UserName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm d-inline-flex align-items-center gap-1"
                                                style="border:1px solid #bbf7d0; background:#f0fdf4; color:#16a34a; font-size:.76rem; font-weight:600; border-radius:6px; padding:3px 8px; margin-right:2px;"
                                                title="Mở khóa tài khoản">
                                            <i class="bi bi-unlock-fill"></i> Mở
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <!-- Khóa tài khoản -->
                                    <form asp-action="Lock" asp-route-id="@account.UserId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn KHÓA tài khoản @account.UserName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm d-inline-flex align-items-center gap-1"
                                                style="border:1px solid #fed7aa; background:#fff7ed; color:#ea580c; font-size:.76rem; font-weight:600; border-radius:6px; padding:3px 8px; margin-right:2px;"
                                                title="Khóa tài khoản này">
                                            <i class="bi bi-lock-fill"></i> Khóa
                                        </button>
                                    </form>
                                }

                                <!-- Xóa tài khoản -->
                                <form asp-action="Delete" asp-route-id="@account.UserId" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn XÓA tài khoản @account.UserName? Hồ sơ sinh viên/giảng viên (nếu có) sẽ được hủy liên kết.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="icon-action-btn delete"
                                            title="Xóa tài khoản">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }

                @if (Model.TaiKhoans.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-inbox fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            Chưa có tài khoản nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 px-3 py-2"
         style="border-top:1px solid #f1f5f9; background:#fafbfc;">
        <div id="tkPagInfo" style="font-size:.82rem; color:#64748b;">
            Hiển thị <strong style="color:#1e293b;">@startRecord – @endRecord</strong>
            trên tổng số <strong style="color:#1e293b;">@totalItems</strong> tài khoản
            &nbsp;|&nbsp; Số dòng mỗi trang:&nbsp;
            <select class="form-select d-inline-block"
                    style="width:auto; height:28px; padding:0 20px 0 8px; font-size:.78rem; border-color:#e2e8f0; display:inline-block !important;">
                <option>10</option><option>20</option><option>50</option>
            </select>
        </div>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item disabled">
                        <span class="page-link sv-page-btn" style="color:#cbd5e1;">&lsaquo; Trước</span>
                    </li>
                    @for (int p = 1; p <= Math.Min(totalPages, 5); p++)
                    {
                        <li class="page-item @(p == 1 ? "active" : "")">
                            <span class="page-link sv-page-btn @(p == 1 ? "sv-page-active" : "")">@p</span>
                        </li>
                    }
                    @if (totalPages > 5)
                    {
                        <li class="page-item disabled">
                            <span class="page-link sv-page-btn" style="color:#94a3b8;">…</span>
                        </li>
                        <li class="page-item">
                            <span class="page-link sv-page-btn">@totalPages</span>
                        </li>
                    }
                    <li class="page-item @(totalPages <= 1 ? "disabled" : "")">
                        <span class="page-link sv-page-btn">Sau &rsaquo;</span>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
<style>
    .sv-page-btn {
        min-width:34px; height:34px;
        display:inline-flex; align-items:center; justify-content:center;
        border-radius:8px !important; border:1px solid #e2e8f0 !important;
        color:#374151 !important; font-size:.82rem; font-weight:600;
        background:#fff; padding:0 10px; transition:all .15s ease;
    }
    .sv-page-btn:hover { background:#f1f5f9 !important; cursor:pointer; }
    .sv-page-active { background:#2563eb !important; color:#fff !important; border-color:#2563eb !important; }
    .page-item.disabled .sv-page-btn { color:#cbd5e1 !important; cursor:default; }
    .admin-content { font-family: 'Plus Jakarta Sans', "Segoe UI", sans-serif; }
</style>
<script>
function filterTable() {
    const search   = (document.getElementById('tkSearch')?.value || '').toLowerCase();
    const vaiTro   = document.getElementById('tkVaiTro')?.value || '';
    const trangThai = document.getElementById('tkTrangThai')?.value || '';
    const rows = document.querySelectorAll('#tkTable tbody tr[data-status]');
    let visible = 0;
    rows.forEach(row => {
        const name   = row.dataset.name  || '';
        const status = row.dataset.status || '';
        const role   = row.dataset.role  || '';
        const matchSearch = !search   || name.includes(search);
        const matchRole   = !vaiTro   || role === vaiTro;
        const matchStatus = !trangThai || status === trangThai;
        const show = matchSearch && matchRole && matchStatus;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    const info = document.getElementById('tkPagInfo');
    if (info) {
        info.innerHTML = `Hiển thị <strong style="color:#1e293b;">1 – ${Math.min(visible, 10)}</strong> trên tổng số <strong style="color:#1e293b;">${visible}</strong> tài khoản`;
    }
}

function resetFilter() {
    const s = document.getElementById('tkSearch');
    const v = document.getElementById('tkVaiTro');
    const t = document.getElementById('tkTrangThai');
    if (s) s.value = '';
    if (v) {
        v.value = '';
        v.dispatchEvent(new Event('change', { bubbles: true }));
    }
    if (t) {
        t.value = '';
        t.dispatchEvent(new Event('change', { bubbles: true }));
    }
    filterTable();
}

document.getElementById('tkSearch')?.addEventListener('input', filterTable);
document.getElementById('tkVaiTro')?.addEventListener('change', filterTable);
document.getElementById('tkTrangThai')?.addEventListener('change', filterTable);
</script>
}
