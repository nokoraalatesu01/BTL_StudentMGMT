@model BTL_StudentMGMT.Models.DatLaiMatKhauViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu tài khoản";
}

<div class="page-breadcrumb-title mb-3">
    Quản trị hệ thống / Quản lý tài khoản / <strong>Đặt lại mật khẩu</strong>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <!-- Header Card -->
            <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center bg-white">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                    <i class="bi bi-shield-lock-fill text-primary"></i>
                    Đặt Lại Mật Khẩu Người Dùng
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <!-- Form Content -->
            <div class="p-4">
                <div class="alert alert-info rounded-3 mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>
                        Đang đặt lại mật khẩu cho tài khoản: <strong class="text-primary font-monospace">@Model.UserName</strong>
                    </div>
                </div>

                <form asp-action="ResetPassword" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input asp-for="UserId" type="hidden" />
                    <input asp-for="UserName" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="col-12">
                        <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary">Mật khẩu mới *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="NewPassword" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)..." autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Mật khẩu cần tối thiểu 6 ký tự.</small>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn-action-primary px-4">
                            <i class="bi bi-check-lg"></i> Lưu mật khẩu mới
                        </button>
                        <a asp-action="Index" class="btn-action-secondary px-3">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
