@model BTL_StudentMGMT.Models.DatLaiMatKhauViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="mb-1">Đặt lại mật khẩu</h2>
        <p class="text-muted mb-0">Tài khoản: <strong>@Model.UserName</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="stat-card" style="max-width:600px">
    <form asp-action="ResetPassword" method="post">
        <input asp-for="UserId" type="hidden" />
        <input asp-for="UserName" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-4">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Lưu mật khẩu mới</button>
    </form>
</div>
