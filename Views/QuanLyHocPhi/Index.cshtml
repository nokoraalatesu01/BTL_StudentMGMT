@model IReadOnlyList<BTL_StudentMGMT.Models.HocPhiHoaDonListItemViewModel>
@{
    ViewData["Title"] = "Quản lý học phí";
}

<section class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Quản lý học phí</h1>
            <p class="text-muted mb-0">Hóa đơn, công nợ và yêu cầu chuyển khoản của sinh viên.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="BieuPhi" class="btn btn-outline-primary">Biểu phí</a>
            <a asp-action="TaoHoaDon" class="btn btn-primary">Tạo hóa đơn</a>
        </div>
    </div>

    @if (TempData["Msg"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label" for="tuKhoa">Tìm sinh viên / số hóa đơn</label>
            <input id="tuKhoa" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="hocKyId">Học kỳ</label>
            <select id="hocKyId" name="hocKyId" asp-items="ViewBag.HocKyId" class="form-select">
                <option value="">Tất cả học kỳ</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="trangThai">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var status in new[] { "ISSUED", "PARTIAL", "PAID", "CANCELLED" })
                {
                    <option value="@status" selected="@(ViewBag.TrangThai == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-outline-primary" type="submit">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </form>

    <div class="table-responsive bg-white rounded-3 shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Số hóa đơn</th>
                    <th>Sinh viên</th>
                    <th>Học kỳ</th>
                    <th>Tổng tiền</th>
                    <th>Đã thanh toán</th>
                    <th>Còn nợ</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.HoaDon.SoHoaDon</td>
                        <td>@item.HoaDon.SinhVien.MaSinhVien · @item.HoaDon.SinhVien.HoTen</td>
                        <td>@item.HoaDon.HocKy.TenHocKy</td>
                        <td>@item.TongTien.ToString("N0") ₫</td>
                        <td>@item.DaThanhToan.ToString("N0") ₫</td>
                        <td>@item.ConNo.ToString("N0") ₫</td>
                        <td><span class="badge text-bg-secondary">@item.HoaDon.TrangThai</span></td>
                        <td><a asp-action="ChiTiet" asp-route-id="@item.HoaDon.HoaDonId" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Chưa có hóa đơn phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
