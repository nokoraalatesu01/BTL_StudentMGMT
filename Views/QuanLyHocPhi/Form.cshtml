@model BTL_StudentMGMT.Models.HocPhiHoaDonFormViewModel
@{
    var isEdit = (bool?)ViewBag.IsEdit == true;
    ViewData["Title"] = isEdit ? "Sửa hóa đơn" : "Tạo hóa đơn";
}
<section class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">&larr; Danh sách hóa đơn</a>
        <h1 class="h3 mt-2">@ViewData["Title"]</h1>
        <p class="text-muted">Học phí được tính bằng số tín chỉ nhân đơn giá biểu phí áp dụng cho chương trình và năm học.</p>
    </div>
    <form asp-action="@(isEdit ? "SuaHoaDon" : "TaoHoaDon")" asp-route-id="@Model.HoaDonId" method="post" class="card shadow-sm">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (isEdit)
            {
                <input asp-for="HoaDonId" type="hidden" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SinhVienId" class="form-label"></label>
                    <select asp-for="SinhVienId" asp-items="ViewBag.SinhViens" class="form-select"><option value="">Chọn sinh viên</option></select>
                    <span asp-validation-for="SinhVienId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HocKyId" class="form-label"></label>
                    <select asp-for="HocKyId" asp-items="ViewBag.HocKies" class="form-select"><option value="">Chọn học kỳ</option></select>
                    <span asp-validation-for="HocKyId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BieuPhiId" class="form-label"></label>
                    <select asp-for="BieuPhiId" asp-items="ViewBag.BieuPhis" class="form-select"><option value="">Chọn biểu phí</option></select>
                    <span asp-validation-for="BieuPhiId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoTinChi" class="form-label"></label>
                    <input asp-for="SoTinChi" class="form-control" min="0.01" step="0.01" />
                    <span asp-validation-for="SoTinChi" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HanThanhToan" class="form-label"></label>
                    <input asp-for="HanThanhToan" type="date" class="form-control" />
                    <span asp-validation-for="HanThanhToan" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="GhiChu" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary">Lưu hóa đơn</button>
        </div>
    </form>
</section>
