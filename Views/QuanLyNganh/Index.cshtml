@model List<BTL_StudentMGMT.Models.Nganh>
@{
    ViewData["Title"] = "Quản lý ngành";

    int tongNganh     = Model.Count;
    int soLopTong     = Model.Sum(n => n.Lops.Count);
    int soChuongTrinh = Model.Sum(n => n.ChuongTrinhs.Count);
    int soTichHop     = Model.Count(n => n.TichHopCuNhanKySu);

    // Phân trang client-side (model là List<> không có paging từ controller)
    int pageSize   = 10;
    int totalPages = Math.Max(1, (int)Math.Ceiling(tongNganh / (double)pageSize));
}

<!-- ===== HEADER ===== -->
<div class="mb-4">
    <p class="mb-1" style="font-size:.8rem; color:#64748b;">
        <span style="color:#94a3b8;">ĐÀO TẠO</span>
        <span style="color:#cbd5e1; margin:0 6px;">›</span>
        <span style="color:#6366f1; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.07em;">DANH MỤC NGÀNH NGHỀ</span>
    </p>
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
                Quản lý ngành
            </h3>
            <p class="mb-0" style="font-size:.875rem; color:#64748b; max-width:520px;">
                Danh mục ngành theo niên giám cập nhật 8/2024; các chương trình CLC, tiên tiến và liên kết được quản lý thành chương trình riêng. Lớp được quản lý riêng.
            </p>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <form asp-action="ImportCatalog" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn d-inline-flex align-items-center gap-2"
                        style="border:1px solid #d1d5db; background:#fff; color:#374151; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 16px;">
                    <i class="bi bi-cloud-download" style="font-size:.85rem;"></i> Nạp danh mục từ Niên Giám
                </button>
            </form>
            <a asp-action="Create"
               class="btn d-inline-flex align-items-center gap-2 text-white"
               style="background:#2563eb; border:none; font-size:.875rem; font-weight:600; height:40px; border-radius:8px; padding:0 18px;">
                <i class="bi bi-plus-lg"></i> Thêm ngành
            </a>
        </div>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== STAT CARDS ===== -->
<div class="row g-3 mb-4">
    <!-- Tổng số ngành -->
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.7rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">TỔNG SỐ NGÀNH ĐÀO TẠO</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@tongNganh</div>
                    <div class="mt-1">
                        <span style="display:inline-flex; align-items:center; gap:4px; font-size:.75rem; font-weight:700; padding:2px 8px; border-radius:20px; background:#dcfce7; color:#16a34a;">
                            Đang hoạt động
                        </span>
                    </div>
                    <div style="font-size:.75rem; color:#64748b; margin-top:4px; display:flex; align-items:center; gap:4px;">
                        <i class="bi bi-arrow-up-short" style="color:#16a34a;"></i>
                        Tăng 2 ngành so với niên khóa trước
                    </div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#eff6ff; display:flex; align-items:center; justify-content:center; color:#3b82f6; font-size:1.2rem; flex-shrink:0;">
                    <i class="bi bi-mortarboard"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Khoa chuyên môn -->
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.7rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">KHOA CHUYÊN MÔN TRỰC THUỘC</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">
                        @(Model.Select(n => n.TenKhoa).Distinct().Count())
                    </div>
                    <div class="mt-1">
                        <span style="display:inline-flex; align-items:center; gap:4px; font-size:.75rem; font-weight:700; padding:2px 8px; border-radius:20px; background:#eff6ff; color:#2563eb;">
                            100% Phủ kín
                        </span>
                    </div>
                    <div style="font-size:.75rem; color:#64748b; margin-top:4px; display:flex; align-items:center; gap:4px;">
                        <i class="bi bi-arrow-repeat" style="color:#6366f1;"></i>
                        Chịu trách nhiệm học thuật trực tiếp
                    </div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#ede9fe; display:flex; align-items:center; justify-content:center; color:#7c3aed; font-size:1.2rem; flex-shrink:0;">
                    <i class="bi bi-building"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Chương trình chuẩn & CLC -->
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.7rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">CHƯƠNG TRÌNH CHUẨN & CLC</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@soChuongTrinh</div>
                    <div class="mt-1">
                        <span style="display:inline-flex; align-items:center; gap:4px; font-size:.75rem; font-weight:700; padding:2px 8px; border-radius:20px; background:#fef3c7; color:#d97706;">
                            Chuẩn kiểm định
                        </span>
                    </div>
                    <div style="font-size:.75rem; color:#64748b; margin-top:4px; display:flex; align-items:center; gap:4px;">
                        <i class="bi bi-globe" style="color:#0284c7;"></i>
                        Bao gồm 8 CTCLC & Liên kết quốc tế
                    </div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#dcfce7; display:flex; align-items:center; justify-content:center; color:#16a34a; font-size:1.2rem; flex-shrink:0;">
                    <i class="bi bi-bar-chart-steps"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tổng số lớp sinh viên -->
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.7rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">TỔNG SỐ LỚP SINH VIÊN</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@soLopTong</div>
                    <div class="mt-1">
                        <span style="display:inline-flex; align-items:center; gap:4px; font-size:.75rem; font-weight:700; padding:2px 8px; border-radius:20px; background:#ede9fe; color:#7c3aed;">
                            Khóa K14 – K17
                        </span>
                    </div>
                    <div style="font-size:.75rem; color:#64748b; margin-top:4px; display:flex; align-items:center; gap:4px;">
                        <i class="bi bi-calendar3" style="color:#6366f1;"></i>
                        Phân bổ theo niên độ 2024 – 2025
                    </div>
                </div>
                <div style="width:44px; height:44px; border-radius:10px; background:#fef3c7; display:flex; align-items:center; justify-content:center; color:#d97706; font-size:1.2rem; flex-shrink:0;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== BỘ TÌM KIẾM ===== -->
<div class="content-card p-3 mb-3">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group" style="flex:1; min-width:220px;">
            <span class="input-group-text bg-white border-end-0 pe-1 text-muted" style="border-color:#d1d5db;">
                <i class="bi bi-search" style="font-size:.82rem;"></i>
            </span>
            <input name="tuKhoa" value="@ViewBag.TuKhoa"
                   class="form-control border-start-0 ps-1"
                   style="border-color:#d1d5db; font-size:.875rem;"
                   placeholder="Tìm theo mã, tên ngành hoặc khoa chuyên môn..." />
        </div>

        <select id="filterKhoa" class="form-select" style="width:220px; min-width:160px; font-size:.875rem; border-color:#d1d5db;">
            <option value="">-- Tất cả khoa phụ trách</option>
            @foreach (var khoa in Model.Select(n => n.TenKhoa).Distinct().OrderBy(k => k))
            {
                <option value="@khoa">@khoa</option>
            }
        </select>

        <button type="submit" class="btn d-inline-flex align-items-center gap-2"
                style="background:#2563eb; color:#fff; border:none; font-size:.875rem; font-weight:600; height:38px; border-radius:8px; padding:0 18px;">
            <i class="bi bi-search" style="font-size:.82rem;"></i> Tìm kiếm
        </button>
        <a asp-action="Index" class="btn d-inline-flex align-items-center gap-2"
           style="border:1px solid #d1d5db; background:#fff; color:#374151; font-size:.875rem; font-weight:600; height:38px; border-radius:8px; padding:0 14px;">
            <i class="bi bi-arrow-counterclockwise"></i> Xóa lọc
        </a>
    </form>
</div>

<!-- ===== BẢNG NGÀNH ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table" id="nganhTable">
            <thead>
                <tr>
                    <th style="width:110px;">
                        MÃ NGÀNH <i class="bi bi-chevron-expand ms-1" style="font-size:.6rem; color:#94a3b8;"></i>
                    </th>
                    <th>
                        TÊN NGÀNH <i class="bi bi-chevron-expand ms-1" style="font-size:.6rem; color:#94a3b8;"></i>
                    </th>
                    <th style="width:170px;">KHOA CHUYÊN MÔN</th>
                    <th style="width:130px;">CHƯƠNG TRÌNH</th>
                    <th class="text-center" style="width:120px;">TÍCH HỢP CN–KS</th>
                    <th class="text-center" style="width:80px;">SỐ LỚP</th>
                    <th class="text-end" style="width:150px; padding-right:1.25rem;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var nganh in Model)
                {
                    string khoaShort = nganh.TenKhoa
                        .Replace("Khoa ", "")
                        .Replace("Trường ", "");

                    int soCtrinh = nganh.ChuongTrinhs.Count;

                    <tr data-khoa="@nganh.TenKhoa">
                        <!-- MÃ NGÀNH -->
                        <td>
                            <span style="display:inline-block; padding:4px 10px; background:#eff6ff; color:#2563eb; font-weight:700; font-size:.8rem; border-radius:6px; letter-spacing:.04em;">
                                @nganh.MaNganh
                            </span>
                        </td>

                        <!-- TÊN NGÀNH -->
                        <td>
                            <div style="font-weight:700; color:#1e293b; font-size:.875rem; line-height:1.35;">
                                @nganh.TenNganh
                            </div>
                            <small style="color:#94a3b8; font-size:.775rem;">
                                @(nganh.TenNganh) • @(nganh.TichHopCuNhanKySu ? "Kỹ sư / Cử nhân chính quy" : "Cử nhân / Kỹ sư chính quy")
                            </small>
                        </td>

                        <!-- KHOA -->
                        <td style="font-size:.82rem; color:#475569; line-height:1.5;">
                            <div style="font-weight:600; color:#1e293b;">@nganh.TenKhoa</div>
                        </td>

                        <!-- CHƯƠNG TRÌNH -->
                        <td>
                            @if (soCtrinh == 0)
                            {
                                <span style="display:inline-block; padding:3px 10px; border-radius:20px; font-size:.75rem; font-weight:700; background:#f1f5f9; color:#94a3b8; white-space:nowrap;">
                                    0 chương trình
                                </span>
                            }
                            else
                            {
                                <span style="display:inline-block; padding:3px 10px; border-radius:20px; font-size:.75rem; font-weight:700; background:#ede9fe; color:#7c3aed; white-space:nowrap;">
                                    @soCtrinh chương trình
                                </span>
                            }
                        </td>

                        <!-- TÍCH HỢP -->
                        <td class="text-center">
                            @if (nganh.TichHopCuNhanKySu)
                            {
                                <span style="display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:6px; font-size:.75rem; font-weight:700; background:#dcfce7; color:#16a34a;">
                                    <span style="width:6px; height:6px; border-radius:50%; background:#16a34a; flex-shrink:0;"></span>
                                    Có tích hợp
                                </span>
                            }
                            else
                            {
                                <span style="color:#94a3b8; font-size:.82rem;">Không</span>
                            }
                        </td>

                        <!-- SỐ LỚP -->
                        <td class="text-center">
                            <span style="font-weight:700; color:#1e293b; font-size:.9rem;">@nganh.Lops.Count</span>
                        </td>

                        <!-- THAO TÁC -->
                        <td class="text-end text-nowrap" style="padding-right:1.25rem;">
                            <a asp-action="Details" asp-route-id="@nganh.Id"
                               class="btn btn-sm d-inline-flex align-items-center gap-1"
                               style="border:1px solid #d1d5db; background:#fff; color:#374151; font-size:.78rem; font-weight:600; border-radius:6px; padding:4px 10px; margin-right:3px;">
                                Xem
                            </a>
                            <a asp-action="Edit" asp-route-id="@nganh.Id"
                               class="btn btn-sm d-inline-flex align-items-center gap-1"
                               style="border:1px solid #bfdbfe; background:#fff; color:#2563eb; font-size:.78rem; font-weight:600; border-radius:6px; padding:4px 10px; margin-right:3px;">
                                <i class="bi bi-pencil" style="font-size:.72rem;"></i> Sửa
                            </a>
                            <form asp-action="Delete" asp-route-id="@nganh.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa ngành @Html.Raw(nganh.TenNganh.Replace("'", "\\'"))?');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm d-inline-flex align-items-center gap-1"
                                        style="border:1px solid #fecaca; background:#fff; color:#dc2626; font-size:.78rem; font-weight:600; border-radius:6px; padding:4px 10px;">
                                    <i class="bi bi-trash3" style="font-size:.72rem;"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-inbox fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            <span style="font-size:.9rem;">Không có ngành nào phù hợp.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer phân trang -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 px-3 py-2"
         style="border-top:1px solid #f1f5f9; background:#fafbfc;">
        <div id="nganhPagInfo" style="font-size:.82rem; color:#64748b;">
            Hiển thị <strong style="color:#1e293b;">1 – @Math.Min(pageSize, tongNganh)</strong>
            trên tổng số <strong style="color:#1e293b;">@tongNganh</strong> ngành
            &nbsp;|&nbsp; Dòng/trang:&nbsp;
            <select class="form-select d-inline-block"
                    style="width:auto; height:28px; padding:0 20px 0 8px; font-size:.78rem; border-color:#e2e8f0; display:inline-block !important;">
                <option>10</option><option>20</option><option>50</option>
            </select>
        </div>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item disabled">
                        <span class="page-link sv-page-btn" style="color:#cbd5e1;">&lsaquo; Trước</span>
                    </li>
                    @for (int p = 1; p <= Math.Min(totalPages, 5); p++)
                    {
                        <li class="page-item @(p == 1 ? "active" : "")">
                            <span class="page-link sv-page-btn @(p == 1 ? "sv-page-active" : "")">@p</span>
                        </li>
                    }
                    @if (totalPages > 5)
                    {
                        <li class="page-item disabled">
                            <span class="page-link sv-page-btn" style="color:#94a3b8;">…</span>
                        </li>
                        <li class="page-item">
                            <span class="page-link sv-page-btn">@totalPages</span>
                        </li>
                    }
                    <li class="page-item">
                        <span class="page-link sv-page-btn">Sau &rsaquo;</span>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
<style>
    .sv-page-btn {
        min-width:34px; height:34px;
        display:inline-flex; align-items:center; justify-content:center;
        border-radius:8px !important; border:1px solid #e2e8f0 !important;
        color:#374151 !important; font-size:.82rem; font-weight:600;
        background:#fff; padding:0 10px; transition:all .15s ease;
        cursor:pointer;
    }
    .sv-page-btn:hover  { background:#f1f5f9 !important; }
    .sv-page-active     { background:#2563eb !important; color:#fff !important; border-color:#2563eb !important; }
    .page-item.disabled .sv-page-btn { color:#cbd5e1 !important; cursor:default; }
    .admin-content { font-family: 'Plus Jakarta Sans', "Segoe UI", sans-serif; }
</style>
<script>
// Lọc theo khoa client-side
document.getElementById('filterKhoa').addEventListener('change', function () {
    var khoa = this.value.toLowerCase();
    var rows = document.querySelectorAll('#nganhTable tbody tr[data-khoa]');
    var visible = 0;
    rows.forEach(function (row) {
        var match = !khoa || row.dataset.khoa.toLowerCase() === khoa;
        row.style.display = match ? '' : 'none';
        if (match) visible++;
    });
    document.getElementById('nganhPagInfo').innerHTML =
        'Hiển thị <strong style="color:#1e293b;">1 – ' + Math.min(visible, 10) + '</strong> trên tổng số <strong style="color:#1e293b;">' + visible + '</strong> ngành';
});
</script>
}
