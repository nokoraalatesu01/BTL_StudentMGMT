@model List<BTL_StudentMGMT.Models.Nganh>
@{
    ViewData["Title"] = "Quản lý ngành";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">Quản lý ngành</h2>
    <div class="d-flex flex-wrap gap-2">
        <form asp-action="ImportCatalog" method="post">
            <button type="submit" class="btn btn-outline-primary">Nạp danh mục từ Niên Giám</button>
        </form>
        <a asp-action="Create" class="btn btn-primary">+ Thêm ngành</a>
    </div>
</div>

<p class="text-muted">Danh mục ngành theo niên giám cập nhật 8/2024; các chương trình CLC, tiên tiến và liên kết được quản lý thành chương trình riêng. Lớp được quản lý riêng.</p>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (((IEnumerable<BTL_StudentMGMT.Models.ChuongTrinhDaoTao>)ViewBag.ChuongTrinhChuaGanNganh).Any())
{
    <div class="card mb-4">
        <div class="card-header fw-semibold">Chương trình chưa xác định ngành cấp IV</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Mã chương trình / mã nội bộ</th>
                        <th>Tên chương trình</th>
                        <th>Loại</th>
                        <th>Đơn vị quản lý</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var program in (IEnumerable<BTL_StudentMGMT.Models.ChuongTrinhDaoTao>)ViewBag.ChuongTrinhChuaGanNganh)
                    {
                        <tr>
                            <td>@program.MaChuongTrinh</td>
                            <td>@program.TenChuongTrinh</td>
                            <td>@program.LoaiChuongTrinh</td>
                            <td>@program.KhoaQuanLy</td>
                            <td>@program.GhiChu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo mã, ngành hoặc khoa" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Mã ngành</th>
                <th>Tên ngành</th>
                <th>Khoa chuyên môn</th>
                <th class="text-center">Chương trình</th>
                <th class="text-center">Tích hợp CN-KS</th>
                <th class="text-center">Số lớp</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nganh in Model)
            {
                <tr>
                    <td>@nganh.MaNganh</td>
                    <td>@nganh.TenNganh</td>
                    <td>@nganh.TenKhoa</td>
                    <td class="text-center">@nganh.ChuongTrinhs.Count</td>
                    <td class="text-center">@(nganh.TichHopCuNhanKySu ? "Có" : "Không")</td>
                    <td class="text-center">@nganh.Lops.Count</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@nganh.Id" class="btn btn-sm btn-info">Xem</a>
                        <a asp-action="Edit" asp-route-id="@nganh.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@nganh.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa ngành này?');">
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu ngành.</td></tr>
            }
        </tbody>
    </table>
</div>
