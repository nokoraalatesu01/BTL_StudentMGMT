@{
    var accountName = User.Identity?.Name ?? "";
    var accountInitial = string.IsNullOrWhiteSpace(accountName) ? "S" : accountName.Trim()[0].ToString().ToUpperInvariant();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c2340" />
    <title>@ViewData["Title"] - Cổng sinh viên UTC</title>
    <link rel="icon" type="image/png" href="~/images/logo-utc.png" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/sinhvien.css" asp-append-version="true" />
    <script>
        (function() {
            try {
                if (window.innerWidth > 768 && localStorage.getItem('portal_sidebar_collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch(e) {}
        })();
    </script>
</head>
<body class="student-body">
    <div class="student-app">
        <aside class="student-sidebar" id="portal-sidebar">
            <div class="student-sidebar-header">
                <a class="student-brand" asp-controller="SinhVien" asp-action="Index">
                    <div class="student-brand-logo-wrap">
                        <img src="~/images/logo-utc.png" alt="UTC Logo" class="student-brand-logo" />
                    </div>
                    <div class="student-brand-text-group">
                        <span class="student-brand-school">ĐH GIAO THÔNG VẬN TẢI</span>
                        <span class="student-brand-portal">CỔNG SINH VIÊN</span>
                    </div>
                </a>
                <button class="sidebar-toggle sidebar-toggle-inside" type="button" aria-label="Thu gọn thanh điều hướng" title="Thu gọn thanh điều hướng">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>

            <p class="student-nav-label">KHÔNG GIAN CỦA BẠN</p>
            <nav class="student-nav" aria-label="Điều hướng sinh viên">
                <a asp-controller="SinhVien" asp-action="Index"
                   class="@(currentAction == "Index" ? "active" : "")" aria-current="@(currentAction == "Index" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-grid-1x2"></i></span>
                    <span>Tổng quan</span>
                </a>
                <a asp-controller="SinhVien" asp-action="HoSo"
                   class="@(currentAction == "HoSo" ? "active" : "")" aria-current="@(currentAction == "HoSo" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                    <span>Hồ sơ của tôi</span>
                </a>
                <a asp-controller="SinhVien" asp-action="BangDiem"
                   class="@(currentAction == "BangDiem" ? "active" : "")" aria-current="@(currentAction == "BangDiem" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                    <span>Bảng điểm của tôi</span>
                </a>
            </nav>

            <div class="student-sidebar-bottom">
                <div class="sidebar-help">
                    <strong>Cần hỗ trợ?</strong>
                    <span>Liên hệ bộ phận quản lý sinh viên khi thông tin chưa chính xác.</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="student-logout" type="submit">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>
        <div class="sidebar-scrim" aria-hidden="true"></div>

        <div class="student-main">
            <header class="student-topbar">
                <div class="topbar-lead">
                    <button class="sidebar-toggle sidebar-toggle-topbar" type="button" aria-label="Mở thanh điều hướng" aria-controls="portal-sidebar" aria-expanded="false" title="Mở thanh điều hướng">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <div class="topbar-brand-badge">
                        <img src="~/images/logo-utc.png" alt="UTC Logo" class="topbar-logo-badge" />
                        <div class="topbar-brand-info">
                            <span class="topbar-title">Cổng thông tin sinh viên</span>
                            <span class="topbar-subtitle">ĐH Giao thông Vận tải &bull; UTC</span>
                        </div>
                    </div>
                </div>
                <div class="topbar-user">
                    <div class="topbar-avatar-wrap">
                        <span class="topbar-avatar" aria-hidden="true">@accountInitial</span>
                        <span class="user-status-dot" title="Trực tuyến"></span>
                    </div>
                    <div class="topbar-user-text">
                        <span class="topbar-name">@accountName</span>
                        <span class="topbar-role-badge">Sinh viên</span>
                    </div>
                </div>
            </header>
            <main class="student-content">
                @RenderBody()
            </main>
            <footer class="student-footer">
                <span>&copy; @DateTime.Now.Year Trường Đại học Giao thông Vận tải &bull; University of Transport and Communications (UTC)</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/gsap/gsap.min.js"></script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
</body>
</html>
