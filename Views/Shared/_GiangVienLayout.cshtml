@{
    var accountName = User.Identity?.Name ?? "";
    var accountInitial = string.IsNullOrWhiteSpace(accountName) ? "G" : accountName.Trim()[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f2c4c" />
    <title>@ViewData["Title"] - Cổng giảng viên</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/sinhvien.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/giangvien.css" asp-append-version="true" />
</head>
<body class="student-body">
    <div class="student-app">
        <aside class="student-sidebar" id="portal-sidebar">
            <a class="student-brand" asp-controller="GiangVien" asp-action="Index">
                <span class="student-brand-mark" aria-hidden="true">GV</span>
                <span>CỔNG GIẢNG VIÊN</span>
            </a>

            <p class="student-nav-label">KHÔNG GIAN CỦA BẠN</p>
            <nav class="student-nav" aria-label="Điều hướng giảng viên">
                <a asp-controller="GiangVien" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "GiangVien" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "GiangVien" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-grid-1x2"></i></span>
                    <span>Tổng quan</span>
                </a>
                <a asp-controller="GiangVien" asp-action="DanhSachSinhVien"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "DanhSachSinhVien" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "DanhSachSinhVien" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-people"></i></span>
                    <span>Danh sách sinh viên</span>
                </a>
                <a asp-controller="BangDiem" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "BangDiem" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "BangDiem" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                    <span>Bảng điểm sinh viên</span>
                </a>
                <a asp-controller="BangDiem" asp-action="NhapDiem"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "BangDiem" && ViewContext.RouteData.Values["action"]?.ToString() == "NhapDiem" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "BangDiem" && ViewContext.RouteData.Values["action"]?.ToString() == "NhapDiem" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
                    <span>Nhập điểm học phần</span>
                </a>
                <a asp-controller="GiangVien" asp-action="LichGiangDay"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "LichGiangDay" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "LichGiangDay" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
                    <span>Lịch giảng dạy</span>
                </a>
                <a asp-controller="GiangVien" asp-action="DiemDanh"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "DiemDanh" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "DiemDanh" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-clipboard-check"></i></span>
                    <span>Điểm danh lớp học</span>
                </a>
                <a asp-controller="GiangVien" asp-action="CapNhatThongTin"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "CapNhatThongTin" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "CapNhatThongTin" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                    <span>Hồ sơ của tôi</span>
                </a>
            </nav>

            <div class="student-sidebar-bottom">
                <div class="sidebar-help">
                    <strong>Cần hỗ trợ?</strong>
                    <span>Liên hệ bộ phận quản lý sinh viên khi thông tin chưa chính xác.</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="student-logout" type="submit">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>
        <div class="sidebar-scrim" aria-hidden="true"></div>

        <div class="student-main">
            <header class="student-topbar">
                <div class="topbar-lead">
                    <button class="sidebar-toggle" type="button" aria-label="Mở menu" aria-controls="portal-sidebar" aria-expanded="false">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <span class="topbar-title">Cổng thông tin giảng viên</span>
                </div>
                <div class="topbar-user">
                    <span class="topbar-avatar" aria-hidden="true">@accountInitial</span>
                    <span class="topbar-user-text">
                        <span class="topbar-name">@accountName</span>
                        <span class="topbar-role">Giảng viên</span>
                    </span>
                </div>
            </header>
            <main class="student-content">
                @RenderBody()
            </main>
            <footer class="student-footer">Cổng thông tin giảng viên &copy; @DateTime.Now.Year</footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/gsap/gsap.min.js"></script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
