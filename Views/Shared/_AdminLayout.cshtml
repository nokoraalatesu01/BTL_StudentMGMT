@{
    var accountName = User.Identity?.Name ?? "";
    var accountInitial = string.IsNullOrWhiteSpace(accountName) ? "A" : accountName.Trim()[0].ToString().ToUpperInvariant();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c2340" />
    <title>@ViewData["Title"] - Quản trị UTC</title>
    <link rel="icon" type="image/png" href="~/images/logo-utc.png" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/sinhvien.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script>
        (function() {
            try {
                if (window.innerWidth > 768 && localStorage.getItem('portal_sidebar_collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch(e) {}
        })();
    </script>
</head>
<body class="student-body admin-body">
    <div class="student-app admin-app">
        <aside class="student-sidebar admin-sidebar" id="portal-sidebar">
            <div class="student-sidebar-header">
                <a class="student-brand admin-brand" asp-controller="Admin" asp-action="Index">
                    <div class="student-brand-logo-wrap">
                        <img src="~/images/logo-utc.png" alt="UTC Logo" class="student-brand-logo" />
                    </div>
                    <div class="student-brand-text-group">
                        <span class="student-brand-school">ĐH GIAO THÔNG VẬN TẢI</span>
                        <span class="student-brand-portal">QUẢN TRỊ HỆ THỐNG</span>
                    </div>
                </a>
                <button class="sidebar-toggle sidebar-toggle-inside" type="button" aria-label="Thu gọn thanh điều hướng" title="Thu gọn thanh điều hướng">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>

            <p class="student-nav-label">KHÔNG GIAN QUẢN TRỊ</p>
            <nav class="student-nav admin-nav" aria-label="Điều hướng quản trị">
                <a asp-controller="Admin" asp-action="Index" class="@(currentController == "Admin" ? "active" : "")" aria-current="@(currentController == "Admin" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-grid-1x2"></i></span>
                    <span>Tổng quan</span>
                </a>
                <a asp-controller="QuanLySinhVien" asp-action="Index" class="@(currentController == "QuanLySinhVien" ? "active" : "")" aria-current="@(currentController == "QuanLySinhVien" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-people"></i></span>
                    <span>Quản lý sinh viên</span>
                </a>
                <a asp-controller="QuanLyGiangVien" asp-action="Index" class="@(currentController == "QuanLyGiangVien" ? "active" : "")" aria-current="@(currentController == "QuanLyGiangVien" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-person-workspace"></i></span>
                    <span>Quản lý giảng viên</span>
                </a>
                <a asp-controller="QuanLyMonHoc" asp-action="Index" class="@(currentController == "QuanLyMonHoc" ? "active" : "")" aria-current="@(currentController == "QuanLyMonHoc" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-journal-bookmark"></i></span>
                    <span>Quản lý môn học</span>
                </a>
                <a asp-controller="BangDiem" asp-action="Index" class="@(currentController == "BangDiem" ? "active" : "")" aria-current="@(currentController == "BangDiem" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-award"></i></span>
                    <span>Bảng điểm</span>
                </a>
                <a asp-controller="QuanLyTaiKhoan" asp-action="Index" class="@(currentController == "QuanLyTaiKhoan" ? "active" : "")" aria-current="@(currentController == "QuanLyTaiKhoan" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-shield-lock"></i></span>
                    <span>Quản lý tài khoản</span>
                </a>
                <a asp-controller="QuanLyNganh" asp-action="Index" class="@(currentController == "QuanLyNganh" ? "active" : "")" aria-current="@(currentController == "QuanLyNganh" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                    <span>Quản lý ngành</span>
                </a>
                <a asp-controller="QuanLyLop" asp-action="Index" class="@(currentController == "QuanLyLop" ? "active" : "")" aria-current="@(currentController == "QuanLyLop" ? "page" : null)">
                    <span class="nav-symbol" aria-hidden="true"><i class="bi bi-collection"></i></span>
                    <span>Quản lý lớp</span>
                </a>
            </nav>

            <div class="student-sidebar-bottom">
                <div class="sidebar-help">
                    <strong>Quản trị hệ thống</strong>
                    <span>Quản lý hồ sơ, chương trình đào tạo và tài khoản người dùng.</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="student-logout" type="submit">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>
        <div class="sidebar-scrim" aria-hidden="true"></div>

        <div class="student-main admin-main">
            <header class="student-topbar">
                <div class="topbar-lead">
                    <button class="sidebar-toggle sidebar-toggle-topbar" type="button" aria-label="Mở thanh điều hướng" aria-controls="portal-sidebar" aria-expanded="false" title="Mở thanh điều hướng">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                    <div class="topbar-brand-badge">
                        <img src="~/images/logo-utc.png" alt="UTC Logo" class="topbar-logo-badge" />
                        <div class="topbar-brand-info">
                            <span class="topbar-title">Cổng quản trị hệ thống</span>
                            <span class="topbar-subtitle">ĐH Giao thông Vận tải &bull; UTC</span>
                        </div>
                    </div>
                </div>
                <div class="topbar-user">
                    <div class="topbar-avatar-wrap">
                        <span class="topbar-avatar" aria-hidden="true">@accountInitial</span>
                        <span class="user-status-dot" title="Trực tuyến"></span>
                    </div>
                    <div class="topbar-user-text">
                        <span class="topbar-name">@accountName</span>
                        <span class="topbar-role-badge">Quản trị viên</span>
                    </div>
                </div>
            </header>
            <main class="student-content admin-content">
                @RenderBody()
            </main>
            <footer class="student-footer">
                <span>&copy; @DateTime.Now.Year Trường Đại học Giao thông Vận tải &bull; University of Transport and Communications (UTC)</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/gsap/gsap.min.js"></script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
