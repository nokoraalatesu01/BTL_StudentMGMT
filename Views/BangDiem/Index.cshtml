@model List<BTL_StudentMGMT.Models.Diem>
@{
    ViewData["Title"] = "Quản lý bảng điểm & học phần";
}

<!-- Header & Nút Nhập điểm môn học chuẩn Ảnh 3 -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            Đào tạo / <strong class="text-primary" style="color: #2563eb !important;">Quản lý bảng điểm & học phần</strong>
        </h3>
        <p class="text-muted mb-0 small">Theo dõi kết quả học tập chi tiết từng học phần của sinh viên</p>
    </div>
    <a asp-action="NhapDiem" class="btn btn-primary-blue rounded-3 px-3 py-2 d-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-plus-lg"></i> Nhập điểm môn học
    </a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Khung lọc điểm theo sinh viên -->
<div class="content-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-7 col-lg-6">
            <select name="sinhVienId" asp-items="ViewBag.DanhSachSinhVien" class="form-select">
                <option value="">-- Xem bảng điểm của tất cả sinh viên --</option>
            </select>
        </div>
        <div class="col-md-5 col-lg-4 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary-blue rounded-3 px-3 d-flex align-items-center gap-2"
                    style="background: #4f46e5 !important; border: none;">
                <i class="bi bi-funnel"></i> Lọc điểm
            </button>
            <a asp-action="Index" class="btn btn-outline-custom rounded-3 d-flex align-items-center gap-1">
                <i class="bi bi-arrow-clockwise"></i> Tất cả
            </a>
        </div>
    </form>
</div>

<!-- Bảng hiển thị kết quả học phần chuẩn ảnh 3 -->
<div class="custom-table-container mb-4">
    <div class="p-3 px-4 border-bottom bg-white d-flex align-items-center gap-2">
        <i class="bi bi-table text-primary" style="color: #2563eb !important;"></i>
        <span class="fw-bold text-dark fs-6">Danh Sách Kết Quả Học Phần (@Model.Count bản ghi)</span>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>MÃ SV</th>
                    <th>HỌ VÀ TÊN SV</th>
                    <th>MÃ MÔN</th>
                    <th>TÊN MÔN HỌC</th>
                    <th>SỐ TC</th>
                    <th>CC (10%)</th>
                    <th>GK (30%)</th>
                    <th>CK (60%)</th>
                    <th>TỔNG KẾT</th>
                    <th>ĐIỂM CHỮ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <!-- MÃ SV -->
                        <td>
                            <span class="fw-semibold text-secondary">@(d.SinhVien?.MaSinhVien ?? "—")</span>
                        </td>

                        <!-- HỌ VÀ TÊN SV -->
                        <td>
                            <div class="fw-bold text-dark">@(d.SinhVien?.HoTen ?? "—")</div>
                        </td>

                        <!-- MÃ MÔN -->
                        <td>
                            <span class="badge bg-light text-secondary border px-2 py-1 fw-bold">@(d.MonHoc?.MaMon ?? "INT000")</span>
                        </td>

                        <!-- TÊN MÔN HỌC -->
                        <td>
                            <span class="fw-semibold text-dark">@(d.MonHoc?.TenMon ?? "—")</span>
                        </td>

                        <!-- SỐ TC -->
                        <td>
                            <span>@(d.MonHoc?.SoTinChi ?? 3)</span>
                        </td>

                        <!-- ĐIỂM CHUYÊN CẦN -->
                        <td>
                            <span>@d.DiemChuyenCan</span>
                        </td>

                        <!-- ĐIỂM GIỮA KỲ -->
                        <td>
                            <span>@d.DiemGiuaKy</span>
                        </td>

                        <!-- ĐIỂM CUỐI KỲ -->
                        <td>
                            <span>@d.DiemCuoiKy</span>
                        </td>

                        <!-- TỔNG KẾT -->
                        <td>
                            <span class="fw-bold text-primary fs-6" style="color: #2563eb !important;">@d.DiemTongKet.ToString("0.00")</span>
                        </td>

                        <!-- ĐIỂM CHỮ -->
                        <td>
                            @if (d.DiemChu.StartsWith("A"))
                            {
                                <span class="badge bg-danger-subtle text-danger px-2 py-1 fw-bold">@d.DiemChu</span>
                            }
                            else if (d.DiemChu.StartsWith("B"))
                            {
                                <span class="badge bg-success-subtle text-success px-2 py-1 fw-bold">@d.DiemChu</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning px-2 py-1 fw-bold">@d.DiemChu</span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block text-secondary mb-2 opacity-50"></i>
                            Chưa có dữ liệu điểm học phần nào cho sinh viên này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
