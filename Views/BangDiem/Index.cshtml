@model List<BTL_StudentMGMT.Models.Diem>
@{
    ViewData["Title"] = "Quản lý bảng điểm & học phần";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_GiangVienLayout";
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">QUẢN LÝ ĐÀO TẠO</p>
        <h1>Bảng điểm sinh viên</h1>
        <p>Theo dõi và quản lý kết quả học tập chi tiết từng môn học của sinh viên.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="NhapDiem" class="gv-btn gv-btn-primary">
            <i class="bi bi-plus-lg"></i> Nhập điểm môn học
        </a>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="student-notice mb-3" style="background: #eaf6f0; border-color: #badccf; color: #205c47;">
        <strong>Thông báo:</strong> @TempData["Msg"]
    </div>
}

<!-- Bộ lọc điểm theo sinh viên -->
<div class="student-panel p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-7 col-lg-6">
            <select name="sinhVienId" asp-items="ViewBag.DanhSachSinhVien" class="gv-form-select">
                <option value="">-- Xem bảng điểm của tất cả sinh viên --</option>
            </select>
        </div>
        <div class="col-md-5 col-lg-4 d-flex align-items-center gap-2">
            <button type="submit" class="gv-btn gv-btn-primary">
                <i class="bi bi-funnel"></i> Lọc điểm
            </button>
            <a asp-action="Index" class="gv-btn gv-btn-secondary">
                <i class="bi bi-arrow-clockwise"></i> Tất cả
            </a>
        </div>
    </form>
</div>

<!-- Bảng hiển thị kết quả học phần -->
<div class="student-panel p-0 overflow-hidden mb-4">
    <div class="student-panel-heading p-3 border-bottom">
        <div>
            <p class="student-eyebrow mb-1">KẾT QUẢ HỌC TẬP</p>
            <h2 style="font-size: 1rem;">Danh sách điểm học phần (@Model.Count bản ghi)</h2>
        </div>
    </div>

    <div class="gv-table-responsive">
        <table class="gv-table">
            <thead>
                <tr>
                    <th>MÃ SV</th>
                    <th>HỌ VÀ TÊN SV</th>
                    <th>TÊN HỌC PHẦN</th>
                    <th style="text-align: center;">SỐ TC</th>
                    <th style="text-align: center;">CC (10%)</th>
                    <th style="text-align: center;">GK (30%)</th>
                    <th style="text-align: center;">CK (60%)</th>
                    <th style="text-align: center;">TỔNG KẾT</th>
                    <th style="text-align: center;">ĐIỂM CHỮ</th>
                    <th style="text-align: center;">ĐÁNH GIÁ</th>
                    <th style="text-align: center;">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var isPass = d.DiemTongKet >= 4.0;
                    var badgeClass = d.DiemChu switch
                    {
                        "A" => "gv-badge-green",
                        "B+" or "B" => "gv-badge-blue",
                        "C+" or "C" => "gv-badge-amber",
                        "D+" or "D" => "gv-badge-gray",
                        _ => "gv-badge-red"
                    };

                    <tr>
                        <td>
                            <strong style="color: #176da3;">@d.SinhVien?.MaSinhVien</strong>
                        </td>
                        <td>
                            <span style="font-weight: 600; color: #1b2e45;">@d.SinhVien?.HoTen</span>
                        </td>
                        <td>
                            <div style="font-weight: 600;">@d.MonHoc?.TenMon</div>
                            <small style="color: #7a899a;">Mã HP: @d.MonHoc?.MaMon</small>
                        </td>
                        <td style="text-align: center; font-weight: 600;">
                            @d.MonHoc?.SoTinChi
                        </td>
                        <td style="text-align: center;">
                            @d.DiemChuyenCan.ToString("0.0")
                        </td>
                        <td style="text-align: center;">
                            @d.DiemGiuaKy.ToString("0.0")
                        </td>
                        <td style="text-align: center;">
                            @d.DiemCuoiKy.ToString("0.0")
                        </td>
                        <td style="text-align: center;">
                            <strong style="color: #176da3; font-size: 1rem;">@d.DiemTongKet.ToString("0.0")</strong>
                        </td>
                        <td style="text-align: center;">
                            <span class="gv-badge @badgeClass" style="font-weight: 700; font-size: .8rem;">@d.DiemChu</span>
                        </td>
                        <td style="text-align: center;">
                            @if (isPass)
                            {
                                <span class="gv-badge gv-badge-green">
                                    <i class="bi bi-check-circle-fill"></i> Đạt
                                </span>
                            }
                            else
                            {
                                <span class="gv-badge gv-badge-red">
                                    <i class="bi bi-x-circle-fill"></i> Học lại
                                </span>
                            }
                        </td>
                        <td style="text-align: center;">
                            <a asp-action="NhapDiem"
                               asp-route-sinhVienId="@d.SinhVienId"
                               asp-route-monHocId="@d.MonHocId"
                               class="gv-btn gv-btn-secondary gv-btn-sm"
                               title="Sửa điểm học phần này">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="11" style="text-align: center; padding: 40px; color: #8290a0;">
                            Chưa có dữ liệu bảng điểm nào. Bấm <strong>"Nhập điểm môn học"</strong> để thêm kết quả học tập.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
