@model BTL_StudentMGMT.Models.DiemFormViewModel
@{
    ViewData["Title"] = "Nhập điểm học phần";
    Layout = (User.IsInRole("Admin") || User.IsInRole("PGV")) ? "_AdminLayout" : "_GiangVienLayout";
}

<!-- ===== HEADER TRANG ===== -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1" style="font-size: .8rem; color: #64748b;">
            <span style="color: #94a3b8;">Đào tạo</span>
            <span style="color: #cbd5e1;">›</span>
            <a asp-action="Index" style="color: #6366f1; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: .72rem; letter-spacing: .06em;">BẢNG ĐIỂM</a>
            <span style="color: #cbd5e1;">›</span>
            <span style="color: #475569; font-weight: 600;">Nhập điểm học phần</span>
        </div>
        <h3 class="fw-bold mb-1" style="color: #0f172a; font-size: 1.55rem; letter-spacing: -.02em;">
            Nhập bảng điểm học phần
        </h3>
        <p class="mb-0 text-muted" style="font-size: .875rem;">
            Ghi nhận điểm quá trình, điểm thi kết thúc môn; hỗ trợ thi lại lần 2 và quản lý lịch sử học phần.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
       style="height: 40px; border-radius: 8px; font-weight: 600; font-size: .875rem; padding: 0 16px;">
        <i class="bi bi-arrow-left"></i> Về bảng điểm
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">

        <!-- ===== LỊCH SỬ CÁC LẦN HỌC TRƯỚC (NẾU CÓ) ===== -->
        @if (Model.LichSuDiemMonHoc != null && Model.LichSuDiemMonHoc.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="border: 1px solid #fed7aa !important; background: #fffcf8;">
                <div class="px-4 py-3 d-flex align-items-center justify-content-between" style="border-bottom: 1px solid #ffedd5; background: #fff7ed;">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #ffedd5; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 1rem;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div>
                            <span class="fw-bold" style="color: #9a3412; font-size: .88rem; letter-spacing: .02em;">
                                LỊCH SỬ KẾT QUẢ CÁC LẦN HỌC TRƯỚC CỦA MÔN NÀY
                            </span>
                            <div style="font-size: .75rem; color: #b45309;">Hệ thống theo dõi tiến trình học lại &amp; cải thiện điểm của sinh viên</div>
                        </div>
                    </div>
                    <span class="badge" style="background: #fef3c7; color: #b45309; font-weight: 700; font-size: .78rem; padding: 6px 12px; border-radius: 20px; border: 1px solid #fde68a;">
                        Đã học @Model.LichSuDiemMonHoc.Count lần
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: .84rem;">
                        <thead style="background: #fffbf5; font-size: .75rem; text-transform: uppercase; color: #78350f; letter-spacing: .04em;">
                            <tr>
                                <th class="ps-4">Lớp học phần / Học kỳ</th>
                                <th class="text-center">Loại học</th>
                                <th class="text-center">Lần</th>
                                <th class="text-center">CC</th>
                                <th class="text-center">GK</th>
                                <th class="text-center">CK</th>
                                <th class="text-center">Tổng kết</th>
                                <th class="text-center">Chữ</th>
                                <th class="text-center">Kết quả</th>
                                <th class="text-center pe-4">Tích lũy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ls in Model.LichSuDiemMonHoc)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div style="font-weight: 700; color: #1e293b;">@(ls.LopHocPhan?.MaLopHocPhan ?? "Học phần chung")</div>
                                        <small style="color: #64748b; font-size: .75rem;">@(ls.HocKy?.TenHocKy ?? "—")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background: #f1f5f9; color: #334155; font-weight: 600; font-size: .75rem;">@ls.TenLoaiHoc</span>
                                    </td>
                                    <td class="text-center font-monospace fw-bold" style="color: #475569;">@ls.LanHoc</td>
                                    <td class="text-center">@ls.DiemChuyenCan.ToString("0.0")</td>
                                    <td class="text-center">@ls.DiemGiuaKy.ToString("0.0")</td>
                                    <td class="text-center">
                                        @if (ls.LanThi == 2 && ls.DiemCuoiKyLan2.HasValue)
                                        {
                                            <span style="color: #64748b;">L1: @ls.DiemCuoiKy.ToString("0.0")</span>
                                            <span class="badge bg-danger-subtle text-danger fw-bold ms-1">L2: @ls.DiemCuoiKyLan2.Value.ToString("0.0")</span>
                                        }
                                        else
                                        {
                                            <span>@ls.DiemCuoiKy.ToString("0.0")</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <strong style="color: #0f172a; font-size: .92rem;">@ls.DiemTongKet.ToString("0.0")</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(ls.IsDat ? "bg-primary" : "bg-danger")" style="font-weight: 700; font-size: .75rem; padding: 4px 8px;">
                                            @ls.DiemChu
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (ls.IsDat)
                                        {
                                            <span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: .75rem; padding: 4px 8px;">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đạt
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: #fee2e2; color: #b91c1c; font-weight: 700; font-size: .75rem; padding: 4px 8px;">
                                                <i class="bi bi-x-circle-fill me-1"></i>Chưa đạt
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        @if (ls.SuDungTinhTichLuy)
                                        {
                                            <span class="badge" style="background: #e0e7ff; color: #4338ca; font-weight: 700; font-size: .72rem; padding: 4px 8px;">Tính GPA</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: #f1f5f9; color: #94a3b8; font-weight: 600; font-size: .72rem; padding: 4px 8px;">Bỏ qua</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ===== BIỂU MẪU NHẬP ĐIỂM CHÍNH ===== -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <!-- Header Card -->
            <div class="px-4 py-3 d-flex align-items-center justify-content-between" style="border-bottom: 1px solid #f1f5f9; background: #fafbfc;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.05rem;">Ghi nhận kết quả học tập</h5>
                        <p class="mb-0 text-muted" style="font-size: .8rem;">Chọn lớp học phần, sinh viên và nhập điểm thành phần</p>
                    </div>
                </div>
                <span class="badge" style="background: #f1f5f9; color: #475569; font-weight: 600; font-size: .78rem; padding: 6px 12px; border-radius: 6px;">
                    <i class="bi bi-shield-check text-success me-1"></i>Kiểm soát đào tạo
                </span>
            </div>

            <!-- Form Content -->
            <div class="p-4">
                <form method="post" asp-action="NhapDiem" id="formNhapDiem">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                    <!-- MỤC 1: ĐỐI TƯỢNG HỌC PHẦN & SINH VIÊN -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid #f1f5f9;">
                            <span class="badge rounded-circle p-2" style="background: #eff6ff; color: #2563eb; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 800;">1</span>
                            <span class="fw-bold" style="color: #1e293b; font-size: .92rem;">Thông tin học phần &amp; Sinh viên</span>
                        </div>

                        <div class="row g-3">
                            <!-- Chọn Lớp học phần -->
                            <div class="col-md-6">
                                <label asp-for="LopHocPhanId" class="form-label small fw-semibold text-secondary">
                                    Lớp học phần <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-collection"></i>
                                    </span>
                                    <select asp-for="LopHocPhanId" asp-items="ViewBag.DanhSachLopHocPhan" class="form-select border-start-0 ps-0" id="selectLhp">
                                        <option value="">-- Chọn Lớp học phần --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="LopHocPhanId" class="text-danger small"></span>
                            </div>

                            <!-- Chọn môn học -->
                            <div class="col-md-6">
                                <label asp-for="MonHocId" class="form-label small fw-semibold text-secondary">
                                    Môn học <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-book"></i>
                                    </span>
                                    <select asp-for="MonHocId" asp-items="ViewBag.DanhSachMonHoc" class="form-select border-start-0 ps-0" id="selectMonHoc">
                                        <option value="">-- Chọn Môn học --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="MonHocId" class="text-danger small"></span>
                            </div>

                            <!-- Chọn sinh viên -->
                            <div class="col-md-6">
                                <label asp-for="SinhVienId" class="form-label small fw-semibold text-secondary">
                                    Sinh viên nhận điểm <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <select asp-for="SinhVienId" asp-items="ViewBag.DanhSachSinhVien" class="form-select border-start-0 ps-0" id="selectSinhVien">
                                        <option value="">-- Chọn Sinh Viên Cần Nhập Điểm --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="SinhVienId" class="text-danger small"></span>
                            </div>

                            <!-- Học kỳ -->
                            <div class="col-md-6">
                                <label asp-for="HocKyId" class="form-label small fw-semibold text-secondary">Học kỳ đào tạo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-calendar3"></i>
                                    </span>
                                    <select asp-for="HocKyId" asp-items="ViewBag.DanhSachHocKy" class="form-select border-start-0 ps-0">
                                        <option value="">-- Theo Lớp học phần --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MỤC 2: CẤU HÌNH LẦN HỌC & LẦN THI -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid #f1f5f9;">
                            <span class="badge rounded-circle p-2" style="background: #eff6ff; color: #2563eb; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 800;">2</span>
                            <span class="fw-bold" style="color: #1e293b; font-size: .92rem;">Hình thức học &amp; Lần thi</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="LoaiHoc" class="form-label small fw-semibold text-secondary">
                                    Loại hình thức học <span class="text-danger">*</span>
                                </label>
                                <select asp-for="LoaiHoc" class="form-select" id="selectLoaiHoc">
                                    <option value="HOC_LAN_DAU">Học lần đầu</option>
                                    <option value="HOC_LAI">Học lại (do trượt môn F)</option>
                                    <option value="HOC_CAI_THIEN">Học cải thiện (nâng điểm D, C...)</option>
                                </select>
                                <span asp-validation-for="LoaiHoc" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="LanHoc" class="form-label small fw-semibold text-secondary">Số lần học</label>
                                <input asp-for="LanHoc" type="number" min="1" max="10" class="form-control" />
                                <span asp-validation-for="LanHoc" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="LanThi" class="form-label small fw-semibold text-secondary">Lần thi kết thúc môn</label>
                                <select asp-for="LanThi" class="form-select" id="selectLanThi">
                                    <option value="1">Lần thi 1 (Chính thức)</option>
                                    <option value="2">Lần thi 2 (Thi lại kết thúc HP)</option>
                                </select>
                                <span asp-validation-for="LanThi" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- MỤC 3: ĐIỂM SỐ THÀNH PHẦN -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid #f1f5f9;">
                            <span class="badge rounded-circle p-2" style="background: #eff6ff; color: #2563eb; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 800;">3</span>
                            <span class="fw-bold" style="color: #1e293b; font-size: .92rem;">Điểm số thành phần (Thang điểm 10)</span>
                        </div>

                        <div class="row g-3">
                            <!-- Chuyên cần -->
                            <div class="col-md-4">
                                <div class="score-card-input p-3 rounded-3" style="background: #f8fafc; border: 1.5px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label asp-for="DiemChuyenCan" class="fw-bold mb-0 text-dark small">Chuyên cần</label>
                                        <span class="badge" style="background: #e0f2fe; color: #0369a1; font-weight: 700; font-size: .72rem;">10%</span>
                                    </div>
                                    <input asp-for="DiemChuyenCan" type="number" step="0.1" min="0" max="10"
                                           class="form-control score-box-field" id="inpCC" placeholder="0 - 10" />
                                    <span asp-validation-for="DiemChuyenCan" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Giữa kỳ -->
                            <div class="col-md-4">
                                <div class="score-card-input p-3 rounded-3" style="background: #f8fafc; border: 1.5px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label asp-for="DiemGiuaKy" class="fw-bold mb-0 text-dark small">Giữa kỳ</label>
                                        <span class="badge" style="background: #e0e7ff; color: #4338ca; font-weight: 700; font-size: .72rem;">30%</span>
                                    </div>
                                    <input asp-for="DiemGiuaKy" type="number" step="0.1" min="0" max="10"
                                           class="form-control score-box-field" id="inpGK" placeholder="0 - 10" />
                                    <span asp-validation-for="DiemGiuaKy" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Cuối kỳ Lần 1 -->
                            <div class="col-md-4">
                                <div class="score-card-input p-3 rounded-3" style="background: #f8fafc; border: 1.5px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label asp-for="DiemCuoiKy" class="fw-bold mb-0 text-dark small">Cuối kỳ Lần 1</label>
                                        <span class="badge" style="background: #f3e8ff; color: #7e22ce; font-weight: 700; font-size: .72rem;">60%</span>
                                    </div>
                                    <input asp-for="DiemCuoiKy" type="number" step="0.1" min="0" max="10"
                                           class="form-control score-box-field" id="inpCK" placeholder="0 - 10" />
                                    <span asp-validation-for="DiemCuoiKy" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Điểm thi lần 2 (nếu có) -->
                            <div class="col-12" id="divThiLan2" style="@(Model.LanThi == 2 || Model.DiemCuoiKyLan2.HasValue ? "" : "display:none;")">
                                <div class="p-3 rounded-3" style="background: #fff1f2; border: 1.5px dashed #f43f5e;">
                                    <div class="row align-items-center g-3">
                                        <div class="col-md-8">
                                            <label asp-for="DiemCuoiKyLan2" class="text-danger fw-bold d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-arrow-repeat fs-5"></i>
                                                Điểm thi kết thúc môn lần 2 (Thi lại kết thúc HP)
                                            </label>
                                            <div class="text-muted small">
                                                Khi nhập điểm thi lần 2, hệ thống sẽ tự động dùng điểm này thay thế cho điểm lần 1 để tính tổng kết.
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <input asp-for="DiemCuoiKyLan2" type="number" step="0.1" min="0" max="10"
                                                   class="form-control score-box-field border-danger" id="inpCK2" placeholder="Nhập điểm thi L2..." />
                                            <span asp-validation-for="DiemCuoiKyLan2" class="text-danger small mt-1 d-block"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Ghi chú nghiệp vụ -->
                            <div class="col-12">
                                <label asp-for="GhiChu" class="form-label small fw-semibold text-secondary">Ghi chú nghiệp vụ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-chat-left-text"></i>
                                    </span>
                                    <input asp-for="GhiChu" class="form-control border-start-0 ps-0" placeholder="Lý do học lại, cải thiện hoặc thi lại..." />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- WIDGET XEM TRƯỚC TỔNG KẾT -->
                    <div class="score-summary-widget p-4 rounded-4 mb-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <div class="score-summary-label">ƯỚC TÍNH ĐIỂM TỔNG KẾT HỌC PHẦN (THANG 10)</div>
                                <div class="d-flex align-items-center gap-3 mt-1">
                                    <span id="txtTongKet" class="score-big-number">—</span>
                                    <span id="txtDiemChu" class="badge-grade-preview">Chưa nhập</span>
                                </div>
                                <small class="text-muted" style="font-size: .78rem;">
                                    Công thức: CC (10%) + GK (30%) + CK (60%)
                                </small>
                            </div>
                            <div class="text-end">
                                <span id="txtDanhGia" class="badge-eval-preview">Chưa nhập đủ điểm</span>
                            </div>
                        </div>
                    </div>

                    <!-- NÚT THAO TÁC -->
                    <div class="d-flex align-items-center gap-3 pt-2">
                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2"
                                style="height: 44px; padding: 0 28px; font-weight: 700; font-size: .92rem; border-radius: 8px; box-shadow: 0 4px 12px rgba(37,99,235,.25);">
                            <i class="bi bi-check2-circle fs-5"></i> Lưu kết quả học phần
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
                           style="height: 44px; padding: 0 22px; font-weight: 600; font-size: .92rem; border-radius: 8px;">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-control, .form-select {
            height: 42px;
            font-size: .875rem;
            border-color: #cbd5e1;
            border-radius: 8px;
            color: #1e293b;
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }
        .input-group-text {
            border-color: #cbd5e1;
            border-radius: 8px 0 0 8px;
            font-size: .95rem;
        }
        .score-card-input {
            transition: all .15s ease;
        }
        .score-card-input:focus-within {
            border-color: #3b82f6 !important;
            background: #fff !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
        }
        .score-box-field {
            font-size: 1.3rem !important;
            font-weight: 800 !important;
            text-align: center !important;
            height: 48px !important;
            color: #0f172a !important;
            border-radius: 8px !important;
        }
        .score-box-field:focus {
            box-shadow: none !important;
            border-color: #2563eb !important;
        }
        .score-summary-widget {
            background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
            border: 1.5px solid #bfdbfe;
            box-shadow: inset 0 1px 2px rgba(255,255,255,0.8);
        }
        .score-summary-label {
            font-size: .75rem;
            font-weight: 800;
            letter-spacing: .06em;
            color: #1e40af;
            text-transform: uppercase;
        }
        .score-big-number {
            font-size: 2.4rem;
            font-weight: 800;
            color: #1e3a8a;
            line-height: 1;
            letter-spacing: -0.02em;
        }
        .badge-grade-preview {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            height: 42px;
            border-radius: 10px;
            font-weight: 800;
            font-size: 1.2rem;
            padding: 0 12px;
            transition: all .2s ease;
        }
        .badge-eval-preview {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 18px;
            border-radius: 30px;
            font-weight: 700;
            font-size: .88rem;
            transition: all .2s ease;
        }
        /* Phối màu chuẩn badge điểm */
        .grade-green {
            background: #dcfce7 !important;
            color: #15803d !important;
            border: 1px solid #bbf7d0 !important;
        }
        .grade-blue {
            background: #e0e7ff !important;
            color: #3730a3 !important;
            border: 1px solid #c7d2fe !important;
        }
        .grade-yellow {
            background: #fef9c3 !important;
            color: #854d0e !important;
            border: 1px solid #fef08a !important;
        }
        .grade-red {
            background: #fee2e2 !important;
            color: #b91c1c !important;
            border: 1px solid #fecaca !important;
        }
        .grade-gray {
            background: #f1f5f9 !important;
            color: #64748b !important;
            border: 1px solid #e2e8f0 !important;
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inpCC = document.getElementById("inpCC"), inpGK = document.getElementById("inpGK");
            const inpCK = document.getElementById("inpCK"), inpCK2 = document.getElementById("inpCK2");
            const selectLanThi = document.getElementById("selectLanThi"), divThiLan2 = document.getElementById("divThiLan2");
            const txtTongKet = document.getElementById("txtTongKet"), txtDiemChu = document.getElementById("txtDiemChu"), txtDanhGia = document.getElementById("txtDanhGia");
            const selectLhp = document.getElementById("selectLhp"), selectSv = document.getElementById("selectSinhVien");
            const selectMonHoc = document.getElementById("selectMonHoc"), selectHocKy = document.querySelector("select[name='HocKyId']");

            // Tự động lấy điểm khi chọn Lớp HP hoặc Sinh viên (AJAX không reload trang)
            async function syncThongTin() {
                const lhp = selectLhp?.value, sv = selectSv?.value;
                if (!lhp) return;
                try {
                    const res = await fetch(`@Url.Action("GetThongTinDiemJson", "BangDiem")?lopHocPhanId=${lhp}&sinhVienId=${sv || ''}`);
                    const data = await res.json();
                    if (!data.success) return;
                    if (data.monHocId && selectMonHoc) selectMonHoc.value = data.monHocId;
                    if (data.hocKyId && selectHocKy) selectHocKy.value = data.hocKyId;
                    if (data.hasData) {
                        inpCC.value = data.cc ?? '';
                        inpGK.value = data.gk ?? '';
                        inpCK.value = data.ck ?? '';
                        if (data.ck2 && inpCK2) inpCK2.value = data.ck2;
                        if (data.lanThi && selectLanThi) {
                            selectLanThi.value = data.lanThi;
                            if (divThiLan2) divThiLan2.style.display = data.lanThi == 2 ? "block" : "none";
                        }
                        calcScore();
                    }
                } catch (e) {}
            }

            if (selectLhp) selectLhp.addEventListener("change", syncThongTin);
            if (selectSv) selectSv.addEventListener("change", syncThongTin);

            if (selectLanThi) {
                selectLanThi.addEventListener("change", function () {
                    if (divThiLan2) divThiLan2.style.display = this.value === "2" ? "block" : "none";
                    calcScore();
                });
            }

            function calcScore() {
                const cc = parseFloat(inpCC?.value), gk = parseFloat(inpGK?.value);
                let ck = parseFloat(inpCK?.value);
                if (selectLanThi?.value === "2" && inpCK2 && !isNaN(parseFloat(inpCK2.value))) {
                    ck = parseFloat(inpCK2.value);
                }

                if (!isNaN(cc) && !isNaN(gk) && !isNaN(ck)) {
                    const tk = Math.round((cc * 0.1 + gk * 0.3 + ck * 0.6) * 100) / 100;
                    txtTongKet.innerText = tk.toFixed(1);

                    let chu = "F", cls = "grade-red", danhGia = "Không đạt (Học lại)";

                    if (tk >= 9.0)      { chu = "A+"; cls = "grade-green";  danhGia = "Đạt xuất sắc"; }
                    else if (tk >= 8.5) { chu = "A";  cls = "grade-green";  danhGia = "Đạt giỏi"; }
                    else if (tk >= 8.0) { chu = "B+"; cls = "grade-blue";   danhGia = "Đạt khá giỏi"; }
                    else if (tk >= 7.0) { chu = "B";  cls = "grade-blue";   danhGia = "Đạt khá"; }
                    else if (tk >= 6.5) { chu = "C+"; cls = "grade-yellow"; danhGia = "Đạt trung bình khá"; }
                    else if (tk >= 5.5) { chu = "C";  cls = "grade-yellow"; danhGia = "Đạt trung bình"; }
                    else if (tk >= 5.0) { chu = "D+"; cls = "grade-yellow"; danhGia = "Đạt trung bình yếu"; }
                    else if (tk >= 4.0) { chu = "D";  cls = "grade-yellow"; danhGia = "Đạt (Cần cải thiện)"; }

                    txtDiemChu.innerText = chu;
                    txtDiemChu.className = "badge-grade-preview " + cls;
                    txtDanhGia.innerText = danhGia;
                    txtDanhGia.className = "badge-eval-preview " + cls;
                } else {
                    txtTongKet.innerText = "—";
                    txtDiemChu.innerText = "Chưa nhập";
                    txtDiemChu.className = "badge-grade-preview grade-gray";
                    txtDanhGia.innerText = "Chưa nhập đủ điểm";
                    txtDanhGia.className = "badge-eval-preview grade-gray";
                }
            }

            [inpCC, inpGK, inpCK, inpCK2].forEach(inp => inp && inp.addEventListener("input", calcScore));
            calcScore();
        });
    </script>
}