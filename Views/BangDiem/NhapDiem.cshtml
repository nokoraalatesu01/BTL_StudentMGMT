@model BTL_StudentMGMT.Models.NhapDiemExcelViewModel
@{
    ViewData["Title"] = "Nhập bảng điểm học phần theo lớp";
    Layout = (User.IsInRole("Admin") || User.IsInRole("PGV")) ? "_AdminLayout" : "_GiangVienLayout";
    bool hasData = Model.LopId.HasValue && Model.MonHocId.HasValue && Model.DanhSachSinhVien.Count > 0;
}

<!-- ===== HEADER TRANG ===== -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1" style="font-size: .8rem; color: #64748b;">
            <span style="color: #94a3b8;">Đào tạo tín chỉ</span>
            <span style="color: #cbd5e1;">›</span>
            <a asp-action="Index" style="color: #2563eb; text-decoration: none; font-weight: 600;">Bảng điểm</a>
            <span style="color: #cbd5e1;">›</span>
            <span style="color: #475569; font-weight: 600;">Nhập điểm</span>
        </div>
        <h3 class="fw-bold mb-1" style="color: #1e293b; font-size: 1.35rem;">Nhập bảng điểm học phần theo lớp</h3>
        <p class="mb-0 text-muted" style="font-size: .875rem;">Chọn khoa, lớp và môn học để tải danh sách và nhập điểm.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
       style="height: 36px; border-radius: 6px; font-weight: 500; font-size: .875rem; padding: 0 14px;">
        <i class="bi bi-arrow-left"></i> Về danh sách điểm
    </a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert" style="border-left: 4px solid #16a34a;">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div class="fw-semibold">@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert" style="border-left: 4px solid #dc2626;">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div class="fw-semibold">@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ===== KHỐI 1: BỘ CHỌN PHÂN CẤP ===== -->
<div class="card border-0 bg-white mb-4" style="border: 1px solid #d1d5db !important; border-radius: 6px; overflow: visible !important;">
    <div class="p-3">
        <form method="get" asp-action="NhapDiem" id="filterForm">
            <div class="row g-3 align-items-end">
                <!-- Dropdown 1: Khoa -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Khoa / Đơn vị đào tạo <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-buildings"></i>
                        </span>
                        <select name="khoaId" id="selectKhoa" class="form-select border-start-0 ps-0" asp-items="ViewBag.DanhSachKhoa">
                            <option value="">-- Chọn Khoa đào tạo --</option>
                        </select>
                    </div>
                </div>

                <!-- Dropdown 2: Lớp -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Lớp sinh hoạt <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-people"></i>
                        </span>
                        <select name="lopId" id="selectLop" class="form-select border-start-0 ps-0" asp-items="ViewBag.DanhSachLop">
                            <option value="">-- Chọn Lớp --</option>
                        </select>
                    </div>
                </div>

                <!-- Dropdown 3: Môn học -->
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Môn học <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-book"></i>
                        </span>
                        <select name="monHocId" id="selectMonHoc" class="form-select border-start-0 ps-0" asp-items="ViewBag.DanhSachMonHoc">
                            <option value="">-- Chọn Môn học --</option>
                        </select>
                    </div>
                </div>

                <!-- Nút Tải bảng điểm -->
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2 fw-semibold"
                            id="btnTaiBangDiem" style="height: 38px; border-radius: 6px;">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Tải bảng điểm
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ===== KHỐI 2: BẢNG NHẬP ĐIỂM DẠNG EXCEL ===== -->
@if (hasData)
{
    <form method="post" asp-action="NhapDiem" id="excelScoreForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="KhoaId" />
        <input type="hidden" asp-for="LopId" />
        <input type="hidden" asp-for="MonHocId" />
        <input type="hidden" asp-for="LopHocPhanId" />
        <input type="hidden" asp-for="HocKyId" />
        <input type="hidden" asp-for="TenKhoa" />
        <input type="hidden" asp-for="TenLop" />
        <input type="hidden" asp-for="TenMonHoc" />

        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4" style="border: 1px solid #e2e8f0 !important;">
            <div class="px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-3" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                <div>
                    <h5 class="fw-bold mb-0" style="color: #1e293b; font-size: 1.05rem;">@Model.TenMonHoc</h5>
                    <div class="small text-muted mt-1">
                        Khoa: <strong>@Model.TenKhoa</strong>
                        <span class="mx-1">|</span> Lớp: <strong>@Model.TenLop</strong>
                        @if (!string.IsNullOrEmpty(Model.TenLopHocPhan))
                        {
                            <span class="mx-1">|</span> <span>Lớp học phần: <strong>@Model.TenLopHocPhan</strong></span>
                        }
                        @if (Model.SoTinChi.HasValue)
                        {
                            <span class="mx-1">|</span> <span>@Model.SoTinChi tín chỉ</span>
                        }
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">
                        Tổng: <strong>@Model.TongSoSinhVien</strong> SV
                        <span class="mx-1">|</span>
                        Đã đủ điểm: <strong id="badgeDaNhapDu">@Model.SoLuongDaNhapDu / @Model.TongSoSinhVien</strong>
                    </span>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4"
                            style="height: 40px; font-weight: 600; border-radius: 8px;">
                        <i class="bi bi-floppy"></i> Lưu bảng điểm
                    </button>
                </div>
            </div>

            <!-- Bảng dữ liệu Grid Excel -->
            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-bordered table-hover align-middle mb-0 excel-table" id="tableExcelScore" style="font-size: .85rem;">
                    <thead class="sticky-top" style="background: #ffffff; z-index: 5;">
                        <tr class="text-center align-middle" style="font-size: .78rem; font-weight: 600; letter-spacing: .02em; color: #374151; text-transform: uppercase;">
                            <th style="width: 48px; background: #ffffff;">STT</th>
                            <th style="width: 120px; background: #ffffff;">Mã Sinh Viên</th>
                            <th style="min-width: 200px; background: #ffffff;" class="text-start ps-3">Họ và Tên</th>
                            <th style="width: 110px; background: #ffffff;">Ngày sinh</th>
                            <th style="width: 115px; background: #ffffff; color: #374151; border-color: #d1d5db;">
                                Chuyên cần<br /><span style="font-size:.7rem; font-weight: normal;">10%</span>
                            </th>
                            <th style="width: 115px; background: #ffffff; color: #374151; border-color: #d1d5db;">
                                Giữa kỳ<br /><span style="font-size:.7rem; font-weight: normal;">30%</span>
                            </th>
                            <th style="width: 115px; background: #ffffff; color: #374151; border-color: #d1d5db;">
                                Cuối kỳ<br /><span style="font-size:.7rem; font-weight: normal;">60%</span>
                            </th>
                            <th style="width: 110px; background: #ffffff; color: #374151; border-color: #d1d5db;">
                                Tổng kết<br /><span style="font-size:.7rem; font-weight: normal;">(Hệ 10)</span>
                            </th>
                            <th style="width: 85px; background: #ffffff; color: #374151;">Điểm chữ</th>
                            <th style="width: 75px; background: #ffffff; color: #374151;">Hệ 4</th>
                            <th style="width: 100px; background: #ffffff; color: #374151;">Đánh giá</th>
                            <th style="min-width: 160px; background: #ffffff;" class="text-start">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.DanhSachSinhVien.Count; i++)
                        {
                            var sv = Model.DanhSachSinhVien[i];
                            string ccVal = sv.DiemChuyenCan.HasValue ? sv.DiemChuyenCan.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "";
                            string gkVal = sv.DiemGiuaKy.HasValue ? sv.DiemGiuaKy.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "";
                            string ckVal = sv.DiemCuoiKy.HasValue ? sv.DiemCuoiKy.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "";

                            <tr class="excel-row" data-row-index="@i">
                                <td class="text-center font-monospace fw-bold text-muted bg-light" style="font-size: .82rem;">
                                    @(i + 1)
                                    <input type="hidden" name="DanhSachSinhVien[@i].SinhVienId" value="@sv.SinhVienId" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].DiemId" value="@sv.DiemId" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].LopHocPhanId" value="@sv.LopHocPhanId" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].MaSinhVien" value="@sv.MaSinhVien" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].HoTen" value="@sv.HoTen" />
                                </td>
                                <td class="text-center font-monospace fw-bold" style="color: #2563eb;">
                                    @sv.MaSinhVien
                                </td>
                                <td class="ps-3 fw-bold text-dark text-nowrap">
                                    @sv.HoTen
                                </td>
                                <td class="text-center text-muted small">
                                    @sv.NgaySinhStr
                                </td>

                                <!-- Ô Chuyên cần (10%) -->
                                <td class="p-1 text-center cell-input-wrap">
                                    <input type="number" step="0.1" min="0" max="10"
                                           name="DanhSachSinhVien[@i].DiemChuyenCan"
                                           value="@ccVal"
                                           class="form-control excel-cell-input col-score col-cc"
                                           data-row="@i" data-col="cc" data-col-idx="0"
                                           placeholder="" />
                                </td>

                                <!-- Ô Giữa kỳ (30%) -->
                                <td class="p-1 text-center cell-input-wrap">
                                    <input type="number" step="0.1" min="0" max="10"
                                           name="DanhSachSinhVien[@i].DiemGiuaKy"
                                           value="@gkVal"
                                           class="form-control excel-cell-input col-score col-gk"
                                           data-row="@i" data-col="gk" data-col-idx="1"
                                           placeholder="" />
                                </td>

                                <!-- Ô Cuối kỳ (60%) -->
                                <td class="p-1 text-center cell-input-wrap">
                                    <input type="number" step="0.1" min="0" max="10"
                                           name="DanhSachSinhVien[@i].DiemCuoiKy"
                                           value="@ckVal"
                                           class="form-control excel-cell-input col-score col-ck"
                                           data-row="@i" data-col="ck" data-col-idx="2"
                                           placeholder="" />
                                </td>

                                <!-- Điểm Tổng kết (Chỉ hiển thị khi đủ 3 cột) -->
                                <td class="text-center cell-tongket">
                                    <span class="txt-tongket fw-bold fs-6" style="color: #1e3a8a;">
                                         @(sv.IsDuDiem && sv.DiemTongKet.HasValue ? sv.DiemTongKet.Value.ToString("0.0") : "")
                                    </span>
                                </td>

                                <!-- Điểm chữ -->
                                <td class="text-center cell-diemchu">
                                    <span class="txt-diemchu">
                                        @if (sv.IsDuDiem && !string.IsNullOrEmpty(sv.DiemChu))
                                        {
                                            <span style="font-weight: 700; font-size: .85rem; color: @(sv.IsDat ? "#1e293b" : "#dc2626");">
                                                @sv.DiemChu
                                            </span>
                                        }
                                        else
                                        {
                                        }
                                    </span>
                                </td>

                                <!-- Điểm hệ 4 -->
                                <td class="text-center font-monospace cell-he4">
                                    <span class="txt-he4 fw-semibold text-secondary">
                                        @(sv.IsDuDiem && sv.DiemHe4.HasValue ? sv.DiemHe4.Value.ToString("0.0") : "")
                                    </span>
                                </td>

                                <!-- Đánh giá kết quả -->
                                <td class="text-center cell-danhgia">
                                    <span class="txt-danhgia">
                                        @if (sv.IsDuDiem)
                                        {
                                        @if (sv.IsDat)
                                        {
                                            <span class="text-success fw-semibold" style="font-size: .8rem;">Đạt</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-semibold" style="font-size: .8rem;">Chưa đạt</span>
                                        }
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: .8rem;">Chưa đủ điểm</span>
                                        }
                                    </span>
                                </td>

                                <!-- Ghi chú -->
                                <td class="p-1">
                                    <input type="text"
                                           name="DanhSachSinhVien[@i].GhiChu"
                                           value="@sv.GhiChu"
                                           class="form-control form-control-sm excel-note-input"
                                           data-row="@i" data-col="note" data-col-idx="3"
                                           placeholder="Ghi chú thêm..."
                                           style="font-size: .82rem; height: 36px;" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer thanh công cụ dưới đáy -->
            <div class="px-4 py-3 d-flex flex-wrap align-items-center justify-content-end gap-3"
                 style="background: #f8fafc; border-top: 1px solid #e2e8f0;">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3" style="height: 40px; border-radius: 8px; font-weight: 600;">
                        Hủy
                    </a>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4"
                            id="btnSaveBottom" style="height: 40px; border-radius: 8px; font-weight: 600;">
                        <i class="bi bi-floppy"></i> Lưu bảng điểm
                    </button>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <!-- ===== TRẠNG THÁI CHỜ CHỌN ĐỦ ĐIỀU KIỆN ===== -->
    <div class="card border-0 bg-white text-center p-4 mb-4" style="border: 1px dashed #cbd5e1 !important; border-radius: 6px;">
        <div class="py-3">
            <h5 class="fw-semibold text-dark mb-2">Chưa tải danh sách bảng điểm</h5>
            <p class="text-muted mx-auto mb-0" style="max-width: 520px; font-size: .9rem;">
                Vui lòng chọn khoa, lớp sinh hoạt và môn học ở bộ lọc phía trên, sau đó bấm "Tải bảng điểm".
            </p>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-select, .form-control {
            height: 38px;
            font-size: .875rem;
            border-color: #cbd5e1;
            border-radius: 6px;
            color: #1e293b;
            transition: all .15s ease;
        }
        .form-select:focus, .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }
        .input-group-text {
            border-color: #cbd5e1;
            border-radius: 8px 0 0 8px;
            font-size: .95rem;
        }

        /* Excel Table Custom Styling */
        .excel-table {
            border-collapse: separate;
            border-spacing: 0;
        }
        .excel-table th {
            border-top: 1px solid #cbd5e1;
            border-bottom: 2px solid #cbd5e1;
            padding: 8px 6px;
            vertical-align: middle;
        }
        .excel-table td {
            padding: 3px 5px;
            vertical-align: middle;
            border-color: #e2e8f0;
        }
        .excel-row {
            transition: background-color .12s ease;
        }
        .excel-row:hover {
            background-color: #f8fafc !important;
        }
        .excel-row.excel-row-active {
            background-color: #eff6ff !important;
        }

        /* Ô nhập điểm Excel */
        .excel-cell-input {
            height: 32px !important;
            font-size: .95rem !important;
            font-weight: 600 !important;
            color: #1e293b !important;
            text-align: center !important;
            border: none !important;
            background: transparent !important;
            padding: 0 4px !important;
            transition: all .15s ease;
        }
        .excel-cell-input:focus {
            background: transparent !important;
            border: none !important;
            border-color: transparent !important;
            box-shadow: none !important;
            outline: none !important;
            z-index: 2;
        }
        .excel-cell-input.score-valid {
            border-color: #10b981 !important;
            color: #047857 !important;
        }
        .excel-cell-input.score-invalid {
            border-color: #ef4444 !important;
            background: #fef2f2 !important;
            color: #b91c1c !important;
        }

        .excel-note-input {
            border: none !important;
            background: transparent !important;
            border-radius: 0 !important;
            padding: 2px 4px !important;
            font-size: .82rem;
            height: 30px;
        }
        .excel-note-input:focus {
            background: transparent !important;
            border: none !important;
            border-color: transparent !important;
            box-shadow: none !important;
            outline: none !important;
        }

        /* Giữ dropdown combobox không bị cắt trên mobile */
        @@media (max-width: 768px) {
            .portal-select-dropdown {
                max-width: calc(100vw - 2rem) !important;
                width: 100% !important;
            }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ==========================================
            // 1. XỬ LÝ CASCADING DROPDOWNS (KHOA -> LỚP -> MÔN HỌC)
            // ==========================================
            const selectKhoa = document.getElementById('selectKhoa');
            const selectLop = document.getElementById('selectLop');
            const selectMonHoc = document.getElementById('selectMonHoc');

            if (selectKhoa && selectLop && selectMonHoc) {
                // Khi Khoa thay đổi: nạp danh sách Lớp và Môn học tương ứng
                selectKhoa.addEventListener('change', function () {
                    const khoaId = this.value;
                    if (!khoaId) {
                        selectLop.innerHTML = '<option value="">-- Chọn Lớp --</option>';
                        selectMonHoc.innerHTML = '<option value="">-- Chọn Môn học được phân công --</option>';
                        return;
                    }

                    // Tải Lớp theo Khoa
                    fetch(`/BangDiem/GetLopsByKhoa?khoaId=${khoaId}`)
                        .then(res => res.json())
                        .then(data => {
                            let options = '<option value="">-- Chọn Lớp --</option>';
                            data.forEach(item => {
                                options += `<option value="${item.id}">${item.tenLop}</option>`;
                            });
                            selectLop.innerHTML = options;
                        })
                        .catch(err => console.error("Lỗi nạp danh sách lớp:", err));

                    // Tải Môn học theo Khoa
                    fetch(`/BangDiem/GetMonHocsByKhoa?khoaId=${khoaId}`)
                        .then(res => res.json())
                        .then(data => {
                            let options = '<option value="">-- Chọn Môn học được phân công --</option>';
                            data.forEach(item => {
                                options += `<option value="${item.id}">${item.tenHienThi}</option>`;
                            });
                            selectMonHoc.innerHTML = options;
                        })
                        .catch(err => console.error("Lỗi nạp danh sách môn:", err));
                });
            }

            // ==========================================
            // 2. TÍNH TOÁN ĐIỂM TỔNG KẾT & XẾP LOẠI TỨC THỜI
            // "nhập điểm đến đâu ghi nhận tới đó, chỉ nhận tổng kết khi đã có đẩy đủ điểm"
            // ==========================================
            const scoreInputs = document.querySelectorAll('.excel-cell-input');

            function updateRowScore(tr) {
                const inpCC = tr.querySelector('.col-cc');
                const inpGK = tr.querySelector('.col-gk');
                const inpCK = tr.querySelector('.col-ck');
                const txtTK = tr.querySelector('.txt-tongket');
                const txtChu = tr.querySelector('.txt-diemchu');
                const txtHe4 = tr.querySelector('.txt-he4');
                const txtDanhGia = tr.querySelector('.txt-danhgia');

                const valCC = inpCC.value.trim();
                const valGK = inpGK.value.trim();
                const valCK = inpCK.value.trim();

                // Validate từng ô (0 - 10)
                [inpCC, inpGK, inpCK].forEach(inp => {
                    const v = inp.value.trim();
                    if (v !== '') {
                        const num = parseFloat(v);
                        if (isNaN(num) || num < 0 || num > 10) {
                            inp.classList.add('score-invalid');
                            inp.classList.remove('score-valid');
                        } else {
                            inp.classList.remove('score-invalid');
                            inp.classList.add('score-valid');
                        }
                    } else {
                        inp.classList.remove('score-invalid', 'score-valid');
                    }
                });

                // Kiểm tra xem đã đủ CẢ 3 ĐIỂM THÀNH PHẦN hay chưa
                const hasCC = valCC !== '' && !isNaN(parseFloat(valCC)) && parseFloat(valCC) >= 0 && parseFloat(valCC) <= 10;
                const hasGK = valGK !== '' && !isNaN(parseFloat(valGK)) && parseFloat(valGK) >= 0 && parseFloat(valGK) <= 10;
                const hasCK = valCK !== '' && !isNaN(parseFloat(valCK)) && parseFloat(valCK) >= 0 && parseFloat(valCK) <= 10;

                if (hasCC && hasGK && hasCK) {
                    const cc = parseFloat(valCC);
                    const gk = parseFloat(valGK);
                    const ck = parseFloat(valCK);

                    // Công thức chuẩn tín chỉ: CC*10% + GK*30% + CK*60%
                    const tk = Math.round((cc * 0.1 + gk * 0.3 + ck * 0.6) * 10) / 10;
                    txtTK.textContent = tk.toFixed(1);

                    // Xếp loại điểm chữ & điểm hệ 4
                    let diemChu = "F";
                    let he4 = 0.0;
                    let isDat = (tk >= 4.0);

                    if (tk >= 9.0) { diemChu = "A+"; he4 = 4.0; }
                    else if (tk >= 8.5) { diemChu = "A"; he4 = 4.0; }
                    else if (tk >= 8.0) { diemChu = "B+"; he4 = 3.5; }
                    else if (tk >= 7.0) { diemChu = "B"; he4 = 3.0; }
                    else if (tk >= 6.5) { diemChu = "C+"; he4 = 2.5; }
                    else if (tk >= 5.5) { diemChu = "C"; he4 = 2.0; }
                    else if (tk >= 5.0) { diemChu = "D+"; he4 = 1.5; }
                    else if (tk >= 4.0) { diemChu = "D"; he4 = 1.0; }
                    else { diemChu = "F"; he4 = 0.0; }

                    const badgeColor = isDat ? '#1e293b' : '#dc2626';
                    txtChu.innerHTML = `<span style="font-weight: 700; font-size: .85rem; color: ${badgeColor};">${diemChu}</span>`;
                    txtHe4.textContent = he4.toFixed(1);

                    if (isDat) {
                        txtDanhGia.innerHTML = `<span class="text-success fw-semibold" style="font-size: .8rem;">Đạt</span>`;
                    } else {
                        txtDanhGia.innerHTML = `<span class="text-danger fw-semibold" style="font-size: .8rem;">Chưa đạt</span>`;
                    }
                } else {
                    // CHƯA ĐỦ ĐIỂM: Không hiển thị tổng kết!
                    txtTK.textContent = "";
                    txtChu.innerHTML = ``;
                    txtHe4.textContent = "";
                    txtDanhGia.innerHTML = `<span class="text-muted" style="font-size: .8rem;">Chưa đủ điểm</span>`;
                }

                updateSummaryStats();
            }

            function updateSummaryStats() {
                const allRows = document.querySelectorAll('.excel-row');
                let countDuDiem = 0;
                allRows.forEach(row => {
                    const tk = row.querySelector('.txt-tongket');
                    if (tk && tk.textContent.trim() !== "") {
                        countDuDiem++;
                    }
                });
                const badgeDaNhapDu = document.getElementById('badgeDaNhapDu');
                if (badgeDaNhapDu) {
                    badgeDaNhapDu.textContent = `${countDuDiem} / ${allRows.length}`;
                }
            }

            // Gán sự kiện input cập nhật cho từng ô điểm
            scoreInputs.forEach(inp => {
                inp.addEventListener('input', function () {
                    const tr = this.closest('tr');
                    updateRowScore(tr);
                });
            });

            // ==========================================
            // 3. THAO TÁC BÀN PHÍM NHƯ EXCEL
            // "form điểm giống như excel có thể nhập như excel, sau mỗi lần enter thì nhảy xuống dòng nhập người tiếp theo"
            // ==========================================
            scoreInputs.forEach(inp => {
                // Khi focus vào ô: tự động chọn toàn bộ văn bản (để gõ số mới đè ngay mà không cần xóa)
                inp.addEventListener('focus', function () {
                    this.select();
                    const tr = this.closest('tr');
                    document.querySelectorAll('.excel-row').forEach(r => r.classList.remove('excel-row-active'));
                    if (tr) tr.classList.add('excel-row-active');
                });

                inp.addEventListener('blur', function () {
                    const tr = this.closest('tr');
                    if (tr) tr.classList.remove('excel-row-active');
                });

                // Điều hướng bàn phím Enter, Mũi tên lên, xuống, trái, phải
                inp.addEventListener('keydown', function (e) {
                    const rowIdx = parseInt(this.getAttribute('data-row'), 10);
                    const col = this.getAttribute('data-col');
                    const colIdx = parseInt(this.getAttribute('data-col-idx'), 10);
                    const totalRows = document.querySelectorAll('.excel-row').length;

                    // Phím ENTER hoặc MŨI TÊN XUỐNG: Nhảy xuống ô tương ứng của sinh viên tiếp theo
                    if (e.key === 'Enter' || e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (rowIdx + 1 < totalRows) {
                            const nextCell = document.querySelector(`.excel-cell-input[data-row="${rowIdx + 1}"][data-col="${col}"]`);
                            if (nextCell) {
                                nextCell.focus();
                                nextCell.select();
                                nextCell.scrollIntoView({ block: 'nearest' });
                            }
                        }
                    }
                    // Phím MŨI TÊN LÊN: Nhảy lên ô tương ứng của sinh viên phía trên
                    else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (rowIdx - 1 >= 0) {
                            const prevCell = document.querySelector(`.excel-cell-input[data-row="${rowIdx - 1}"][data-col="${col}"]`);
                            if (prevCell) {
                                prevCell.focus();
                                prevCell.select();
                                prevCell.scrollIntoView({ block: 'nearest' });
                            }
                        }
                    }
                    // Phím MŨI TÊN PHẢI (khi con trỏ ở cuối hoặc ô trống): Sang cột điểm tiếp theo trong cùng hàng
                    else if (e.key === 'ArrowRight' && (this.selectionEnd === this.value.length || this.value === '')) {
                        const nextColMap = { 'cc': 'gk', 'gk': 'ck', 'ck': 'note' };
                        const nextCol = nextColMap[col];
                        if (nextCol) {
                            const target = document.querySelector(`[data-row="${rowIdx}"][data-col="${nextCol}"]`);
                            if (target) {
                                e.preventDefault();
                                target.focus();
                                if (target.select) target.select();
                            }
                        }
                    }
                    // Phím MŨI TÊN TRÁI (khi con trỏ ở đầu hoặc ô trống): Sang cột điểm trước đó trong cùng hàng
                    else if (e.key === 'ArrowLeft' && (this.selectionStart === 0 || this.value === '')) {
                        const prevColMap = { 'note': 'ck', 'ck': 'gk', 'gk': 'cc' };
                        const prevCol = prevColMap[col];
                        if (prevCol) {
                            const target = document.querySelector(`[data-row="${rowIdx}"][data-col="${prevCol}"]`);
                            if (target) {
                                e.preventDefault();
                                target.focus();
                                if (target.select) target.select();
                            }
                        }
                    }
                });
            });

            // Ghi nhận ghi chú cũng hỗ trợ Enter/Mũi tên
            document.querySelectorAll('.excel-note-input').forEach(inp => {
                inp.addEventListener('focus', function () {
                    const tr = this.closest('tr');
                    document.querySelectorAll('.excel-row').forEach(r => r.classList.remove('excel-row-active'));
                    if (tr) tr.classList.add('excel-row-active');
                });
                inp.addEventListener('blur', function () {
                    const tr = this.closest('tr');
                    if (tr) tr.classList.remove('excel-row-active');
                });
                inp.addEventListener('keydown', function (e) {
                    const rowIdx = parseInt(this.getAttribute('data-row'), 10);
                    const totalRows = document.querySelectorAll('.excel-row').length;
                    if (e.key === 'Enter' || e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (rowIdx + 1 < totalRows) {
                            const next = document.querySelector(`.excel-note-input[data-row="${rowIdx + 1}"]`);
                            if (next) { next.focus(); next.select(); }
                        }
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (rowIdx - 1 >= 0) {
                            const prev = document.querySelector(`.excel-note-input[data-row="${rowIdx - 1}"]`);
                            if (prev) { prev.focus(); prev.select(); }
                        }
                    }
                });
            });
        });
    </script>
}
