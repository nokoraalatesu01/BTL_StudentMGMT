@model BTL_StudentMGMT.Models.DiemFormViewModel
@{
    ViewData["Title"] = "Nhập điểm học phần - Ghi nhận kết quả học tập";
}

<!-- Breadcrumb -->
<div class="page-breadcrumb-title mb-3" style="font-size: 1.15rem;">
    Đào tạo / Bảng điểm / <strong>Nhập điểm học phần</strong>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <!-- Header Card -->
            <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center bg-white">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                    <i class="bi bi-pencil-square text-primary" style="color: #2563eb !important;"></i>
                    Ghi Nhận Kết Quả Học Tập
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <!-- Form Content -->
            <div class="p-4">
                <form method="post" asp-action="NhapDiem" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <!-- Chọn sinh viên -->
                    <div class="col-12">
                        <label asp-for="SinhVienId" class="form-label small fw-semibold text-secondary">Sinh viên *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <select asp-for="SinhVienId" asp-items="ViewBag.DanhSachSinhVien" class="form-select border-start-0 ps-0">
                                <option value="">-- Chọn Sinh Viên --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SinhVienId" class="text-danger small"></span>
                    </div>

                    <!-- Chọn môn học -->
                    <div class="col-12">
                        <label asp-for="MonHocId" class="form-label small fw-semibold text-secondary">Môn học *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-journal-text"></i>
                            </span>
                            <select asp-for="MonHocId" asp-items="ViewBag.DanhSachMonHoc" class="form-select border-start-0 ps-0">
                                <option value="">-- Chọn Môn Học / Học Phần --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MonHocId" class="text-danger small"></span>
                    </div>

                    <!-- 3 Cột điểm -->
                    <div class="col-md-4">
                        <label asp-for="DiemChuyenCan" class="form-label small fw-semibold text-secondary">Điểm chuyên cần (10%) *</label>
                        <input asp-for="DiemChuyenCan" type="number" step="0.1" min="0" max="10" class="form-control" />
                        <span asp-validation-for="DiemChuyenCan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DiemGiuaKy" class="form-label small fw-semibold text-secondary">Điểm giữa kỳ (30%) *</label>
                        <input asp-for="DiemGiuaKy" type="number" step="0.1" min="0" max="10" class="form-control" />
                        <span asp-validation-for="DiemGiuaKy" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DiemCuoiKy" class="form-label small fw-semibold text-secondary">Điểm thi cuối kỳ (60%) *</label>
                        <input asp-for="DiemCuoiKy" type="number" step="0.1" min="0" max="10" class="form-control" />
                        <span asp-validation-for="DiemCuoiKy" class="text-danger small"></span>
                    </div>

                    <!-- Thông báo quy chế điểm -->
                    <div class="col-12 mt-3">
                        <div class="p-3 rounded-3 bg-light border text-muted small d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-primary" style="color: #2563eb !important;"></i>
                            <span>
                                <strong>Quy chế tính điểm học phần:</strong> Tổng kết = <strong>CC × 10% + GK × 30% + CK × 60%</strong>. Điểm tổng kết ≥ 4.0 là Đạt (Qua môn).
                            </span>
                        </div>
                    </div>

                    <!-- Nút hành động -->
                    <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end align-items-center gap-3">
                        <a asp-action="Index" class="text-decoration-none text-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary-blue px-4 py-2 rounded-3 d-flex align-items-center gap-2"
                                style="background: #4f46e5; border-color: #4f46e5;">
                            <i class="bi bi-floppy"></i>
                            Lưu kết quả điểm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
