@model BTL_StudentMGMT.Models.DiemFormViewModel
@{
    ViewData["Title"] = "Nhập điểm học phần";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_GiangVienLayout";
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">QUẢN LÝ ĐÀO TẠO</p>
        <h1>Nhập bảng điểm học phần</h1>
        <p>Ghi nhận điểm chuyên cần, giữa kỳ và thi kết thúc môn cho sinh viên.</p>
    </div>
    <a class="student-back-link" asp-action="Index">← Về bảng điểm</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <section class="student-panel p-4 mb-4">
            <div class="student-panel-heading mb-4">
                <div>
                    <p class="student-eyebrow">BIỂU MẪU ĐIỂM SỐ</p>
                    <h2>Ghi nhận kết quả học tập</h2>
                </div>
                <span class="student-cap-icon" aria-hidden="true">✎</span>
            </div>

            <form method="post" asp-action="NhapDiem">
                <div asp-validation-summary="ModelOnly" class="student-notice mb-3" style="background:#fee2e2; border-color:#fca5a5; color:#991b1b;"></div>

                <div class="row g-3 mb-4">
                    <!-- Chọn sinh viên -->
                    <div class="col-12">
                        <div class="gv-form-group">
                            <label asp-for="SinhVienId">Sinh viên *</label>
                            <select asp-for="SinhVienId" asp-items="ViewBag.DanhSachSinhVien" class="gv-form-select">
                                <option value="">-- Chọn Sinh Viên Cần Nhập Điểm --</option>
                            </select>
                            <span asp-validation-for="SinhVienId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Chọn môn học -->
                    <div class="col-12">
                        <div class="gv-form-group">
                            <label asp-for="MonHocId">Môn học / Học phần *</label>
                            <select asp-for="MonHocId" asp-items="ViewBag.DanhSachMonHoc" class="gv-form-select">
                                <option value="">-- Chọn Môn Học / Học Phần --</option>
                            </select>
                            <span asp-validation-for="MonHocId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 3 Cột điểm -->
                    <div class="col-md-4">
                        <div class="gv-form-group">
                            <label asp-for="DiemChuyenCan">Điểm chuyên cần (10%) *</label>
                            <input asp-for="DiemChuyenCan" type="number" step="0.1" min="0" max="10" class="gv-form-control score-input" id="inpCC" placeholder="0 - 10" />
                            <span asp-validation-for="DiemChuyenCan" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="gv-form-group">
                            <label asp-for="DiemGiuaKy">Điểm giữa kỳ (30%) *</label>
                            <input asp-for="DiemGiuaKy" type="number" step="0.1" min="0" max="10" class="gv-form-control score-input" id="inpGK" placeholder="0 - 10" />
                            <span asp-validation-for="DiemGiuaKy" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="gv-form-group">
                            <label asp-for="DiemCuoiKy">Thi hết môn (60%) *</label>
                            <input asp-for="DiemCuoiKy" type="number" step="0.1" min="0" max="10" class="gv-form-control score-input" id="inpCK" placeholder="0 - 10" />
                            <span asp-validation-for="DiemCuoiKy" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Box xem trước tổng kết -->
                <div class="p-3 mb-4 rounded-3 d-flex justify-content-between align-items-center" style="background: #f0f7fc; border: 1px solid #d4e7f5;">
                    <div>
                        <div style="font-size: .75rem; color: #507192; font-weight: 700; text-transform: uppercase;">Ước tính tổng kết (Hệ 10)</div>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <span id="txtTongKet" style="font-size: 1.6rem; font-weight: 800; color: #176da3;">0.0</span>
                            <span id="txtDiemChu" class="gv-badge gv-badge-blue">F</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <span id="txtDanhGia" class="gv-badge gv-badge-red" style="font-size: .82rem; padding: 6px 14px;">Chưa đạt</span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="gv-btn gv-btn-primary px-4">
                        <i class="bi bi-check-circle"></i> Lưu kết quả học phần
                    </button>
                    <a asp-action="Index" class="gv-btn gv-btn-secondary">
                        Hủy bỏ
                    </a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calculate() {
            var cc = parseFloat(document.getElementById('inpCC').value) || 0;
            var gk = parseFloat(document.getElementById('inpGK').value) || 0;
            var ck = parseFloat(document.getElementById('inpCK').value) || 0;

            var tk = (cc * 0.1) + (gk * 0.3) + (ck * 0.6);
            tk = Math.round(tk * 10) / 10;
            document.getElementById('txtTongKet').innerText = tk.toFixed(1);

            var chu = "F";
            var pass = false;
            if (tk >= 8.5) { chu = "A"; pass = true; }
            else if (tk >= 8.0) { chu = "B+"; pass = true; }
            else if (tk >= 7.0) { chu = "B"; pass = true; }
            else if (tk >= 6.5) { chu = "C+"; pass = true; }
            else if (tk >= 5.5) { chu = "C"; pass = true; }
            else if (tk >= 5.0) { chu = "D+"; pass = true; }
            else if (tk >= 4.0) { chu = "D"; pass = true; }

            var elChu = document.getElementById('txtDiemChu');
            elChu.innerText = chu;
            elChu.className = pass ? "gv-badge gv-badge-green" : "gv-badge gv-badge-red";

            var elDg = document.getElementById('txtDanhGia');
            if (pass) {
                elDg.innerText = "✓ Đạt học phần";
                elDg.className = "gv-badge gv-badge-green";
            } else {
                elDg.innerText = "✗ Cần học lại";
                elDg.className = "gv-badge gv-badge-red";
            }
        }

        document.querySelectorAll('.score-input').forEach(function(inp) {
            inp.addEventListener('input', calculate);
        });
        calculate();
    </script>
}
