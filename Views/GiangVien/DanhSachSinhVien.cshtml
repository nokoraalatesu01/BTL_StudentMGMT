@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.SinhVien>
@{
    ViewData["Title"] = "Danh sách sinh viên";
    Layout = "_GiangVienLayout";
}

<!-- Page Heading chuẩn Cổng sinh viên -->
<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">QUẢN LÝ ĐÀO TẠO</p>
        <h1>Danh sách sinh viên</h1>
        <p>Theo dõi thông tin sinh viên, kết quả học tập và thông tin các lớp học.</p>
    </div>
    <a class="student-back-link" asp-action="Index">← Về tổng quan</a>
</div>

<!-- Bộ lọc tìm kiếm đặt gọn trong student-panel -->
<div class="student-panel mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-lg-5 col-md-12">
            <input name="tuKhoa" value="@ViewBag.TuKhoa" class="gv-form-control"
                   placeholder="🔍 Tìm theo mã SV, họ tên, email..." />
        </div>

        <div class="col-lg-3 col-md-5">
            <select name="lopId" asp-items="ViewBag.DanhSachLop" class="gv-form-select">
                <option value="">-- Tất cả Lớp học --</option>
            </select>
        </div>

        <div class="col-lg-4 col-md-7 d-flex gap-2">
            <button type="submit" class="gv-btn gv-btn-primary">
                <i class="bi bi-funnel"></i> Lọc
            </button>
            <a asp-controller="QuanLySinhVien" asp-action="Create" class="gv-btn gv-btn-primary text-nowrap" style="background: #176da3 !important;">
                <i class="bi bi-plus-lg"></i> Thêm mới
            </a>
            <a asp-action="DanhSachSinhVien" class="gv-btn gv-btn-secondary" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Bảng hiển thị danh sách sinh viên -->
<div class="student-panel p-0 overflow-hidden mb-4">
    <div class="student-panel-heading p-3 border-bottom">
        <div>
            <p class="student-eyebrow mb-1">DỮ LIỆU SINH VIÊN</p>
            <h2 style="font-size: 1rem;">Tổng số: @Model.TotalItems sinh viên</h2>
        </div>
    </div>

    <div class="gv-table-responsive">
        <table class="gv-table">
            <thead>
                <tr>
                    <th style="width: 45px;"></th>
                    <th>MÃ SV</th>
                    <th>HỌ VÀ TÊN</th>
                    <th>NGÀY SINH</th>
                    <th>GIỚI TÍNH</th>
                    <th>KHOA / LỚP</th>
                    <th>ĐIỂM GPA</th>
                    <th>XẾP LOẠI</th>
                    <th>TRẠNG THÁI</th>
                    <th style="text-align: right;">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 0; }
                @foreach (var s in Model.Items)
                {
                    idx++;
                    var initial = string.IsNullOrWhiteSpace(s.HoTen) ? "S" : s.HoTen.Trim()[0].ToString().ToUpperInvariant();
                    var gpa = s.Gpa;
                    string rank = s.XepLoai;
                    string rankBadge = gpa == null
                        ? "gv-badge-gray"
                        : (gpa >= 8.5 ? "gv-badge-green" : (gpa >= 7.0 ? "gv-badge-blue" : "gv-badge-amber"));
                    string status = s.TrangThai ?? "Đang học";
                    string statusBadge = status switch
                    {
                        "Đang học" => "gv-badge-green",
                        "Tốt nghiệp" => "gv-badge-gray",
                        "Bảo lưu" => "gv-badge-amber",
                        _ => "gv-badge-red"
                    };

                    <tr>
                        <td>
                            <div class="gv-table-avatar">@initial</div>
                        </td>
                        <td>
                            <strong style="color: #176da3;">@s.MaSinhVien</strong>
                        </td>
                        <td>
                            <div style="font-weight: 600; color: #1b2e45;">@s.HoTen</div>
                            <span style="font-size: .75rem; color: #7a899a;">@(s.Email ?? "Chưa cập nhật")</span>
                        </td>
                        <td>
                            @(s.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")
                        </td>
                        <td>
                            @(s.GioiTinh ?? "—")
                        </td>
                        <td>
                            <div style="font-weight: 600; font-size: .82rem;">@(s.Lop?.TenLop ?? "Chưa xếp lớp")</div>
                            <span style="font-size: .75rem; color: #7a899a;">@(s.Lop?.Nganh?.TenNganh ?? "Chưa có ngành")</span>
                        </td>
                        <td>
                            @if (gpa == null)
                            {
                                <span style="color: #8290a0; font-size: .82rem;">Chưa có điểm</span>
                            }
                            else
                            {
                                <strong style="color: #176da3; font-size: .95rem;">@gpa.Value.ToString("0.00")</strong>
                            }
                        </td>
                        <td>
                            <span class="gv-badge @rankBadge">@rank</span>
                        </td>
                        <td>
                            <span class="gv-badge @statusBadge">@status</span>
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <a asp-action="ChiTietSinhVien" asp-route-id="@s.Id" class="gv-btn gv-btn-secondary gv-btn-sm" title="Xem hồ sơ">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <a asp-controller="BangDiem" asp-action="Index" asp-route-sinhVienId="@s.Id" class="gv-btn gv-btn-primary gv-btn-sm" title="Xem bảng điểm">
                                <i class="bi bi-award"></i> Điểm
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="10" style="text-align: center; padding: 40px; color: #8290a0;">
                            Không tìm thấy sinh viên nào phù hợp bộ lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Phân trang đồng bộ -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-center gap-1 mb-4">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <a class="gv-btn @(p == Model.Page ? "gv-btn-primary" : "gv-btn-secondary") gv-btn-sm"
               asp-action="DanhSachSinhVien"
               asp-route-page="@p"
               asp-route-tuKhoa="@ViewBag.TuKhoa"
               asp-route-lopId="@ViewBag.LopId">@p</a>
        }
    </div>
}
