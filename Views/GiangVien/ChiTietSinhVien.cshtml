@model BTL_StudentMGMT.Models.SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên - " + Model.HoTen;
    Layout = "_GiangVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.HoTen) ? "Sinh viên" : Model.HoTen.Trim();
    var nameInitial = displayName[0].ToString().ToUpperInvariant();
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">HỒ SƠ SINH VIÊN</p>
        <h1>Chi tiết sinh viên</h1>
        <p>Hồ sơ cá nhân và thông tin đào tạo được lưu trữ trên hệ thống.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="student-back-link" asp-action="DanhSachSinhVien">← Về danh sách</a>
    </div>
</div>

<section class="student-panel profile-panel mb-4">
    <div class="profile-banner">
        <div class="student-avatar large" aria-hidden="true">@nameInitial</div>
        <div>
            <h2>@displayName</h2>
            <p>Mã sinh viên: <strong>@Model.MaSinhVien</strong></p>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-controller="BangDiem" asp-action="Index" asp-route-sinhVienId="@Model.Id" class="gv-btn gv-btn-primary gv-btn-sm">
                <i class="bi bi-award"></i> Bảng điểm
            </a>
            <a asp-controller="BangDiem" asp-action="NhapDiem" class="gv-btn gv-btn-secondary gv-btn-sm">
                <i class="bi bi-pencil-square"></i> Nhập điểm
            </a>
        </div>
    </div>

    <div class="profile-section">
        <h3>Thông tin cá nhân</h3>
        <dl class="student-info-list">
            <div>
                <dt>Mã sinh viên</dt>
                <dd>@Model.MaSinhVien</dd>
            </div>
            <div>
                <dt>Họ và tên</dt>
                <dd>@Model.HoTen</dd>
            </div>
            <div>
                <dt>Ngày sinh</dt>
                <dd>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Giới tính</dt>
                <dd>@(Model.GioiTinh ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(Model.Email ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Số điện thoại</dt>
                <dd>@(Model.SoDienThoai ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Địa chỉ</dt>
                <dd>@(Model.DiaChi ?? "Chưa cập nhật")</dd>
            </div>
        </dl>
    </div>

    <div class="profile-section">
        <h3>Thông tin đào tạo</h3>
        <dl class="student-info-list">
            <div>
                <dt>Lớp</dt>
                <dd>@(Model.Lop?.TenLop ?? "Chưa xếp lớp")</dd>
            </div>
            <div>
                <dt>Ngành</dt>
                <dd>@(Model.Lop?.Nganh?.TenNganh ?? "Chưa xác định")</dd>
            </div>
            <div>
                <dt>Mã ngành</dt>
                <dd>@(Model.Lop?.Nganh?.MaNganh ?? "Chưa xác định")</dd>
            </div>
            <div>
                <dt>Khoa</dt>
                <dd>@(Model.Lop?.Nganh?.TenKhoa ?? "Chưa xác định")</dd>
            </div>
            <div>
                <dt>Khóa / Năm nhập học</dt>
                <dd>@(Model.NienKhoa ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Trạng thái học tập</dt>
                <dd>@(Model.TrangThai ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>GPA (Hệ 10)</dt>
                <dd>@(Model.Gpa.HasValue ? Model.Gpa.Value.ToString("0.00") : "Chưa có điểm")</dd>
            </div>
            <div>
                <dt>Xếp loại</dt>
                <dd>@Model.XepLoai</dd>
            </div>
        </dl>
    </div>

    @if (Model.Diems.Any())
    {
        <div class="profile-section">
            <h3>Kết quả học phần</h3>
            <div class="gv-table-responsive">
                <table class="gv-table">
                    <thead>
                        <tr>
                            <th>Mã học phần</th>
                            <th>Tên học phần</th>
                            <th style="text-align: center;">TC</th>
                            <th style="text-align: center;">Tổng kết</th>
                            <th style="text-align: center;">Điểm chữ</th>
                            <th style="text-align: center;">Kết quả</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var diem in Model.Diems.OrderBy(d => d.MonHoc?.TenMon))
                        {
                            var isPass = diem.DiemTongKet >= 4.0;
                            <tr>
                                <td><strong style="color: #176da3;">@diem.MonHoc?.MaMon</strong></td>
                                <td>@diem.MonHoc?.TenMon</td>
                                <td style="text-align: center;">@(diem.MonHoc?.SoTinChi ?? 0)</td>
                                <td style="text-align: center;"><strong style="color: #176da3;">@diem.DiemTongKet.ToString("0.0")</strong></td>
                                <td style="text-align: center;">@diem.DiemChu</td>
                                <td style="text-align: center;">
                                    <span class="gv-badge @(isPass ? "gv-badge-green" : "gv-badge-red")">
                                        @(isPass ? "Đạt" : "Học lại")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
