@model BTL_StudentMGMT.Models.SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên - " + Model.HoTen;
    Layout = "_GiangVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.HoTen) ? "Sinh viên" : Model.HoTen.Trim();
    var nameInitial = displayName[0].ToString().ToUpperInvariant();
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">HỒ SƠ SINH VIÊN</p>
        <h1>Chi tiết sinh viên</h1>
        <p>Hồ sơ cá nhân và thông tin đào tạo được lưu trữ trên hệ thống.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="student-back-link" asp-action="DanhSachSinhVien">← Về danh sách</a>
    </div>
</div>

<section class="student-panel profile-panel mb-4">
    <div class="profile-banner">
        <div class="student-avatar large" aria-hidden="true">@nameInitial</div>
        <div>
            <h2>@displayName</h2>
            <p>Mã sinh viên: <strong>@Model.MaSinhVien</strong></p>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-controller="BangDiem" asp-action="Index" asp-route-sinhVienId="@Model.Id" class="gv-btn gv-btn-primary gv-btn-sm">
                <i class="bi bi-award"></i> Bảng điểm
            </a>
            <a asp-controller="BangDiem" asp-action="NhapDiem" class="gv-btn gv-btn-secondary gv-btn-sm">
                <i class="bi bi-pencil-square"></i> Nhập điểm
            </a>
        </div>
    </div>

    <div class="profile-section">
        <h3>Thông tin cá nhân</h3>
        <dl class="student-info-list">
            <div>
                <dt>Mã sinh viên</dt>
                <dd>@Model.MaSinhVien</dd>
            </div>
            <div>
                <dt>Họ và tên</dt>
                <dd>@Model.HoTen</dd>
            </div>
            <div>
                <dt>Ngày sinh</dt>
                <dd>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Giới tính</dt>
                <dd>@(Model.GioiTinh ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(Model.Email ?? $"{Model.MaSinhVien.ToLower()}@student.edu.vn")</dd>
            </div>
            <div>
                <dt>Số điện thoại</dt>
                <dd>@(Model.SoDienThoai ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Địa chỉ</dt>
                <dd>@(Model.DiaChi ?? "Chưa cập nhật")</dd>
            </div>
        </dl>
    </div>

    <div class="profile-section">
        <h3>Thông tin đào tạo</h3>
        <dl class="student-info-list">
            <div>
                <dt>Lớp</dt>
                <dd>@(Model.Lop?.TenLop ?? "Chưa xếp lớp")</dd>
            </div>
            <div>
                <dt>Ngành</dt>
                <dd>@(Model.Lop?.Nganh?.TenNganh ?? "Chưa xác định")</dd>
            </div>
            <div>
                <dt>Mã ngành</dt>
                <dd>@(Model.Lop?.Nganh?.MaNganh ?? "Chưa xác định")</dd>
            </div>
            <div>
                <dt>Khoa</dt>
                <dd>@(Model.Lop?.Nganh?.TenNganh ?? "Công nghệ thông tin")</dd>
            </div>
        </dl>
    </div>
</section>
