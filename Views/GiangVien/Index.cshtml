@model BTL_StudentMGMT.Models.GiangVien
@{
    ViewData["Title"] = "Tổng quan giảng viên";
    Layout = "_GiangVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model?.HoTen) ? (User.Identity?.Name ?? "Giảng viên") : Model.HoTen.Trim();
    var nameInitial = displayName[0].ToString().ToUpperInvariant();
}

<!-- Welcome Section y hệt Cổng Sinh Viên -->
<section class="student-welcome">
    <div>
        <p class="student-eyebrow">CỔNG THÔNG TIN GIẢNG VIÊN</p>
        <h1>Xin chào, @displayName</h1>
        <p>Đây là trang tổng quan công tác giảng dạy và quản lý sinh viên của bạn.</p>
    </div>
    <div class="student-avatar" aria-hidden="true">@nameInitial</div>
</section>

@if (TempData["Msg"] != null)
{
    <div class="student-notice mb-3" style="background: #eaf6f0; border-color: #badccf; color: #205c47;">
        <strong>Thông báo:</strong> @TempData["Msg"]
    </div>
}

<!-- 3 Thẻ thống kê đồng bộ giao diện sinh viên -->
<section class="student-stat-grid" aria-label="Thống kê đào tạo">
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-blue" aria-hidden="true">SV</span>
        <div>
            <p>Tổng số sinh viên</p>
            <strong>@ViewBag.TongSoSinhVien sinh viên</strong>
        </div>
    </article>
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-green" aria-hidden="true">L</span>
        <div>
            <p>Tổng số lớp học</p>
            <strong>@ViewBag.TongSoLop lớp hành chính</strong>
        </div>
    </article>
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-violet" aria-hidden="true">N</span>
        <div>
            <p>Ngành đào tạo</p>
            <strong>@ViewBag.TongSoNganh ngành học</strong>
        </div>
    </article>
</section>

<!-- Content Grid 2 cột: Hồ sơ & Tác vụ đào tạo -->
<div class="student-content-grid">
    <!-- Cột 1: Thông tin của tôi -->
    <section class="student-panel">
        <div class="student-panel-heading">
            <div>
                <p class="student-eyebrow">HỒ SƠ CÁ NHÂN</p>
                <h2>Thông tin của tôi</h2>
            </div>
            <a class="student-text-link" asp-action="CapNhatThongTin">Cập nhật <span aria-hidden="true">→</span></a>
        </div>

        <dl class="student-info-list">
            <div>
                <dt>Họ và tên</dt>
                <dd>@displayName</dd>
            </div>
            <div>
                <dt>Mã giảng viên</dt>
                <dd>@(Model?.MaGiangVien ?? "GV01")</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(Model?.Email ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Số điện thoại</dt>
                <dd>@(Model?.SoDienThoai ?? "Chưa cập nhật")</dd>
            </div>
        </dl>
    </section>

    <!-- Cột 2: Tác vụ quản lý & đào tạo -->
    <section class="student-panel class-panel">
        <div class="student-panel-heading">
            <div>
                <p class="student-eyebrow">TÁC VỤ ĐÀO TẠO</p>
                <h2>Quản lý & Giảng dạy</h2>
            </div>
            <span class="student-cap-icon" aria-hidden="true">✦</span>
        </div>

        <div class="gv-action-list">
            <a class="gv-action-row" asp-action="DanhSachSinhVien">
                <div class="gv-action-icon gv-icon-blue">👥</div>
                <div class="gv-action-info">
                    <strong>Danh sách sinh viên</strong>
                    <span>Tra cứu, tìm kiếm và lọc hồ sơ theo từng lớp học</span>
                </div>
                <span class="gv-action-arrow">→</span>
            </a>

            <a class="gv-action-row" asp-controller="BangDiem" asp-action="Index">
                <div class="gv-action-icon gv-icon-green">✦</div>
                <div class="gv-action-info">
                    <strong>Bảng điểm sinh viên</strong>
                    <span>Xem tổng hợp kết quả học phần, chuyên cần, giữa kỳ, GPA</span>
                </div>
                <span class="gv-action-arrow">→</span>
            </a>

            <a class="gv-action-row" asp-controller="BangDiem" asp-action="NhapDiem">
                <div class="gv-action-icon gv-icon-violet">✎</div>
                <div class="gv-action-info">
                    <strong>Nhập bảng điểm học phần</strong>
                    <span>Ghi nhận điểm thi, chuyên cần theo môn học cho sinh viên</span>
                </div>
                <span class="gv-action-arrow">→</span>
            </a>

            <a class="gv-action-row" asp-action="LichGiangDay">
                <div class="gv-action-icon gv-icon-amber">📅</div>
                <div class="gv-action-info">
                    <strong>Lịch giảng dạy & Thời khóa biểu</strong>
                    <span>Xem thời khóa biểu các ca học trong tuần, phòng máy và lớp dạy</span>
                </div>
                <span class="gv-action-arrow">→</span>
            </a>

            <a class="gv-action-row" asp-action="DiemDanh">
                <div class="gv-action-icon gv-icon-blue">✓</div>
                <div class="gv-action-info">
                    <strong>Điểm danh sinh viên theo buổi</strong>
                    <span>Ghi nhận sĩ số, sinh viên vắng mặt, có phép theo từng buổi học</span>
                </div>
                <span class="gv-action-arrow">→</span>
            </a>
        </div>
    </section>
</div>
