@model BTL_StudentMGMT.Models.GiangVien
@{
    ViewData["Title"] = "Cổng thông tin Giảng viên";
}

<div class="row g-4">
    <!-- Hero Banner Chào Mừng -->
    <div class="col-12">
        <div class="hero-card-banner d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow"
                     style="width: 60px; height: 60px; font-size: 1.8rem; color: #1e3a8a !important;">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <div>
                    <span class="badge bg-white bg-opacity-25 text-white mb-1 px-3 py-1 rounded-pill">
                        Giảng viên Khoa Đào tạo
                    </span>
                    <h2 class="fw-bold mb-1 text-white">Xin chào, @(Model?.HoTen ?? User.Identity?.Name)!</h2>
                    <p class="text-sub mb-0">Hệ thống Cổng thông tin & Theo dõi học tập Sinh viên</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="CapNhatThongTin" class="btn btn-light rounded-pill px-4 fw-semibold text-primary shadow-sm" style="color: #1e3a8a !important;">
                    <i class="bi bi-pencil-square"></i> Cập nhật hồ sơ
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["Msg"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- 3 Thẻ thống kê Stat Boxes -->
    <div class="col-md-4">
        <div class="stat-box">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Tổng số sinh viên</span>
                    <div class="stat-big-number mt-1 text-primary" style="color: #2563eb !important;">@ViewBag.TongSoSinhVien</div>
                    <span class="badge bg-primary-subtle text-primary mt-2">Toàn trường</span>
                </div>
                <div class="stat-icon-wrap blue">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a asp-action="DanhSachSinhVien" class="text-decoration-none fw-semibold d-flex align-items-center gap-1 small text-primary" style="color: #2563eb !important;">
                    <span>Xem danh sách sinh viên</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-box">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Tổng số lớp học</span>
                    <div class="stat-big-number mt-1 text-success" style="color: #16a34a !important;">@ViewBag.TongSoLop</div>
                    <span class="badge bg-success-subtle text-success mt-2">Đang giảng dạy</span>
                </div>
                <div class="stat-icon-wrap green">
                    <i class="bi bi-easel2-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a asp-action="DanhSachSinhVien" class="text-decoration-none fw-semibold d-flex align-items-center gap-1 small text-success" style="color: #16a34a !important;">
                    <span>Phân loại theo lớp</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-box">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Ngành đào tạo</span>
                    <div class="stat-big-number mt-1 text-warning" style="color: #d97706 !important;">@ViewBag.TongSoNganh</div>
                    <span class="badge bg-warning-subtle text-warning mt-2">Học viện</span>
                </div>
                <div class="stat-icon-wrap amber">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <span class="text-muted small">Chương trình chuẩn đại học</span>
            </div>
        </div>
    </div>

    <!-- Thông tin cá nhân giảng viên -->
    <div class="col-lg-6">
        <div class="content-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill text-primary" style="color: #2563eb !important;"></i>
                    Thông tin hồ sơ giảng viên
                </h5>
                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Đang hoạt động</span>
            </div>
            @if (Model != null)
            {
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                        <span class="text-muted small d-flex align-items-center gap-2">
                            <i class="bi bi-upc-scan"></i> Mã giảng viên:
                        </span>
                        <span class="fw-bold text-dark">@Model.MaGiangVien</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                        <span class="text-muted small d-flex align-items-center gap-2">
                            <i class="bi bi-person"></i> Họ và tên:
                        </span>
                        <span class="fw-bold text-dark">@Model.HoTen</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                        <span class="text-muted small d-flex align-items-center gap-2">
                            <i class="bi bi-envelope"></i> Email:
                        </span>
                        <span class="text-dark fw-semibold">@(Model.Email ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                        <span class="text-muted small d-flex align-items-center gap-2">
                            <i class="bi bi-telephone"></i> Số điện thoại:
                        </span>
                        <span class="text-dark fw-semibold">@(Model.SoDienThoai ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                        <span class="text-muted small d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock"></i> Tài khoản:
                        </span>
                        <span class="badge bg-primary rounded-pill px-3" style="background: #2563eb !important;">@User.Identity?.Name</span>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Chưa có thông tin hồ sơ trong cơ sở dữ liệu.</p>
            }
        </div>
    </div>

    <!-- Tác vụ nhanh -->
    <div class="col-lg-6">
        <div class="content-card h-100 p-4">
            <h5 class="fw-bold mb-3 pb-2 border-bottom text-dark d-flex align-items-center gap-2">
                <i class="bi bi-grid-fill text-primary" style="color: #2563eb !important;"></i>
                Tác vụ giảng dạy & Quản lý
            </h5>
            <div class="d-flex flex-column gap-3 justify-content-center">
                <a asp-action="DanhSachSinhVien" class="quick-action-item">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon-wrap blue" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-6">Tra cứu & Danh sách sinh viên</div>
                            <div class="text-muted small">Tìm kiếm theo mã SV, họ tên và lọc theo từng lớp học</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>

                <a asp-controller="BangDiem" asp-action="Index" class="quick-action-item">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon-wrap green" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-6">Quản lý Bảng điểm & Nhập điểm học phần</div>
                            <div class="text-muted small">Nhập điểm CC, giữa kỳ, cuối kỳ và xem kết quả học tập</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>

                <a asp-action="CapNhatThongTin" class="quick-action-item">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon-wrap amber" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-6">Cập nhật hồ sơ & Đổi mật khẩu</div>
                            <div class="text-muted small">Thay đổi số điện thoại, email và mật khẩu tài khoản</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>
