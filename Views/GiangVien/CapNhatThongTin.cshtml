@model BTL_StudentMGMT.Models.CapNhatGiangVienViewModel
@{
    ViewData["Title"] = "Cập nhật hồ sơ giảng viên";
    Layout = "_GiangVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.HoTen) ? (User.Identity?.Name ?? "Giảng viên") : Model.HoTen.Trim();
    var nameInitial = displayName[0].ToString().ToUpperInvariant();
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">HỒ SƠ CÁ NHÂN</p>
        <h1>Cập nhật hồ sơ</h1>
        <p>Thay đổi thông tin liên lạc hoặc đổi mật khẩu tài khoản của bạn.</p>
    </div>
    <a class="student-back-link" asp-action="Index">← Về tổng quan</a>
</div>

<section class="student-panel profile-panel mb-4">
    <div class="profile-banner">
        <div class="student-avatar large" aria-hidden="true">@nameInitial</div>
        <div>
            <h2>@displayName</h2>
            <p>Mã giảng viên: <strong>@Model.MaGiangVien</strong></p>
        </div>
    </div>

    <div class="profile-section">
        <form method="post" asp-action="CapNhatThongTin">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="student-notice mb-3" style="background:#fee2e2; border-color:#fca5a5; color:#991b1b;"></div>

            <h3>Thông tin liên hệ</h3>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="gv-form-group">
                        <label asp-for="MaGiangVien">Mã giảng viên (Cố định)</label>
                        <input asp-for="MaGiangVien" class="gv-form-control" style="background: #f1f5f9;" readonly />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="gv-form-group">
                        <label asp-for="HoTen">Họ và tên *</label>
                        <input asp-for="HoTen" class="gv-form-control" placeholder="Nhập họ và tên..." />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="gv-form-group">
                        <label asp-for="Email">Email liên lạc</label>
                        <input asp-for="Email" class="gv-form-control" placeholder="example@domain.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="gv-form-group">
                        <label asp-for="SoDienThoai">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="gv-form-control" placeholder="09xxxxxxxx" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <h3 class="mt-4 pt-3 border-top">Đổi mật khẩu tài khoản (Tùy chọn)</h3>
            <p class="text-muted small mb-3">Nếu không đổi mật khẩu, vui lòng để trống 2 ô bên dưới.</p>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="gv-form-group">
                        <label asp-for="MatKhauMoi">Mật khẩu mới</label>
                        <input asp-for="MatKhauMoi" type="password" class="gv-form-control" placeholder="Nhập mật khẩu mới..." />
                        <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="gv-form-group">
                        <label asp-for="XacNhanMatKhau">Xác nhận mật khẩu mới</label>
                        <input asp-for="XacNhanMatKhau" type="password" class="gv-form-control" placeholder="Nhập lại mật khẩu mới..." />
                        <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
                <button type="submit" class="gv-btn gv-btn-primary">
                    <i class="bi bi-check-lg"></i> Lưu thay đổi
                </button>
                <a asp-action="Index" class="gv-btn gv-btn-secondary">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</section>
