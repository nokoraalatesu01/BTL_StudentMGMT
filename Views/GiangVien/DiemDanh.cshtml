@model BTL_StudentMGMT.Models.DiemDanhFormViewModel
@using BTL_StudentMGMT.Models
@{
    ViewData["Title"] = "Điểm danh lớp học phần";
    Layout = "_GiangVienLayout";
    var selectedLhp = ViewBag.SelectedLhp as BTL_StudentMGMT.Models.LopHocPhan;
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">QUẢN LÝ CHUYÊN CẦN</p>
        <h1>Điểm danh sinh viên theo Lớp học phần</h1>
        <p>Ghi nhận chuyên cần của sinh viên đăng ký theo từng Lớp học phần tín chỉ (sinh viên từ nhiều lớp hành chính khác nhau).</p>
    </div>
    <a class="student-back-link" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về tổng quan</a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="student-notice mb-3" style="background: #eaf6f0; border-color: #badccf; color: #205c47;">
        <strong>Thông báo:</strong> @TempData["Msg"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="student-notice mb-3" style="background: #fdf2f2; border-color: #f8b4b4; color: #9b1c1c;">
        <strong>Lỗi:</strong> @TempData["Error"]
    </div>
}
@if (!Model.CanEdit)
{
    <div class="student-notice mb-3" style="background: #fff8e1; border-color: #ffe082; color: #856404;">
        <i class="bi bi-lock-fill me-1"></i>
        <strong>Chế độ chỉ xem:</strong> @(Model.EditRestrictionReason ?? "Buổi học này đã khóa sửa hoặc không thể điểm danh.")
    </div>
}

<!-- Bộ chọn Lớp học phần và Buổi học / Ngày học -->
<div class="student-panel mb-4 p-3">
    <form method="get" asp-action="DiemDanh" class="row g-3 align-items-center">
        <div class="col-lg-5 col-md-5">
            <label class="form-label small fw-semibold text-muted mb-1">LỚP HỌC PHẦN PHỤ TRÁCH</label>
            <select name="lopHocPhanId" asp-items="ViewBag.DanhSachLopHocPhan" class="gv-form-select" onchange="this.form.submit()">
            </select>
        </div>

        <div class="col-lg-4 col-md-4">
            <label class="form-label small fw-semibold text-muted mb-1">DANH SÁCH BUỔI HỌC CỦA LỚP</label>
            <select class="gv-form-select" onchange="if(this.value){ document.getElementById('inputNgayDiemDanh').value = this.value; this.form.submit(); }">
                <option value="">-- Chọn buổi học --</option>
                @foreach (var b in Model.DanhSachBuoiHoc)
                {
                    var isSel = b.NgayHoc.ToString("yyyy-MM-dd") == ViewBag.NgayChon;
                    <option value="@b.NgayHoc.ToString("yyyy-MM-dd")" selected="@(isSel ? "selected" : null)">
                        @b.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-lg-3 col-md-3">
            <label class="form-label small fw-semibold text-muted mb-1">NGÀY ĐIỂM DANH</label>
            <input type="date" id="inputNgayDiemDanh" name="ngay" value="@ViewBag.NgayChon" class="gv-form-control" onchange="this.form.submit()" />
        </div>
    </form>
</div>

<!-- Bảng nhập điểm danh -->
<div class="student-panel p-0 overflow-hidden mb-4">
    <div class="student-panel-heading p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <p class="student-eyebrow mb-1">
                LỚP HỌC PHẦN: <strong class="text-primary font-monospace">@(selectedLhp?.MaLopHocPhan ?? Model.MaLopHocPhan ?? "CHƯA CHỌN")</strong>
                &bull; <span>Lịch: @(selectedLhp?.Thu ?? Model.Thu), @Model.KhungGio (Phòng: @(selectedLhp?.PhongHoc ?? Model.PhongHoc))</span>
            </p>
            <h2 style="font-size: 1rem;">
                @(selectedLhp?.TenLopHocPhan ?? Model.TenLopHocPhan ?? "Vui lòng chọn lớp học phần") — Sĩ số đã đăng ký: <span class="badge bg-primary">@Model.DanhSachSinhVien.Count SV</span>
            </h2>
        </div>
        @if (Model.CanEdit)
        {
            <div class="d-flex gap-2">
                <button type="button" class="gv-btn gv-btn-secondary gv-btn-sm" onclick="setAll('@AttendanceStatus.Present')">
                    <i class="bi bi-check-all text-success"></i> Chọn tất cả Có mặt
                </button>
                <button type="button" class="gv-btn gv-btn-secondary gv-btn-sm" onclick="setAll('@AttendanceStatus.Absent')">
                    <i class="bi bi-x-circle text-danger"></i> Chọn tất cả Vắng
                </button>
            </div>
        }
        else
        {
            <span class="badge bg-secondary p-2"><i class="bi bi-lock me-1"></i>Đã khóa chỉnh sửa</span>
        }
    </div>

    @if (Model.DanhSachSinhVien.Any())
    {
        <form method="post" asp-action="LuuDiemDanh">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LopHocPhanId" />
            <input type="hidden" asp-for="NgayDiemDanh" />

            <div class="gv-table-responsive">
                <table class="gv-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">STT</th>
                            <th>MÃ SV</th>
                            <th>HỌ VÀ TÊN</th>
                            <th>LỚP HÀNH CHÍNH</th>
                            <th style="text-align: center;">TRẠNG THÁI ĐIỂM DANH <span class="text-danger">*</span></th>
                            <th>GHI CHÚ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.DanhSachSinhVien.Count; i++)
                        {
                            var sv = Model.DanhSachSinhVien[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <strong style="color: var(--blue-600); font-family: monospace;">@sv.MaSinhVien</strong>
                                    <input type="hidden" name="DanhSachSinhVien[@i].SinhVienId" value="@sv.SinhVienId" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].MaSinhVien" value="@sv.MaSinhVien" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].HoTen" value="@sv.HoTen" />
                                    <input type="hidden" name="DanhSachSinhVien[@i].TenLopHanhChinh" value="@sv.TenLopHanhChinh" />
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: #1b2e45;">@sv.HoTen</span>
                                </td>
                                <td>
                                    <span class="badge px-2 py-1 fw-bold" style="background:#eff6ff; color:#1d4ed8; border-radius:6px;">
                                        @sv.TenLopHanhChinh
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <div class="d-inline-flex gap-2 align-items-center">
                                        <label class="gv-status-radio gv-status-comat">
                                            <input type="radio" name="DanhSachSinhVien[@i].TrangThai" value="@AttendanceStatus.Present" @(sv.TrangThai == AttendanceStatus.Present ? "checked" : "") @(!Model.CanEdit ? "disabled" : "") required />
                                            <span>✓ Có mặt</span>
                                        </label>

                                        <label class="gv-status-radio gv-status-vang">
                                            <input type="radio" name="DanhSachSinhVien[@i].TrangThai" value="@AttendanceStatus.Absent" @(sv.TrangThai == AttendanceStatus.Absent ? "checked" : "") @(!Model.CanEdit ? "disabled" : "") required />
                                            <span>✗ Vắng</span>
                                        </label>

                                        <label class="gv-status-radio gv-status-phep">
                                            <input type="radio" name="DanhSachSinhVien[@i].TrangThai" value="@AttendanceStatus.Excused" @(sv.TrangThai == AttendanceStatus.Excused ? "checked" : "") @(!Model.CanEdit ? "disabled" : "") required />
                                            <span>△ Có phép</span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" name="DanhSachSinhVien[@i].GhiChu" value="@sv.GhiChu" class="form-control form-control-sm" placeholder="Ghi chú (nếu có)..." style="font-size:.8rem;" @(!Model.CanEdit ? "disabled" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    <i class="bi bi-info-circle"></i> Điểm danh được lưu trực tiếp vào Lớp học phần tín chỉ. Mọi sinh viên phải được chọn trạng thái.
                </span>
                @if (Model.CanEdit)
                {
                    <button type="submit" class="gv-btn gv-btn-primary px-4">
                        <i class="bi bi-check-circle-fill"></i> Lưu kết quả điểm danh
                    </button>
                }
                else
                {
                    <button type="button" class="gv-btn gv-btn-secondary px-4" disabled>
                        <i class="bi bi-lock-fill"></i> Đã quá hạn sửa
                    </button>
                }
            </div>
        </form>
    }
    else
    {
        <div style="text-align: center; padding: 40px; color: #8290a0;">
            <i class="bi bi-people fs-2 d-block mb-2 text-muted"></i>
            Lớp học phần này hiện chưa có sinh viên nào đăng ký. Vui lòng chọn lớp học phần khác.
        </div>
    }
</div>

@section Scripts {
    <script>
        function setAll(status) {
            document.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                if (radio.value === status && !radio.disabled) {
                    radio.checked = true;
                }
            });
        }
    </script>
}
