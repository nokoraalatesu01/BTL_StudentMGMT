@model BTL_StudentMGMT.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
    var max = Model.ThongKeTheoLop.Any() ? Math.Max(1, Model.ThongKeTheoLop.Max(x => x.SoSinhVien)) : 1;
}

<h2 class="mb-4">Tổng quan</h2>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <span class="stat-ico blue" aria-hidden="true"><i class="bi bi-people"></i></span>
            <div class="stat-body">
                <div class="stat-label">Sinh viên</div>
                <div class="num">@Model.TongSinhVien</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <span class="stat-ico teal" aria-hidden="true"><i class="bi bi-person-workspace"></i></span>
            <div class="stat-body">
                <div class="stat-label">Giảng viên</div>
                <div class="num">@Model.TongGiangVien</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <span class="stat-ico violet" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
            <div class="stat-body">
                <div class="stat-label">Ngành</div>
                <div class="num">@Model.TongNganh</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <span class="stat-ico amber" aria-hidden="true"><i class="bi bi-collection"></i></span>
            <div class="stat-body">
                <div class="stat-label">Lớp</div>
                <div class="num">@Model.TongLop</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <span class="stat-ico rose" aria-hidden="true"><i class="bi bi-journal-bookmark"></i></span>
            <div class="stat-body">
                <div class="stat-label">Môn học</div>
                <div class="num">@Model.TongMonHoc</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card">
            <span class="stat-ico ink" aria-hidden="true"><i class="bi bi-shield-lock"></i></span>
            <div class="stat-body">
                <div class="stat-label">Tài khoản</div>
                <div class="num">@Model.TongTaiKhoan</div>
            </div>
        </div>
    </div>
</div>

@if (Model.SinhVienChuaCoLop > 0)
{
    <div class="alert alert-warning">Có @Model.SinhVienChuaCoLop sinh viên chưa được xếp lớp.</div>
}
@if (Model.GiangVienChuaCoTaiKhoan > 0 || Model.SinhVienChuaCoTaiKhoan > 0)
{
    <div class="alert alert-warning">
        Chưa cấp tài khoản cho
        @if (Model.SinhVienChuaCoTaiKhoan > 0)
        {
            <span>@Model.SinhVienChuaCoTaiKhoan sinh viên</span>
        }
        @if (Model.SinhVienChuaCoTaiKhoan > 0 && Model.GiangVienChuaCoTaiKhoan > 0)
        {
            <span> và </span>
        }
        @if (Model.GiangVienChuaCoTaiKhoan > 0)
        {
            <span>@Model.GiangVienChuaCoTaiKhoan giảng viên</span>
        }.
        <a asp-controller="QuanLyTaiKhoan" asp-action="Index" class="alert-link">Quản lý tài khoản</a>
    </div>
}

<div class="stat-card chart-card">
    <h5>Số sinh viên theo lớp</h5>
    <p class="chart-sub">Phân bố sinh viên đang được xếp vào từng lớp hành chính.</p>

    @foreach (var x in Model.ThongKeTheoLop)
    {
        <div class="bar-row">
            <div class="label">@x.TenLop</div>
            <div class="bar" style="width:@((x.SoSinhVien * 100 / max))%"></div>
            <div>@x.SoSinhVien</div>
        </div>
    }

    @if (!Model.ThongKeTheoLop.Any())
    {
        <div class="text-muted">Chưa có dữ liệu lớp.</div>
    }
</div>
