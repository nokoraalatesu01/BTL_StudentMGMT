@model BTL_StudentMGMT.Models.SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<h2>Hồ sơ sinh viên</h2>

<dl class="row" style="max-width:640px">
    <dt class="col-sm-4">Mã sinh viên</dt>
    <dd class="col-sm-8">@Model.MaSinhVien</dd>

    <dt class="col-sm-4">Họ tên</dt>
    <dd class="col-sm-8">@Model.HoTen</dd>

    <dt class="col-sm-4">Ngày sinh</dt>
    <dd class="col-sm-8">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-4">Giới tính</dt>
    <dd class="col-sm-8">@Model.GioiTinh</dd>

    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>

    <dt class="col-sm-4">Số điện thoại</dt>
    <dd class="col-sm-8">@Model.SoDienThoai</dd>

    <dt class="col-sm-4">Địa chỉ</dt>
    <dd class="col-sm-8">@Model.DiaChi</dd>

    <dt class="col-sm-4">Lớp</dt>
    <dd class="col-sm-8">@Model.Lop?.TenLop</dd>

    <dt class="col-sm-4">Ngành</dt>
    <dd class="col-sm-8">@Model.Lop?.Nganh?.TenNganh</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
