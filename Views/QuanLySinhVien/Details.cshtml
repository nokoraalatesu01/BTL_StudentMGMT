@model BTL_StudentMGMT.Models.SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên - Quản trị viên";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="modern-card hover-card">
            <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="user-avatar-badge" style="width: 52px; height: 52px; font-size: 1.4rem;">
                        @(Model.HoTen.Length > 0 ? Model.HoTen.Substring(0, 1).ToUpper() : "S")
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.HoTen</h4>
                        <span class="text-muted small">Mã SV: <strong class="text-primary">@Model.MaSinhVien</strong></span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-modern-outline">
                        <i class="bi bi-pencil text-warning"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-modern-outline">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>

            <div class="p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-calendar-event fs-4 text-primary"></i>
                            <div>
                                <small class="text-muted d-block">Ngày sinh</small>
                                <span class="fw-bold text-dark">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-gender-ambiguous fs-4 text-info"></i>
                            <div>
                                <small class="text-muted d-block">Giới tính</small>
                                <span class="fw-bold text-dark">@(Model.GioiTinh ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-envelope fs-4 text-success"></i>
                            <div>
                                <small class="text-muted d-block">Email</small>
                                <span class="fw-bold text-dark">@(Model.Email ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-telephone fs-4 text-warning"></i>
                            <div>
                                <small class="text-muted d-block">Số điện thoại</small>
                                <span class="fw-bold text-dark">@(Model.SoDienThoai ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-geo-alt fs-4 text-danger"></i>
                            <div>
                                <small class="text-muted d-block">Địa chỉ</small>
                                <span class="fw-bold text-dark">@(Model.DiaChi ?? "—")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-mortarboard fs-4 text-primary"></i>
                            <div>
                                <small class="text-muted d-block">Lớp sinh hoạt</small>
                                <span class="badge badge-soft-primary fs-6">@(Model.Lop?.TenLop ?? "Chưa xếp lớp")</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light d-flex align-items-center gap-3">
                            <i class="bi bi-journal-bookmark fs-4 text-primary"></i>
                            <div>
                                <small class="text-muted d-block">Ngành học</small>
                                <span class="fw-bold text-dark">@(Model.Lop?.Nganh?.TenNganh ?? "—")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 border-top bg-light text-end">
                <a asp-action="Index" class="btn btn-modern-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách sinh viên
                </a>
            </div>
        </div>
    </div>
</div>
