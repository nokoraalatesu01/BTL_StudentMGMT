@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.SinhVien>
@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý sinh viên</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm sinh viên</a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo mã hoặc họ tên" />
    </div>
    <div class="col-md-4">
        <select name="lopId" asp-items="ViewBag.DanhSachLop" class="form-select">
            <option value="">-- Tất cả lớp --</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Lớp</th>
            <th>Ngành</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Items)
        {
            <tr>
                <td>@s.MaSinhVien</td>
                <td>@s.HoTen</td>
                <td>@s.Lop?.TenLop</td>
                <td>@s.Lop?.Nganh?.TenNganh</td>
                <td>@s.Email</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-info">Xem</a>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa sinh viên này?');">
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }

        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Không có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@p"
                   asp-route-tuKhoa="@ViewBag.TuKhoa"
                   asp-route-lopId="@ViewBag.LopId">@p</a>
            </li>
        }
    </ul>
</nav>
