@model BTL_StudentMGMT.Models.PagedResult<BTL_StudentMGMT.Models.SinhVien>
@{
    ViewData["Title"] = "Quản Lý Danh Sách Sinh Viên - Admin";
    var avatarColors = new[] { "gray", "pink", "cyan", "purple", "green" };
    int startRecord = (Model.Page - 1) * Model.PageSize + 1;
    int endRecord   = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<!-- ===== TIÊU ĐỀ TRANG ===== -->
<div class="page-header">
    <div>
        <p class="page-breadcrumb">
            <span style="color:#94a3b8;">Đào tạo</span>
            <span class="bc-sep">›</span>
            <span class="bc-cur">Sinh viên</span>
        </p>
        <h3 class="page-title">Quản lý thông tin sinh viên</h3>
        <p class="page-subtitle">Danh sách sinh viên toàn trường, thêm mới, phân lớp và quản lý học tập.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="ExportExcel" asp-route-tuKhoa="@ViewBag.TuKhoa" asp-route-lopId="@ViewBag.LopId" asp-route-trangThai="@ViewBag.TrangThai"
           class="btn-action-secondary">
            <i class="bi bi-download"></i> Xuất Excel
        </a>
        <a asp-action="ExportSample" class="btn-action-secondary">
            <i class="bi bi-file-earmark-excel"></i> Xuất mẫu
        </a>
        <button type="button" class="btn-action-secondary" data-bs-toggle="modal" data-bs-target="#importExcelModal">
            <i class="bi bi-upload"></i> Nhập từ Excel
        </button>
        <a asp-action="Create" class="btn-action-primary">
            <i class="bi bi-plus-lg"></i> Thêm sinh viên
        </a>
    </div>
</div>

<!-- ===== STAT CARDS ===== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">TỔNG SINH VIÊN</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@Model.TotalItems</div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">Toàn hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">ĐANG HỌC</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@(ViewBag.SoDangHoc ?? Model.Items.Count(s => s.TrangThai == "Đang học"))</div>
                    <div style="font-size:.78rem; color:#16a34a; margin-top:2px; font-weight:600;">Đang theo học</div>
                </div>
                <div class="stat-icon-wrap green"><i class="bi bi-mortarboard"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">ĐÃ XẾP LỚP</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@Model.Items.Count(s => s.LopId != null)</div>
                    <div style="font-size:.78rem; color:#64748b; margin-top:2px;">Có lớp hành chính</div>
                </div>
                <div class="stat-icon-wrap cyan"><i class="bi bi-collection"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="content-card p-3 h-100">
            <p style="font-size:.72rem; font-weight:700; letter-spacing:.07em; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">CHƯA XẾP LỚP</p>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div style="font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1.1;">@Model.Items.Count(s => s.LopId == null)</div>
                    <div style="font-size:.78rem; color:#d97706; margin-top:2px; font-weight:600;">Cần phân lớp</div>
                </div>
                <div class="stat-icon-wrap amber"><i class="bi bi-exclamation-circle"></i></div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success"></i>
        <div>@TempData["Msg"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-circle-fill text-danger"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ===== BỘ LỌC ===== -->
<div class="content-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-center filter-card-form">
        <!-- 1. Ô tìm kiếm -->
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text border-end-0 bg-white text-muted pe-2" style="border-color:#cbd5e1; height:40px; border-radius:10px 0 0 10px;">
                    <i class="bi bi-search" style="font-size:.85rem; color:#64748b;"></i>
                </span>
                <input name="tuKhoa" value="@ViewBag.TuKhoa"
                       class="form-control border-start-0 ps-1"
                       style="border-color:#cbd5e1; font-size:.875rem; height:40px; border-radius:0 10px 10px 0;"
                       placeholder="Tìm theo tên, mã SV, lớp, email..." />
            </div>
        </div>

        <!-- 2. Lọc Khoa / Viện / Lớp -->
        <div class="col-12 col-sm-6 col-md-3">
            <select name="lopId" asp-items="ViewBag.DanhSachLop"
                    class="form-select" style="font-size:.875rem; border-color:#cbd5e1; height:40px; width:100%; border-radius:10px;">
                <option value="">-- Tất cả Khoa / Viện / Lớp --</option>
            </select>
        </div>

        <!-- 3. Lọc Trạng thái -->
        <div class="col-12 col-sm-6 col-md-3">
            <select name="trangThai" class="form-select" style="font-size:.875rem; border-color:#cbd5e1; height:40px; width:100%; border-radius:10px;">
                <option value="">-- Tất cả trạng thái --</option>
                @foreach (var trangThai in BTL_StudentMGMT.Models.SinhVien.TrangThaiOptions)
                {
                    <option value="@trangThai" selected="@(ViewBag.TrangThai == trangThai)">@trangThai</option>
                }
            </select>
        </div>

        <!-- 4. Thao tác (Lọc + Đặt lại) -->
        <div class="col-12 col-md-2">
            <div class="d-flex gap-2 w-100">
                <button type="submit" class="btn-filter-submit flex-grow-1" style="height:40px; border-radius:10px;">
                    <i class="bi bi-funnel-fill"></i> Lọc
                </button>
                <a asp-action="Index" class="btn-filter-reset" title="Đặt lại bộ lọc" style="height:40px; width:40px; min-width:40px; border-radius:10px;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.LastSearchTime as string))
        {
            <div class="col-12 mt-1">
                <div class="d-flex align-items-center gap-1 small text-muted" style="font-size: 0.78rem;">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Phiên lọc gần nhất: <strong>@ViewBag.LastSearchTime</strong></span>
                </div>
            </div>
        }
    </form>
</div>

<!-- ===== BẢNG DANH SÁCH SINH VIÊN ===== -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="min-width:180px;">SINH VIÊN</th>
                    <th style="white-space:nowrap;">MÃ SV</th>
                    <th style="white-space:nowrap;">NGÀY SINH</th>
                    <th class="text-center" style="white-space:nowrap;">GIỚI TÍNH</th>
                    <th style="min-width:130px;">KHOA / LỚP</th>
                    <th class="text-center" style="white-space:nowrap;">ĐIỂM GPA</th>
                    <th class="text-center" style="white-space:nowrap;">XẾP LOẠI</th>
                    <th class="text-center" style="white-space:nowrap;">TRẠNG THÁI</th>
                    <th class="text-end" style="white-space:nowrap; padding-right:1rem;">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 0; }
                @foreach (var s in Model.Items)
                {
                    var colorClass = avatarColors[idx % avatarColors.Length];
                    idx++;

                    var gpa      = s.Gpa;
                    string rank  = s.XepLoai ?? "Chưa xếp loại";
                    string rankClass = gpa == null
                        ? "badge-rank-chuadiem"
                        : (gpa >= 8.5 ? "badge-rank-gioi"
                          : (gpa >= 7.0 ? "badge-rank-kha" : "badge-rank-trungbinh"));

                    string status = string.IsNullOrEmpty(s.TrangThai) ? "-" : s.TrangThai;
                    string statusClass = status switch
                    {
                        "Đang học"   => "badge-status-danghoc",
                        "Tốt nghiệp" => "badge-status-totnghiep",
                        "Bảo lưu"    => "badge-status-baoluu",
                        _            => "badge-status-dinhchi"
                    };

                    <!-- Lấy chữ cái đầu tên -->
                    string initials = string.IsNullOrWhiteSpace(s.HoTen) ? "?" :
                        s.HoTen.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[0].ToString().ToUpperInvariant();

                    <tr>
                        <!-- SINH VIÊN (ẢNH + HỌ TÊN + EMAIL) -->
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-online-box flex-shrink-0" style="width:36px; height:36px;">
                                    @if (!string.IsNullOrEmpty(s.HinhAnh))
                                    {
                                        <img src="@s.HinhAnh" alt="@s.HoTen" class="avatar-round" style="width:36px; height:36px; border-radius:50%; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-round @colorClass"
                                             style="width:36px; height:36px; font-size:.85rem; font-weight:700;">
                                            @initials
                                        </div>
                                    }
                                    <span class="dot-online"></span>
                                </div>
                                <div class="min-w-0" style="line-height:1.3;">
                                    <div style="font-weight:700; color:#0f172a; font-size:.9rem;" class="text-truncate" title="@s.HoTen">
                                        @s.HoTen
                                    </div>
                                    <small style="color:#64748b; font-size:.8rem; display:block;" class="text-truncate" title="@(s.Email ?? "Chưa có email")">
                                        @(s.Email ?? "Chưa có email")
                                    </small>
                                </div>
                            </div>
                        </td>

                        <!-- MÃ SV -->
                        <td style="white-space:nowrap;">
                            <span style="font-weight:700; color:#2563eb; font-size:.875rem;">@s.MaSinhVien</span>
                        </td>

                        <!-- NGÀY SINH -->
                        <td style="color:#475569; font-size:.875rem; white-space:nowrap;">
                            @(s.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")
                        </td>

                        <!-- GIỚI TÍNH -->
                        <td class="text-center" style="white-space:nowrap;">
                            @if (s.GioiTinh == "Nữ")
                            {
                                <span class="badge-gender-nu" style="font-size:.78rem; padding:3px 9px;">
                                    <i class="bi bi-gender-female" style="font-size:.75rem;"></i> Nữ
                                </span>
                            }
                            else if (s.GioiTinh == "Nam")
                            {
                                <span class="badge-gender-nam" style="font-size:.78rem; padding:3px 9px;">
                                    <i class="bi bi-gender-male" style="font-size:.75rem;"></i> Nam
                                </span>
                            }
                            else
                            {
                                <span style="color:#94a3b8; font-size:.9rem;">—</span>
                            }
                        </td>

                        <!-- KHOA / LỚP -->
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <span class="badge" style="background:#e0e7ff; color:#4338ca; font-weight:700; font-size:.78rem; padding:3px 8px; border-radius:4px;">
                                    @(s.Lop?.TenLop ?? "Chưa xếp lớp")
                                </span>
                            </div>
                            <div class="text-truncate" style="max-width:145px; color:#64748b; font-size:.78rem; margin-top:2px;" title="@(s.Lop?.Nganh?.TenNganh ?? "Chưa có ngành")">
                                @(s.Lop?.Nganh?.TenNganh ?? "Chưa có ngành")
                            </div>
                        </td>

                        <!-- ĐIỂM GPA -->
                        <td class="text-center" style="white-space:nowrap;">
                            @if (gpa == null)
                            {
                                <span style="color:#94a3b8; font-size:.9rem;">—</span>
                            }
                            else
                            {
                                <span style="font-weight:800; color:#1e40af; font-size:.95rem;">
                                    @gpa.Value.ToString("0.00")
                                </span>
                            }
                        </td>

                        <!-- XẾP LOẠI -->
                        <td class="text-center" style="white-space:nowrap;">
                            @if (gpa == null)
                            {
                                <span style="color:#94a3b8; font-size:.9rem;">—</span>
                            }
                            else
                            {
                                <span class="@rankClass" style="font-size:.78rem; padding:3px 9px;">@rank</span>
                            }
                        </td>

                        <!-- TRẠNG THÁI -->
                        <td class="text-center" style="white-space:nowrap;">
                            <span class="@statusClass" style="font-size:.78rem; padding:3px 9px;">
                                <span class="sv-status-dot"></span>
                                @status
                            </span>
                        </td>

                        <!-- HÀNH ĐỘNG -->
                        <td class="text-end text-nowrap" style="padding-right:1rem;">
                            <a asp-action="Details" asp-route-id="@s.Id"
                               class="icon-action-btn" title="Xem chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@s.Id"
                               class="icon-action-btn edit" title="Chỉnh sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên @Html.Raw(s.HoTen.Replace("'", "\\'"))?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-action-btn delete" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }

                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-inbox fs-2 d-block mb-2" style="color:#cbd5e1;"></i>
                            <span style="font-size:.9rem;">Không có sinh viên nào phù hợp với bộ lọc.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ===== FOOTER BẢNG: INFO + PHÂN TRANG ===== -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 px-3 py-2"
         style="border-top:1px solid #f1f5f9; background:#fafbfc;">

        <!-- Thông tin số dòng -->
        <div style="font-size:.82rem; color:#64748b;">
            Hiển thị
            <strong style="color:#1e293b;">@startRecord – @endRecord</strong>
            trên tổng số
            <strong style="color:#1e293b;">@Model.TotalItems.ToString("N0")</strong>
            sinh viên

            @if (Model.TotalPages > 1)
            {
                <span style="margin-left:14px; color:#94a3b8;">
                    | Số dòng mỗi trang:&nbsp;
                    <strong style="color:#475569;">@Model.PageSize</strong>
                </span>
            }
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang sinh viên">
                <ul class="pagination pagination-sm mb-0 gap-1">

                    <!-- Nút Trước -->
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link sv-page-btn"
                           asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-lopId="@ViewBag.LopId"
                           asp-route-trangThai="@ViewBag.TrangThai"
                           aria-label="Trang trước">&lsaquo; Trước</a>
                    </li>

                    @{
                        // Hiển thị tối đa 7 trang, với dấu "..."
                        int totalP  = Model.TotalPages;
                        int curP    = Model.Page;
                        var pages   = new List<int?>();

                        if (totalP <= 7)
                        {
                            for (int i = 1; i <= totalP; i++) pages.Add(i);
                        }
                        else
                        {
                            pages.Add(1);
                            if (curP > 3) pages.Add(null); // ellipsis
                            for (int i = Math.Max(2, curP - 1); i <= Math.Min(totalP - 1, curP + 1); i++)
                                pages.Add(i);
                            if (curP < totalP - 2) pages.Add(null); // ellipsis
                            pages.Add(totalP);
                        }
                    }

                    @foreach (var pg in pages)
                    {
                        if (pg == null)
                        {
                            <li class="page-item disabled">
                                <span class="page-link sv-page-btn" style="color:#94a3b8;">…</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item @(pg == curP ? "active" : "")">
                                <a class="page-link sv-page-btn @(pg == curP ? "sv-page-active" : "")"
                                   asp-action="Index" asp-route-page="@pg"
                                   asp-route-tuKhoa="@ViewBag.TuKhoa"
                                   asp-route-lopId="@ViewBag.LopId"
                                   asp-route-trangThai="@ViewBag.TrangThai">@pg</a>
                            </li>
                        }
                    }

                    <!-- Nút Sau -->
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link sv-page-btn"
                           asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-lopId="@ViewBag.LopId"
                           asp-route-trangThai="@ViewBag.TrangThai"
                           aria-label="Trang sau">Sau &rsaquo;</a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
<style>
    /* Bảng sinh viên chữ to rõ ràng, vừa vặn toàn màn hình, không bị tràn cuộn ngang */
    .custom-table {
        table-layout: auto;
        width: 100%;
    }
    .custom-table thead th {
        padding: 0.8rem 0.65rem !important;
        font-size: 0.78rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.05em;
        vertical-align: middle;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #475569;
    }
    .custom-table tbody td {
        padding: 0.75rem 0.65rem !important;
        font-size: 0.875rem !important;
        vertical-align: middle;
    }
    .custom-table tbody tr:hover {
        background-color: #f8fafc;
    }

    /* Icon action buttons gọn gàng và dễ bấm */
    .icon-action-btn {
        width: 30px;
        height: 30px;
        padding: 0;
        font-size: .9rem;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        background: transparent;
        border: none;
        transition: all .15s ease;
    }
    .icon-action-btn:hover { background: #f1f5f9; color: #1e293b; }
    .icon-action-btn.edit:hover { color: #2563eb; background: #eff6ff; }
    .icon-action-btn.delete:hover { color: #ef4444; background: #fef2f2; }

    /* Chấm trạng thái trong badge */
    .badge-status-danghoc,
    .badge-status-totnghiep,
    .badge-status-baoluu,
    .badge-status-dinhchi {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .sv-status-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .badge-status-danghoc  .sv-status-dot { background: #16a34a; }
    .badge-status-totnghiep .sv-status-dot { background: #7c3aed; }
    .badge-status-baoluu   .sv-status-dot { background: #d97706; }
    .badge-status-dinhchi  .sv-status-dot { background: #b91c1c; }

    /* Nút phân trang */
    .sv-page-btn {
        min-width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px !important;
        border: 1px solid #e2e8f0 !important;
        color: #374151 !important;
        font-size: .85rem;
        font-weight: 600;
        background: #fff;
        padding: 0 8px;
        transition: all .15s ease;
    }
    .sv-page-btn:hover    { background: #f1f5f9 !important; border-color: #cbd5e1 !important; }
    .sv-page-active       { background: #2563eb !important; color: #fff !important; border-color: #2563eb !important; }
    .page-item.disabled .sv-page-btn { color: #cbd5e1 !important; }

    /* Đảm bảo font admin dùng Plus Jakarta Sans */
    .admin-content { font-family: 'Plus Jakarta Sans', "Segoe UI", sans-serif; }
</style>

<!-- Modal nhập Excel -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-white">
                <h5 class="modal-title fw-bold" style="color:#0f172a;">Nhập sinh viên từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="ImportFromExcel" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <p class="text-muted small mb-3">Chọn file Excel (.xlsx, .xls) có các cột: Mã SV, Họ tên, Ngày sinh, Giới tính, Email, Số điện thoại, Địa chỉ, Tên lớp, Niên khóa, Trạng thái.</p>
                    <div class="mb-3">
                        <label class="form-label">Chọn file Excel</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Nhập dữ liệu</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
}
