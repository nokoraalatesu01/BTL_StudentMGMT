@model BTL_StudentMGMT.Models.SinhVienFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Chỉnh sửa thông tin sinh viên" : "Thêm mới hồ sơ sinh viên";
}

<!-- Breadcrumb Title -->
<div class="page-breadcrumb-title mb-3">
    Đào tạo / Sinh viên / <strong>@(isEdit ? "Chỉnh sửa hồ sơ" : "Thêm mới hồ sơ")</strong>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <!-- Header Card -->
            <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center bg-white">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2" style="font-size: 1.05rem;">
                    <i class="bi bi-person-plus-fill text-primary"></i>
                    Nhập Thông Tin Sinh Viên
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <!-- Form Content -->
            <div class="p-4">
                <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" class="row g-3">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <!-- MỤC 1: THÔNG TIN CÁ NHÂN & LIÊN HỆ -->
                    <div class="col-12">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-person-badge"></i>
                            1. Thông Tin Cá Nhân & Liên Hệ
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Mã sinh viên *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-upc-scan"></i>
                            </span>
                            <input asp-for="MaSinhVien" class="form-control border-start-0 ps-0" placeholder="VD: SV202401" />
                        </div>
                        <span asp-validation-for="MaSinhVien" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Họ và tên *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="HoTen" class="form-control border-start-0 ps-0" placeholder="Nhập họ và tên đầy đủ..." />
                        </div>
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Ngày sinh *</label>
                        <input asp-for="NgaySinh" class="form-control" type="date" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Giới tính *</label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option>Nam</option>
                            <option>Nữ</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Ảnh đại diện</label>
                        <input type="file" class="form-control" disabled title="Tùy chọn tải ảnh" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Địa chỉ email *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="example@student.edu.vn" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Số điện thoại *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-telephone"></i>
                            </span>
                            <input asp-for="SoDienThoai" class="form-control border-start-0 ps-0" placeholder="0987123456" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary">Quê quán / Địa chỉ *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-geo-alt"></i>
                            </span>
                            <input asp-for="DiaChi" class="form-control border-start-0 ps-0" placeholder="Địa chỉ thường trú hoặc quê quán..." />
                        </div>
                    </div>

                    <!-- MỤC 2: THÔNG TIN ĐÀO TẠO & ĐIỂM TÍCH LŨY -->
                    <div class="col-12 mt-4 pt-3 border-top">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-mortarboard"></i>
                            2. Thông Tin Đào Tạo & Điểm Tích Lũy
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary" for="KhoaHienThi">Khoa / Viện</label>
                        <input type="text" id="KhoaHienThi" class="form-control" readonly value="@ViewBag.KhoaHienTai" />
                        <small class="text-muted">Khoa được xác định tự động theo ngành của lớp sinh hoạt.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Lớp sinh hoạt *</label>
                        <select asp-for="LopId" asp-items="ViewBag.DanhSachLop" class="form-select">
                            <option value="">-- Chọn lớp sinh hoạt --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary" asp-for="NienKhoa"></label>
                        <input asp-for="NienKhoa" class="form-control" placeholder="VD: 2026" />
                        <span asp-validation-for="NienKhoa" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary" asp-for="TrangThai"></label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="">-- Chọn trạng thái --</option>
                            @foreach (var trangThai in BTL_StudentMGMT.Models.SinhVien.TrangThaiOptions)
                            {
                                <option value="@trangThai">@trangThai</option>
                            }
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary" asp-for="Gpa"></label>
                        <div class="input-group">
                            <input asp-for="Gpa" class="form-control border-end-0" type="number" step="0.01" min="0" max="10" readonly
                                   placeholder="—" />
                            <span class="input-group-text bg-light">@Model.XepLoai</span>
                        </div>
                        <small class="text-muted">GPA được tính tự động từ bảng điểm học phần, không nhập tay.</small>
                    </div>

                    <!-- Action buttons -->
                    <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end align-items-center gap-3">
                        <a asp-action="Index" class="text-decoration-none text-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 d-flex align-items-center gap-2"
                                style="background: #4f46e5; border-color: #4f46e5;">
                            <i class="bi bi-save"></i>
                            Lưu thông tin sinh viên
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var khoaTheoLop = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.KhoaTheoLop));
            var selectLop = document.getElementById('LopId');
            var inputKhoa = document.getElementById('KhoaHienThi');

            if (!selectLop || !inputKhoa) {
                return;
            }

            selectLop.addEventListener('change', function () {
                inputKhoa.value = khoaTheoLop[selectLop.value] || '';
            });
        })();
    </script>
}
