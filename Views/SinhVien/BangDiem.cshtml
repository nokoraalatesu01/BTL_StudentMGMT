@model BTL_StudentMGMT.Models.SinhVienDiemViewModel
@{
    ViewData["Title"] = "Bảng điểm & Lịch sử học tập";
    Layout = "_SinhVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.HoTen) ? "Sinh viên" : Model.HoTen.Trim();
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">KẾT QUẢ ĐÀO TẠO TÍN CHỈ</p>
        <h1>Bảng điểm & Kết quả học tập</h1>
        <p>Bảng điểm tích lũy chính thức ghi nhận số lần học, lần thi theo quy chế đào tạo tín chỉ.</p>
    </div>
    <a class="student-back-link" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về tổng quan</a>
</div>

<section class="student-stat-grid" aria-label="Tóm tắt kết quả học tập">
    <article class="student-stat-card stat-card-gpa">
        <span class="student-stat-icon student-icon-amber" aria-hidden="true"><i class="bi bi-award-fill"></i></span>
        <div>
            <p>GPA TÍCH LŨY</p>
            <div class="stat-gpa-container">
                <strong class="stat-value-gpa">
                    @(Model.Gpa.HasValue ? Model.Gpa.Value.ToString("0.00") : "—")
                </strong>
                <span class="stat-gpa-scale-label">/ 10</span>
                <span class="stat-gpa-he4-pill" title="Quy đổi thang điểm 4 chuẩn tín chỉ">
                    <i class="bi bi-star-fill"></i> Hệ 4: <strong>@(Model.GpaHe4.HasValue ? Model.GpaHe4.Value.ToString("0.00") : "—")</strong>
                </span>
            </div>
        </div>
    </article>
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-green" aria-hidden="true"><i class="bi bi-trophy"></i></span>
        <div>
            <p>XẾP LOẠI HỌC LỰC</p>
            <strong>@(Model.XepLoai ?? "Chưa xếp loại")</strong>
        </div>
    </article>
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-violet" aria-hidden="true"><i class="bi bi-journal-check"></i></span>
        <div>
            <p>TÍN CHỈ TÍCH LŨY / SỐ MÔN ĐẠT</p>
            <strong>@Model.TongTinChiDaDat TC <span class="stat-sub-tc">(@Model.SoMonDaDat/@Model.SoMon môn)</span></strong>
        </div>
    </article>
</section>

<!-- BẢNG ĐIỂM TÍCH LŨY CHÍNH THỨC -->
<section class="student-panel p-0 overflow-hidden mb-4">
    <div class="student-panel-heading p-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <p class="student-eyebrow mb-1">KẾT QUẢ TÍCH LŨY</p>
            <h2 class="m-0">Bảng điểm tích lũy chính thức (Dùng tính GPA)</h2>
        </div>
    </div>

    @if (Model.Diems.Count == 0)
    {
        <div class="p-4">
            <div class="student-notice">
                <strong>Chưa có điểm</strong>
                <p>Điểm học phần sẽ hiển thị ở đây ngay khi giảng viên ghi nhận vào bảng điểm.</p>
            </div>
        </div>
    }
    else
    {
        var tichLuyDiems = Model.Diems.Where(d => d.SuDungTinhTichLuy).OrderBy(d => d.MonHoc?.TenMon).ToList();
        <div class="student-table-wrap">
            <table class="student-table">
                <thead>
                    <tr>
                        <th>Mã HP</th>
                        <th>Tên học phần</th>
                        <th class="text-center">TC</th>
                        <th class="text-center">Lần học</th>
                        <th class="text-center">CC (10%)</th>
                        <th class="text-center">GK (30%)</th>
                        <th class="text-center">CK (60%)</th>
                        <th class="text-center">Tổng kết</th>
                        <th class="text-center">Điểm chữ</th>
                        <th class="text-center">Hệ 4</th>
                        <th class="text-center">Kết quả</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var diem in tichLuyDiems)
                    {
                        var isPass = diem.IsDat;
                        <tr>
                            <td><strong style="color: var(--blue-600);">@diem.MonHoc?.MaMon</strong></td>
                            <td>
                                <div>@diem.MonHoc?.TenMon</div>
                            </td>
                            <td class="text-center font-monospace">@(diem.MonHoc?.SoTinChi ?? 0)</td>
                            <td class="text-center font-monospace" style="color:#475569; font-weight:600;">@diem.LanHoc</td>
                            <td class="text-center">@diem.DiemChuyenCan.ToString("0.0")</td>
                            <td class="text-center">@diem.DiemGiuaKy.ToString("0.0")</td>
                            <td class="text-center">@diem.DiemCuoiKyApDung.ToString("0.0")</td>
                            <td class="text-center"><strong style="color: var(--blue-600);">@diem.DiemTongKet.ToString("0.0")</strong></td>
                            <td class="text-center"><span class="badge @(isPass ? "bg-primary" : "bg-danger")">@diem.DiemChu</span></td>
                            <td class="text-center font-monospace">@diem.DiemHe4.ToString("0.0")</td>
                            <td class="text-center">
                                @if (isPass)
                                {
                                    <span class="student-chip green">Đạt</span>
                                }
                                else
                                {
                                    <span class="student-chip red">Học lại</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
