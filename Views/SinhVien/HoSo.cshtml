@model BTL_StudentMGMT.Models.SinhVienPortalViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "_SinhVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.HoTen) ? "Sinh viên" : Model.HoTen.Trim();
    var nameInitial = displayName[0].ToString().ToUpperInvariant();
}

<div class="student-page-heading">
    <div>
        <p class="student-eyebrow">TÀI KHOẢN SINH VIÊN</p>
        <h1>Hồ sơ của tôi</h1>
        <p>Thông tin cá nhân và đào tạo được ghi nhận trong hệ thống.</p>
    </div>
    <a class="student-back-link" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về tổng quan</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<section class="student-panel profile-panel">
    <div class="profile-banner">
        <div class="student-avatar-wrapper position-relative">
            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <img src="@Model.HinhAnh" alt="@displayName" class="student-avatar large object-fit-cover shadow-sm" />
            }
            else
            {
                <div class="student-avatar large" aria-hidden="true">@nameInitial</div>
            }
            <form asp-action="CapNhatAnhDaiDien" method="post" enctype="multipart/form-data" id="avatarUploadForm" class="avatar-upload-form">
                @Html.AntiForgeryToken()
                <label for="fileAnhInput" class="avatar-change-btn" title="Thay đổi ảnh đại diện">
                    <i class="bi bi-camera-fill"></i>
                </label>
                <input type="file" id="fileAnhInput" name="fileAnh" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="document.getElementById('avatarUploadForm').submit();" />
            </form>
        </div>
        <div>
            <h2>@displayName</h2>
            <p>Mã sinh viên: <strong>@Model.MaSinhVien</strong></p>
            <label for="fileAnhInput" class="btn btn-sm btn-outline-primary mt-1" style="cursor:pointer; font-size:.78rem; font-weight:600; border-radius:6px;">
                <i class="bi bi-upload"></i> Đổi ảnh thẻ / avatar
            </label>
        </div>
    </div>

    <div class="profile-section">
        <h3>Thông tin cá nhân</h3>
        <dl class="student-info-list">
            <div>
                <dt>Tài khoản đăng nhập</dt>
                <dd>@Model.UserName</dd>
            </div>
            <div>
                <dt>Ngày sinh</dt>
                <dd>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Giới tính</dt>
                <dd>@(Model.GioiTinh ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(Model.Email ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Số điện thoại</dt>
                <dd>@(Model.SoDienThoai ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Địa chỉ</dt>
                <dd>@(Model.DiaChi ?? "Chưa cập nhật")</dd>
            </div>
        </dl>
    </div>

    <div class="profile-section">
        <h3>Thông tin đào tạo</h3>
        <dl class="student-info-list">
            <div>
                <dt>Lớp</dt>
                <dd>@(Model.TenLop ?? "Chưa xếp lớp")</dd>
            </div>
            <div>
                <dt>Ngành</dt>
                <dd>@(Model.TenNganh ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Mã ngành</dt>
                <dd>@(Model.MaNganh ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Khoa</dt>
                <dd>@(Model.TenKhoa ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Khóa / Năm nhập học</dt>
                <dd>@(Model.NienKhoa ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Trạng thái học tập</dt>
                <dd>@(Model.TrangThai ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>GPA (Hệ 10)</dt>
                <dd>@(Model.Gpa.HasValue ? Model.Gpa.Value.ToString("0.00") : "Chưa có điểm")</dd>
            </div>
            <div>
                <dt>Xếp loại</dt>
                <dd>@(Model.XepLoai ?? "Chưa có điểm")</dd>
            </div>
        </dl>
    </div>

    <p class="student-data-note">
        Cần điều chỉnh hồ sơ? Vui lòng liên hệ bộ phận quản lý sinh viên để được hỗ trợ.
    </p>
</section>
