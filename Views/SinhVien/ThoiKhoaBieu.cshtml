@model List<BTL_StudentMGMT.Models.ThoiKhoaBieuItemViewModel>
@{
    ViewData["Title"] = "Thời khóa biểu của tôi";
    Layout = "_SinhVienLayout";
    var sinhVien = ViewBag.SinhVien as BTL_StudentMGMT.Models.SinhVien;
    var cacThu = new[] { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7" };
}

<!-- ===== HEADER ===== -->
<div class="mb-4">
    <p class="mb-1" style="font-size:.8rem; color:#64748b;">
        <span style="color:#94a3b8;">CỔNG THÔNG TIN SINH VIÊN</span>
        <span style="color:#cbd5e1; margin:0 6px;">/</span>
        <span style="color:#2563eb; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.07em;">THỜI KHÓA BIỂU</span>
    </p>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
                Thời khóa biểu tuần
            </h3>
            <p class="mb-0" style="font-size:.875rem; color:#64748b;">
                Lịch học các lớp học phần đã đăng ký của sinh viên <strong class="text-dark">@(sinhVien?.HoTen)</strong> (Mã SV: <strong class="text-primary font-monospace">@(sinhVien?.MaSinhVien)</strong>).
            </p>
        </div>
        <a asp-action="DangKyHocPhan" class="btn btn-outline-primary fw-semibold" style="border-radius:8px;">
            <i class="bi bi-pencil-square me-1"></i> Đăng ký thêm môn
        </a>
    </div>
</div>

<div class="row g-4">
    @foreach (var thu in cacThu)
    {
        var monTrongNgay = Model.Where(m => m.Thu == thu).OrderBy(m => m.TietBatDau).ToList();
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:#fff; border-top: 4px solid @(monTrongNgay.Count > 0 ? "#2563eb" : "#cbd5e1") !important;">
                <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0" style="color:#0f172a; font-size:1.1rem;">
                        <i class="bi bi-calendar-event me-2 text-primary"></i>@thu
                    </h5>
                    <span class="badge @(monTrongNgay.Count > 0 ? "bg-primary-subtle text-primary" : "bg-light text-muted") px-2 py-1">
                        @monTrongNgay.Count lớp
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (monTrongNgay.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-cup-hot fs-3 d-block mb-1 text-secondary opacity-50"></i>
                            Không có lịch học
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var mon in monTrongNgay)
                            {
                                <div class="p-3 rounded-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="badge bg-primary text-white font-monospace" style="font-size:.75rem;">
                                            @mon.MaLopHocPhan
                                        </span>
                                        <span class="badge bg-light text-dark border" style="font-size:.72rem;">
                                            @mon.SoTinChi TC
                                        </span>
                                    </div>
                                    <div class="fw-bold text-dark mb-1" style="font-size:.9rem;">
                                        @mon.TenMon
                                    </div>
                                    <div class="text-primary fw-semibold small mb-1">
                                        <i class="bi bi-clock me-1"></i>Tiết @mon.TietBatDau - @mon.TietKetThuc (@mon.SoTiet tiết)
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i>Phòng: <strong class="text-dark">@mon.PhongHoc</strong>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-person me-1"></i>GV: @mon.GiangVien
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
