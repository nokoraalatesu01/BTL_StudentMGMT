@model BTL_StudentMGMT.Models.SinhVienDangKyHocPhanViewModel
@{
    ViewData["Title"] = "Đăng ký học phần";
    Layout = "_SinhVienLayout";
}

<!-- ===== HEADER ===== -->
<div class="mb-4">
    <p class="mb-1" style="font-size:.8rem; color:#64748b;">
        <span style="color:#94a3b8;">CỔNG THÔNG TIN SINH VIÊN</span>
        <span style="color:#cbd5e1; margin:0 6px;">/</span>
        <span style="color:#2563eb; font-weight:700; text-transform:uppercase; font-size:.72rem; letter-spacing:.07em;">ĐÀO TẠO TÍN CHỈ</span>
    </p>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color:#0f172a; font-size:1.55rem; letter-spacing:-.02em;">
                Đăng ký học phần
            </h3>
            <p class="mb-0" style="font-size:.875rem; color:#64748b;">
                Sinh viên tự do đăng ký các lớp học phần mở trong học kỳ theo kế hoạch học tập cá nhân.
            </p>
        </div>
        <div class="d-flex align-items-center gap-3 bg-white px-3 py-2 rounded-3 shadow-sm border">
            <div>
                <span class="text-muted small d-block">TỔNG TÍN CHỈ ĐÃ ĐĂNG KÝ</span>
                <span class="fw-bold text-primary fs-5">@Model.TongTinChiDaDangKy <span class="fs-6 text-muted fw-normal">tín chỉ</span></span>
            </div>
            <a asp-action="ThoiKhoaBieu" class="btn btn-sm btn-outline-primary fw-semibold ms-2" style="border-radius:8px;">
                <i class="bi bi-calendar3 me-1"></i> Xem Thời khóa biểu
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 1. HỌC PHẦN ĐÃ ĐĂNG KÝ -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background:#fff; overflow:hidden;">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0" style="font-size:1.05rem; color:#0f172a;">
            <i class="bi bi-check2-circle me-2 text-success"></i>Học phần đã đăng ký thành công (@Model.LopHocPhanDaDangKy.Count lớp - @Model.TongTinChiDaDangKy tín chỉ)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size:.875rem;">
            <thead style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                <tr style="color:#475569; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">
                    <th class="ps-4 py-3">Mã LHP</th>
                    <th class="py-3">Tên môn học & Lớp học phần</th>
                    <th class="py-3 text-center">Số TC</th>
                    <th class="py-3">Giảng viên</th>
                    <th class="py-3">Lịch học</th>
                    <th class="py-3">Phòng</th>
                    <th class="py-3">Ngày đăng ký</th>
                    <th class="pe-4 py-3 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LopHocPhanDaDangKy.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Bạn chưa đăng ký lớp học phần nào trong học kỳ này. Hãy chọn lớp ở danh sách bên dưới để đăng ký.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.LopHocPhanDaDangKy)
                {
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td class="ps-4 py-3 fw-bold font-monospace text-primary">@item.MaLopHocPhan</td>
                        <td class="py-3">
                            <div class="fw-semibold text-dark">@item.TenMon</div>
                            <div class="text-muted small">@item.TenLopHocPhan</div>
                        </td>
                        <td class="py-3 text-center fw-bold text-dark">@item.SoTinChi</td>
                        <td class="py-3 text-muted">@(item.TenGiangVien ?? "Chưa phân công")</td>
                        <td class="py-3 fw-semibold text-primary">@item.LichHoc</td>
                        <td class="py-3">@item.PhongHoc</td>
                        <td class="py-3 text-muted small">@item.NgayDangKy?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="pe-4 py-3 text-end">
                            <form asp-action="HuyDangKy" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy đăng ký lớp học phần này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lopHocPhanId" value="@item.LopHocPhanId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:6px;">
                                    <i class="bi bi-x-circle me-1"></i> Hủy môn
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 2. DANH SÁCH LỚP HỌC PHẦN ĐANG MỞ -->
<div class="card border-0 shadow-sm rounded-4" style="background:#fff; overflow:hidden;">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0" style="font-size:1.05rem; color:#0f172a;">
            <i class="bi bi-list-stars me-2 text-primary"></i>Danh sách lớp học phần đang mở đăng ký
        </h5>
        <span class="text-muted small">Sinh viên các ngành, các lớp hành chính đều có thể đăng ký các lớp mở</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size:.875rem;">
            <thead style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                <tr style="color:#475569; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">
                    <th class="ps-4 py-3">Mã LHP</th>
                    <th class="py-3">Môn học</th>
                    <th class="py-3 text-center">Số TC</th>
                    <th class="py-3">Giảng viên</th>
                    <th class="py-3">Thời khóa biểu</th>
                    <th class="py-3">Phòng</th>
                    <th class="py-3 text-center">Sĩ số</th>
                    <th class="pe-4 py-3 text-end">Đăng ký</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LopHocPhansMo.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Hiện không có lớp học phần nào đang mở đăng ký.
                        </td>
                    </tr>
                }
                @foreach (var lhp in Model.LopHocPhansMo)
                {
                    var isFull = lhp.SiSoHienTai >= lhp.SiSoToiDa;
                    <tr style="border-bottom:1px solid #f1f5f9; @(lhp.DaDangKy ? "background:#f0fdf4;" : "")">
                        <td class="ps-4 py-3">
                            <span class="badge px-2 py-1 fw-bold font-monospace" style="background:#eff6ff; color:#2563eb; font-size:.82rem; border-radius:6px;">
                                @lhp.MaLopHocPhan
                            </span>
                        </td>
                        <td class="py-3">
                            <div class="fw-bold" style="color:#0f172a;">@lhp.TenMon</div>
                            <div class="text-muted small">@lhp.TenLopHocPhan</div>
                        </td>
                        <td class="py-3 text-center fw-bold">@lhp.SoTinChi</td>
                        <td class="py-3" style="color:#334155;">
                            <i class="bi bi-person me-1 text-primary"></i>@(lhp.TenGiangVien ?? "Chưa phân công")
                        </td>
                        <td class="py-3 fw-semibold text-primary">
                            <i class="bi bi-calendar3 me-1"></i>@lhp.LichHoc
                        </td>
                        <td class="py-3">@lhp.PhongHoc</td>
                        <td class="py-3 text-center">
                            <span class="badge @(isFull ? "bg-danger" : "bg-light text-dark border") px-2 py-1">
                                @lhp.SiSoHienTai / @lhp.SiSoToiDa
                            </span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            @if (lhp.DaDangKy)
                            {
                                <span class="badge bg-success px-3 py-2" style="border-radius:6px;">
                                    <i class="bi bi-check-lg me-1"></i> Đã đăng ký
                                </span>
                            }
                            else if (isFull)
                            {
                                <button class="btn btn-sm btn-secondary disabled" style="border-radius:6px;">
                                    Hết chỗ
                                </button>
                            }
                            else
                            {
                                <form asp-action="XacNhanDangKy" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="lopHocPhanId" value="@lhp.LopHocPhanId" />
                                    <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold" style="border-radius:6px;">
                                        <i class="bi bi-plus-lg me-1"></i> Đăng ký
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
