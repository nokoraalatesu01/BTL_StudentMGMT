@model BTL_StudentMGMT.Models.SinhVienPortalViewModel
@{
    ViewData["Title"] = "Cổng thông tin Sinh viên";
}

<div class="row g-4">
    <!-- Hero Banner Sinh viên -->
    <div class="col-12">
        <div class="hero-banner d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow-lg"
                     style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div>
                    <span class="badge bg-white bg-opacity-25 text-white mb-1 px-3 py-1 rounded-pill">
                        <i class="bi bi-person-check-fill"></i> Sinh viên chính quy
                    </span>
                    <h2 class="fw-bold mb-1 text-white">Xin chào, @User.Identity?.Name!</h2>
                    <p class="text-white-50 mb-0">Cổng tra cứu hồ sơ học tập và thông tin đào tạo cá nhân</p>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>

    <!-- Card hồ sơ sinh viên -->
    <div class="col-md-6">
        <div class="modern-card hover-card p-4 h-100">
            <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary"></i>
                Hồ sơ sinh viên
            </h5>
            <p class="text-muted small mb-3">Thông tin định danh và tài khoản sinh viên đã được xác thực trên hệ thống.</p>
            <div class="p-3 rounded-3 bg-light d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted">Mã sinh viên:</span>
                <span class="fw-bold text-primary">@User.Identity?.Name</span>
            </div>
            <div class="p-3 rounded-3 bg-light d-flex justify-content-between align-items-center">
                <span class="text-muted">Tình trạng học tập:</span>
                <span class="badge badge-soft-success">Đang theo học</span>
            </div>
        </div>
    </div>

    <!-- Thông báo học vụ -->
    <div class="col-md-6">
        <div class="modern-card hover-card p-4 h-100">
            <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-bell-fill text-warning"></i>
                Thông báo đào tạo
            </h5>
            <p class="text-muted small mb-0">
                Chào mừng bạn đến với học kỳ mới! Vui lòng theo dõi lịch sinh hoạt lớp và cập nhật thông tin cá nhân khi có thay đổi.
            </p>
        </div>
    </div>
</div>
    ViewData["Title"] = "Tổng quan sinh viên";
    Layout = "_SinhVienLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.HoTen) ? "Sinh viên" : Model.HoTen.Trim();
    var nameInitial = displayName[0].ToString().ToUpperInvariant();
}

<section class="student-welcome">
    <div>
        <p class="student-eyebrow">CỔNG THÔNG TIN SINH VIÊN</p>
        <h1>Xin chào, @displayName</h1>
        <p>Đây là trang tổng quan hồ sơ học tập của bạn.</p>
    </div>
    <div class="student-avatar" aria-hidden="true">@nameInitial</div>
</section>

<section class="student-stat-grid" aria-label="Thông tin học tập">
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-blue" aria-hidden="true">SV</span>
        <div>
            <p>Mã sinh viên</p>
            <strong>@Model.MaSinhVien</strong>
        </div>
    </article>
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-green" aria-hidden="true">L</span>
        <div>
            <p>Lớp hành chính</p>
            <strong>@(Model.TenLop ?? "Chưa xếp lớp")</strong>
        </div>
    </article>
    <article class="student-stat-card">
        <span class="student-stat-icon student-icon-violet" aria-hidden="true">N</span>
        <div>
            <p>Ngành đào tạo</p>
            <strong>@(Model.TenNganh ?? "Chưa xác định")</strong>
        </div>
    </article>
</section>

<div class="student-content-grid">
    <section class="student-panel">
        <div class="student-panel-heading">
            <div>
                <p class="student-eyebrow">HỒ SƠ CÁ NHÂN</p>
                <h2>Thông tin của tôi</h2>
            </div>
            <a class="student-text-link" asp-action="HoSo">Xem đầy đủ <span aria-hidden="true">→</span></a>
        </div>

        <dl class="student-info-list">
            <div>
                <dt>Họ và tên</dt>
                <dd>@Model.HoTen</dd>
            </div>
            <div>
                <dt>Mã sinh viên</dt>
                <dd>@Model.MaSinhVien</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(Model.Email ?? "Chưa cập nhật")</dd>
            </div>
            <div>
                <dt>Số điện thoại</dt>
                <dd>@(Model.SoDienThoai ?? "Chưa cập nhật")</dd>
            </div>
        </dl>
    </section>

    <section class="student-panel class-panel">
        <div class="student-panel-heading">
            <div>
                <p class="student-eyebrow">THÔNG TIN ĐÀO TẠO</p>
                <h2>Lớp và ngành</h2>
            </div>
            <span class="student-cap-icon" aria-hidden="true">✦</span>
        </div>

        @if (Model.TenLop == null)
        {
            <div class="student-notice">
                <strong>Bạn chưa được xếp lớp</strong>
                <p>Thông tin lớp và ngành sẽ được hiển thị sau khi nhà trường cập nhật hồ sơ.</p>
            </div>
        }
        else
        {
            <dl class="student-info-list compact">
                <div>
                    <dt>Lớp</dt>
                    <dd>@Model.TenLop</dd>
                </div>
                <div>
                    <dt>Ngành</dt>
                    <dd>@(Model.TenNganh ?? "Chưa cập nhật")</dd>
                </div>
                <div>
                    <dt>Mã ngành</dt>
                    <dd>@(Model.MaNganh ?? "Chưa cập nhật")</dd>
                </div>
                <div>
                    <dt>Khoa</dt>
                    <dd>@(Model.TenKhoa ?? "Chưa cập nhật")</dd>
                </div>
                <div>
                    <dt>Sĩ số lớp</dt>
                    <dd>@(Model.SiSoLop?.ToString() ?? "Chưa có dữ liệu")</dd>
                </div>
            </dl>
        }
    </section>
</div>

<p class="student-data-note">
    Dữ liệu trên trang được lấy từ hồ sơ hiện tại trong hệ thống. Nếu có thông tin chưa chính xác,
    vui lòng liên hệ bộ phận quản lý sinh viên.
</p>
