@model BTL_StudentMGMT.Models.AdminPaymentDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Quản lý thanh toán";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-3 py-2 payment-dashboard-wrap">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 payment-header-anim">
        <div class="d-flex align-items-center gap-3">
            <div class="payment-header-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <h2 class="payment-header-title mb-0">
                    Quản lý thanh toán học phí
                </h2>
                <div class="payment-header-subtitle">
                    Hệ thống theo dõi và đối soát tự động VietQR &bull; Ngân hàng TMCP Ngoại thương Việt Nam (Vietcombank)
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ThemKhoanThu" class="btn btn-filter-submit px-3" style="background: linear-gradient(135deg, #008744, #006030); box-shadow: 0 4px 12px rgba(0, 135, 68, 0.25);">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Tạo khoản thu mới</span>
            </a>
            <a asp-action="XuatExcelGiaoDich" class="btn btn-filter-reset w-auto px-3">
                <i class="bi bi-file-earmark-excel text-success me-1"></i>
                <span>Xuất Excel</span>
            </a>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <partial name="_NavTabs" />

    <!-- ===== BỘ LỌC TỔNG HỢP ===== -->
    <div class="payment-filter-card">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Năm học</label>
                <select name="namHocId" class="form-select form-select-sm filter-select">
                    <option value="">-- Tất cả năm --</option>
                    @foreach (var nh in Model.DanhSachNamHoc)
                    {
                        <option value="@nh.NamHocId" selected="@(Model.SelectedNamHocId == nh.NamHocId)">@nh.MaNamHoc</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Học kỳ</label>
                <select name="hocKyId" class="form-select form-select-sm filter-select">
                    <option value="">-- Tất cả kỳ --</option>
                    @foreach (var hk in Model.DanhSachHocKy)
                    {
                        <option value="@hk.HocKyId" selected="@(Model.SelectedHocKyId == hk.HocKyId)">@hk.TenHocKy</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Lớp</label>
                <select name="lopId" class="form-select form-select-sm filter-select">
                    <option value="">-- Tất cả lớp --</option>
                    @foreach (var l in Model.DanhSachLop)
                    {
                        <option value="@l.Id" selected="@(Model.SelectedLopId == l.Id)">@l.TenLop</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Ngành</label>
                <select name="nganhId" class="form-select form-select-sm filter-select">
                    <option value="">-- Tất cả ngành --</option>
                    @foreach (var ng in Model.DanhSachNganh)
                    {
                        <option value="@ng.Id" selected="@(Model.SelectedNganhId == ng.Id)">@ng.TenNganh</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Từ ngày</label>
                <input type="date" name="tuNgay" value="@Model.SelectedTuNgay" class="form-control form-control-sm filter-select" />
            </div>
            <div class="col-6 col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-filter-submit flex-grow-1">
                        <i class="bi bi-funnel-fill"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn-filter-reset" title="Xóa lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- ===== 6 THẺ THỐNG KÊ (STATISTIC CARDS WITH PASTEL THEME & ANIMATED COUNT-UP) ===== -->
    <div class="row g-3 mb-4">
        <!-- 1. Tổng học phí phải thu -->
        <div class="col-sm-6 col-xl-2">
            <div class="payment-stat-card card-blue">
                <div class="stat-header">
                    <span class="stat-label">TỔNG PHẢI THU</span>
                    <div class="stat-badge-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value text-primary" data-counter-target="@Model.TongHocPhiPhaiThu" data-is-currency="true">
                        @Model.TongHocPhiPhaiThu.ToString("N0") ₫
                    </div>
                    <div class="stat-hint">
                        <span>Định mức học phần</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Tổng tiền đã thu -->
        <div class="col-sm-6 col-xl-2">
            <div class="payment-stat-card card-emerald">
                <div class="stat-header">
                    <span class="stat-label text-success">TIỀN ĐÃ THU</span>
                    <div class="stat-badge-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value text-success" data-counter-target="@Model.TongTienDaThu" data-is-currency="true">
                        @Model.TongTienDaThu.ToString("N0") ₫
                    </div>
                    <div class="stat-hint text-success">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Đạt @(Model.TongHocPhiPhaiThu > 0 ? (Model.TongTienDaThu / Model.TongHocPhiPhaiThu * 100).ToString("N1") : "0")% kế hoạch</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Tổng tiền chưa thu -->
        <div class="col-sm-6 col-xl-2">
            <div class="payment-stat-card card-rose">
                <div class="stat-header">
                    <span class="stat-label text-danger">CÒN PHẢI THU</span>
                    <div class="stat-badge-icon">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value text-danger" data-counter-target="@Model.TongTienChuaThu" data-is-currency="true">
                        @Model.TongTienChuaThu.ToString("N0") ₫
                    </div>
                    <div class="stat-hint text-danger">
                        <span>Công nợ chưa nộp</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Giao dịch thành công -->
        <div class="col-sm-6 col-xl-2">
            <div class="payment-stat-card card-cyan">
                <div class="stat-header">
                    <span class="stat-label text-info">GD THÀNH CÔNG</span>
                    <div class="stat-badge-icon">
                        <i class="bi bi-shield-fill-check"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value text-dark" data-counter-target="@Model.SoGiaoDichThanhCong" data-is-currency="false">
                        @Model.SoGiaoDichThanhCong
                    </div>
                    <div class="stat-hint text-success">
                        <i class="bi bi-patch-check-fill"></i>
                        <span>Đã khớp tiền</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Giao dịch đang chờ -->
        <div class="col-sm-6 col-xl-2">
            <div class="payment-stat-card card-amber">
                <div class="stat-header">
                    <span class="stat-label text-warning-emphasis">GD ĐANG CHỜ</span>
                    <div class="stat-badge-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value text-dark" data-counter-target="@Model.SoGiaoDichDangCho" data-is-currency="false">
                        @Model.SoGiaoDichDangCho
                    </div>
                    <div class="stat-hint text-warning-emphasis">
                        <i class="bi bi-qr-code"></i>
                        <span>Chờ quét VietQR</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Giao dịch thất bại -->
        <div class="col-sm-6 col-xl-2">
            <div class="payment-stat-card card-purple">
                <div class="stat-header">
                    <span class="stat-label">GD THẤT BẠI</span>
                    <div class="stat-badge-icon">
                        <i class="bi bi-x-octagon"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-value text-dark" data-counter-target="@Model.SoGiaoDichThatBai" data-is-currency="false">
                        @Model.SoGiaoDichThatBai
                    </div>
                    <div class="stat-hint text-muted">
                        <i class="bi bi-clock"></i>
                        <span>Hết hạn / Đã hủy</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== 4 BIỂU ĐỒ TRỰC QUAN (CHARTS) ===== -->
    <div class="row g-3 mb-4">
        <!-- Biểu đồ 1: Doanh thu theo tháng -->
        <div class="col-lg-7">
            <div class="payment-card h-100">
                <div class="payment-card-header">
                    <h6 class="payment-card-title">
                        <i class="bi bi-bar-chart-line-fill text-success"></i>
                        <span>Doanh thu thanh toán theo tháng</span>
                    </h6>
                    <span class="payment-pill pill-neutral">6 tháng gần nhất</span>
                </div>
                <div style="position:relative; height:260px;">
                    <canvas id="chartDoanhThuThang"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 2: Tỷ lệ thanh toán thành công -->
        <div class="col-lg-5">
            <div class="payment-card h-100">
                <div class="payment-card-header">
                    <h6 class="payment-card-title">
                        <i class="bi bi-pie-chart-fill text-primary"></i>
                        <span>Tỷ lệ trạng thái giao dịch</span>
                    </h6>
                    <span class="payment-pill pill-cyan">Tổng @Model.TongSoGiaoDich GD</span>
                </div>
                <div style="position:relative; height:260px;">
                    <canvas id="chartTyLeGiaoDich"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 3: Doanh thu theo học kỳ -->
        <div class="col-lg-6">
            <div class="payment-card h-100">
                <div class="payment-card-header">
                    <h6 class="payment-card-title">
                        <i class="bi bi-collection-fill text-info"></i>
                        <span>Doanh thu đã thu theo học kỳ</span>
                    </h6>
                    <span class="payment-pill pill-neutral">Dữ liệu SQL Server</span>
                </div>
                <div style="position:relative; height:240px;">
                    <canvas id="chartDoanhThuHocKy"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 4: Tỷ lệ hoàn thành theo lớp -->
        <div class="col-lg-6">
            <div class="payment-card h-100">
                <div class="payment-card-header">
                    <h6 class="payment-card-title">
                        <i class="bi bi-percent text-warning"></i>
                        <span>Tỷ lệ hoàn thành học phí theo lớp (%)</span>
                    </h6>
                    <span class="payment-pill pill-neutral">Mục tiêu 100%</span>
                </div>
                <div style="position:relative; height:240px;">
                    <canvas id="chartTyLeLop"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== GIAO DỊCH GẦN ĐÂY ===== -->
    <div class="payment-table-card">
        <div class="payment-card-header px-4 pt-3 pb-2 mb-0">
            <h6 class="payment-card-title">
                <i class="bi bi-clock-history text-primary"></i>
                <span>Giao dịch phát sinh gần nhất</span>
            </h6>
            <a asp-action="GiaoDich" class="btn btn-sm btn-outline-primary rounded-3 px-3 fw-semibold">
                Xem tất cả giao dịch &rarr;
            </a>
        </div>
        <div class="table-responsive">
            <table class="payment-table">
                <thead>
                    <tr>
                        <th>MÃ GIAO DỊCH</th>
                        <th>SINH VIÊN</th>
                        <th>KHOẢN THU</th>
                        <th>SỐ TIỀN</th>
                        <th>THỜI GIAN TẠO</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentPayments.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block text-secondary mb-2"></i>
                                Chưa có giao dịch phát sinh trong bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model.RecentPayments)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-dark">
                                @p.TransactionCode
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(p.SinhVien?.HoTen ?? "N/A")</div>
                                <div class="text-muted font-monospace small">@(p.SinhVien?.MaSinhVien) &bull; @(p.SinhVien?.Lop?.TenLop)</div>
                            </td>
                            <td class="text-secondary">@(p.HoaDonHocPhi?.TenKhoanThu ?? "Học phí học phần")</td>
                            <td class="fw-bold font-monospace text-success fs-6">
                                @p.Amount.ToString("N0") ₫
                            </td>
                            <td class="small text-muted">
                                @p.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @if (p.Status == "PAID")
                                {
                                    <span class="payment-pill pill-paid">Đã thanh toán</span>
                                }
                                else if (p.Status == "PENDING")
                                {
                                    <span class="payment-pill pill-pending">Chờ quét QR</span>
                                }
                                else
                                {
                                    <span class="payment-pill pill-failed">@p.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="ChiTietGiaoDich" asp-route-id="@p.Id" class="action-icon-btn btn-vcb" title="Chi tiết giao dịch">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="payment-pagination-bar">
            <span>Hiển thị @Model.RecentPayments.Count giao dịch mới nhất</span>
            <span>Cổng Vietcombank Napas 24/7 &bull; Real-time webhook</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-payment.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Font và màu chung cho Chart.js
            Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
            Chart.defaults.color = '#64748b';

            // 1. Biểu đồ Doanh thu theo tháng
            const ctxThang = document.getElementById('chartDoanhThuThang');
            if (ctxThang) {
                new Chart(ctxThang.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartThangLabels)),
                        datasets: [{
                            label: 'Số tiền thu (VNĐ)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartThangData)),
                            backgroundColor: '#008744',
                            borderRadius: 8,
                            barThickness: 28
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Doanh thu: ' + (context.raw || 0).toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                grid: { color: '#f1f5f9' },
                                ticks: {
                                    callback: function(val) { return (val / 1000000).toFixed(0) + ' Tr'; }
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // 2. Biểu đồ Tỷ lệ trạng thái giao dịch
            const ctxTyLe = document.getElementById('chartTyLeGiaoDich');
            if (ctxTyLe) {
                new Chart(ctxTyLe.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Thành công', 'Đang chờ', 'Thất bại/Hết hạn'],
                        datasets: [{
                            data: [@Model.ChartTyLePaid, @Model.ChartTyLePending, @Model.ChartTyLeFailed],
                            backgroundColor: ['#10b981', '#0ea5e9', '#ef4444'],
                            borderWidth: 3,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, padding: 16 }
                            }
                        }
                    }
                });
            }

            // 3. Biểu đồ Doanh thu theo học kỳ
            const ctxHk = document.getElementById('chartDoanhThuHocKy');
            if (ctxHk) {
                new Chart(ctxHk.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartHocKyLabels)),
                        datasets: [{
                            label: 'Doanh thu học kỳ (VNĐ)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartHocKyData)),
                            backgroundColor: '#1d4ed8',
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Doanh thu: ' + (context.raw || 0).toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                grid: { color: '#f1f5f9' },
                                ticks: {
                                    callback: function(val) { return (val / 1000000).toFixed(0) + ' Tr'; }
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // 4. Biểu đồ Tỷ lệ theo lớp
            const ctxLop = document.getElementById('chartTyLeLop');
            if (ctxLop) {
                new Chart(ctxLop.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLopLabels)),
                        datasets: [{
                            label: 'Tỷ lệ nộp (%)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLopTyLeData)),
                            backgroundColor: '#f59e0b',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                max: 100,
                                grid: { color: '#f1f5f9' },
                                ticks: { callback: function(val) { return val + '%'; } }
                            },
                            y: {
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Tỷ lệ nộp: ' + (context.raw || 0).toFixed(1) + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
