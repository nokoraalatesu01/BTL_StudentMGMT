@model BTL_StudentMGMT.Models.AdminChiTietGiaoDichViewModel
@{
    ViewData["Title"] = "Chi tiết giao dịch " + Model.Payment.TransactionCode;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var p = Model.Payment;
    var sv = p.SinhVien;
    var hd = p.HoaDonHocPhi;
    var bt = Model.BankTransaction;
}

<div class="container-fluid px-3 py-2 payment-dashboard-wrap">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 payment-header-anim">
        <div class="d-flex align-items-center gap-3">
            <div class="payment-header-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="payment-header-title mb-0">
                        Chi tiết giao dịch @p.TransactionCode
                    </h2>
                    @if (p.Status == "PAID")
                    {
                        <span class="payment-pill pill-paid">Đã thanh toán (Paid)</span>
                    }
                    else if (p.Status == "PENDING")
                    {
                        <span class="payment-pill pill-pending">Chờ thanh toán (Pending)</span>
                    }
                    else
                    {
                        <span class="payment-pill pill-failed">@p.Status</span>
                    }
                </div>
                <div class="payment-header-subtitle">
                    Khởi tạo: @p.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss") &bull; Cổng Vietcombank Napas 24/7
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="GiaoDich" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
            @if (p.Status == "PAID")
            {
                <button type="button" class="btn btn-filter-submit px-3" onclick="window.print()">
                    <i class="bi bi-printer-fill"></i>
                    <span>In phiếu thu</span>
                </button>
            }
        </div>
    </div>

    <!-- Navigation Tabs -->
    <partial name="_NavTabs" />

    <div class="row g-4 mb-4">
        <!-- Cột 1: Thông tin Sinh viên & Khoản thu -->
        <div class="col-lg-7">
            <!-- Box 1: Thông tin Sinh viên -->
            <div class="payment-card mb-3">
                <div class="payment-card-header">
                    <h6 class="payment-card-title text-primary">
                        <i class="bi bi-person-badge"></i>
                        <span>1. Thông tin sinh viên nộp học phí</span>
                    </h6>
                    <span class="payment-pill pill-neutral font-monospace">@(sv?.MaSinhVien ?? "N/A")</span>
                </div>
                <div class="row g-3" style="font-size:14px;">
                    <div class="col-sm-4 text-muted">Họ và tên:</div>
                    <div class="col-sm-8 fw-bold text-dark fs-6">@(sv?.HoTen ?? "N/A")</div>

                    <div class="col-sm-4 text-muted">Mã sinh viên:</div>
                    <div class="col-sm-8 font-monospace fw-bold text-primary">@(sv?.MaSinhVien ?? "N/A")</div>

                    <div class="col-sm-4 text-muted">Lớp học:</div>
                    <div class="col-sm-8 fw-semibold">@(sv?.Lop?.TenLop ?? "Chưa xếp lớp")</div>

                    <div class="col-sm-4 text-muted">Ngành & Khoa:</div>
                    <div class="col-sm-8">@(sv?.Lop?.Nganh?.TenNganh ?? "N/A") &bull; @(sv?.Lop?.Nganh?.TenKhoa ?? "N/A")</div>

                    <div class="col-sm-4 text-muted">Email sinh viên:</div>
                    <div class="col-sm-8 text-secondary">@(sv?.Email ?? "N/A")</div>
                </div>
            </div>

            <!-- Box 2: Thông tin Khoản thu & Học phí -->
            <div class="payment-card mb-3">
                <div class="payment-card-header">
                    <h6 class="payment-card-title text-success">
                        <i class="bi bi-journal-check"></i>
                        <span>2. Thông tin khoản thu học phí</span>
                    </h6>
                    <span class="payment-pill pill-neutral">Hóa đơn: @(hd?.SoHoaDon ?? "N/A")</span>
                </div>
                <div class="row g-3" style="font-size:14px;">
                    <div class="col-sm-4 text-muted">Tên khoản thu:</div>
                    <div class="col-sm-8 fw-bold text-dark">@(hd?.TenKhoanThu ?? "Học phí học phần")</div>

                    <div class="col-sm-4 text-muted">Học kỳ / Năm:</div>
                    <div class="col-sm-8">@(hd?.HocKy?.TenHocKy ?? "N/A") &bull; @(hd?.HocKy?.NamHoc?.MaNamHoc ?? "N/A")</div>

                    <div class="col-sm-4 text-muted">Tổng học phí:</div>
                    <div class="col-sm-8 fw-bold font-monospace text-dark fs-6">@(hd?.SoTien.ToString("N0") ?? "0") ₫</div>

                    <div class="col-sm-4 text-muted">Số tiền GD này:</div>
                    <div class="col-sm-8 fw-bold font-monospace text-success fs-5">@p.Amount.ToString("N0") ₫</div>

                    <div class="col-sm-4 text-muted">Nội dung CK:</div>
                    <div class="col-sm-8">
                        <span class="font-monospace text-danger bg-light px-2 py-1 rounded border">@p.PaymentContent</span>
                    </div>
                </div>
            </div>

            <!-- Box 3: Lịch sử kiểm toán (Audit Logs) -->
            <div class="payment-card">
                <div class="payment-card-header">
                    <h6 class="payment-card-title text-secondary">
                        <i class="bi bi-clock-history"></i>
                        <span>3. Nhật ký kiểm toán thanh toán (Audit Trail)</span>
                    </h6>
                </div>
                @if (Model.AuditLogs.Count == 0)
                {
                    <div class="text-muted small py-2">Chưa ghi nhận sự kiện kiểm toán cho giao dịch này.</div>
                }
                else
                {
                    <div class="list-group list-group-flush small">
                        @foreach (var log in Model.AuditLogs)
                        {
                            <div class="list-group-item px-0 py-2 border-bottom d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-semibold text-dark">@log.HanhDong: @log.LyDo</div>
                                    <div class="text-muted" style="font-size:12px;">Bởi: @log.NguoiThucHien</div>
                                </div>
                                <span class="badge bg-light text-muted border">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Cột 2: Thẻ Vietcombank VietQR Voucher Card & Đối soát -->
        <div class="col-lg-5">
            <!-- VIETCOMBANK VIETQR VOUCHER TICKET (Image 1 Theme) -->
            <div class="vcb-ticket-container mb-4">
                <div class="vcb-ticket-inner">
                    <div class="vcb-ticket-header">
                        <div class="vcb-ticket-logo">
                            <i class="bi bi-shield-fill-check"></i>
                            <span>Vietcombank</span>
                        </div>
                        <small class="text-muted" style="font-size:11px;">Mã QR nộp học phí tự động 24/7</small>
                    </div>

                    <div class="vcb-qr-frame">
                        @if (!string.IsNullOrWhiteSpace(p.QrUrl))
                        {
                            <img src="@p.QrUrl" alt="Vietcombank VietQR" class="vcb-qr-img" />
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-qr-code fs-1 d-block mb-2"></i>
                                <span>Chưa tạo mã QR</span>
                            </div>
                        }
                    </div>

                    <div class="vcb-ticket-badges">
                        <span class="vietqr-badge">VIET<span style="color:#0f172a;">QR</span></span>
                        <span class="napas-badge">napas 247</span>
                    </div>

                    <div class="vcb-perforation"></div>

                    <div class="vcb-account-info">
                        <div class="vcb-account-name">NGUYEN HUU HOANH</div>
                        <div class="vcb-account-no">1043572004</div>
                        <small class="text-muted d-block mt-1" style="font-size:11px;">Số tiền: @p.Amount.ToString("N0") VNĐ</small>
                    </div>
                </div>
            </div>

            <!-- Box Thông tin Đối soát Ngân hàng -->
            <div class="payment-card">
                <div class="payment-card-header">
                    <h6 class="payment-card-title text-info">
                        <i class="bi bi-bank"></i>
                        <span>Chi tiết hạch toán ngân hàng</span>
                    </h6>
                </div>
                <div class="row g-2" style="font-size:13.5px;">
                    <div class="col-5 text-muted">Mã FT Ngân hàng:</div>
                    <div class="col-7 font-monospace fw-bold text-dark">
                        @(string.IsNullOrWhiteSpace(p.BankTransactionId) ? "Chờ Webhook đối soát" : p.BankTransactionId)
                    </div>

                    <div class="col-5 text-muted">Kênh thụ hưởng:</div>
                    <div class="col-7 fw-semibold text-dark">Vietcombank (BIN: 970436)</div>

                    <div class="col-5 text-muted">Thời gian tiền vào:</div>
                    <div class="col-7">
                        @(p.PaidAt.HasValue ? p.PaidAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "Chưa ghi nhận")
                    </div>

                    <div class="col-5 text-muted">Xác nhận tự động:</div>
                    <div class="col-7">
                        @if (p.IsAutoVerified)
                        {
                            <span class="payment-pill pill-paid">Tự động qua Webhook</span>
                        }
                        else if (p.Status == "PAID")
                        {
                            <span class="payment-pill pill-cyan">Duyệt thủ công</span>
                        }
                        else
                        {
                            <span class="payment-pill pill-pending">Đang chờ tiền về</span>
                        }
                    </div>
                </div>

                @if (p.Status != "PAID")
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="alert alert-warning-subtle text-warning-emphasis small border rounded-3 p-2 mb-3">
                            <i class="bi bi-info-circle me-1"></i>Nếu sinh viên đã nộp tiền thực tế (tiền mặt / chuyển khoản), Admin có thể xác nhận thu tiền hoặc từ chối giao dịch này.
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <button type="button" class="btn btn-success w-100 rounded-3 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-1" data-bs-toggle="modal" data-bs-target="#modalXacNhanThuTien">
                                <i class="bi bi-check2-circle fs-5"></i>
                                <span>Xác nhận đã thu tiền</span>
                            </button>
                            <button type="button" class="btn btn-outline-danger w-100 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-1" data-bs-toggle="modal" data-bs-target="#modalTuChoiGiaoDich">
                                <i class="bi bi-x-circle"></i>
                                <span>Từ chối / Hủy giao dịch</span>
                            </button>
                            <a asp-action="DoiSoat" class="btn btn-outline-secondary w-100 rounded-3 small">
                                <i class="bi bi-arrow-repeat me-1"></i> Mở đối soát giao dịch này
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận thu tiền thủ công -->
<div class="modal fade" id="modalXacNhanThuTien" tabindex="-1" aria-labelledby="modalXacNhanLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalXacNhanLabel">
                    <i class="bi bi-check2-circle me-1"></i> Xác nhận đã thu tiền học phí
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="XacNhanGiaoDich" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@p.Id" />
                <div class="modal-body p-4">
                    <p class="mb-3 text-muted">
                        Bạn đang xác nhận giao dịch nộp học phí <strong>@p.TransactionCode</strong> của sinh viên <strong>@(sv?.HoTen)</strong> (Mã SV: <strong class="text-primary font-monospace">@(sv?.MaSinhVien)</strong>) với số tiền:
                    </p>
                    <div class="p-3 bg-light rounded-3 text-center mb-3 border">
                        <span class="text-muted small d-block">SỐ TIỀN THANH TOÁN:</span>
                        <strong class="fs-4 text-success font-monospace">@p.Amount.ToString("N0") VNĐ</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Lý do xác nhận thu tiền <span class="text-danger">*</span></label>
                        <input type="text" name="lyDo" class="form-control" required placeholder="VD: Sinh viên đã nộp tiền mặt tại phòng kế toán / Xác nhận sao kê VCB" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mã giao dịch ngân hàng / Số chứng từ (nếu có)</label>
                        <input type="text" name="maGiaoDichNganHang" class="form-control font-monospace" placeholder="VD: VCB.FT261103.9981" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success rounded-3 fw-bold px-3">
                        <i class="bi bi-check-lg me-1"></i> Đồng ý duyệt thu tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Từ chối giao dịch -->
<div class="modal fade" id="modalTuChoiGiaoDich" tabindex="-1" aria-labelledby="modalTuChoiLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalTuChoiLabel">
                    <i class="bi bi-x-circle me-1"></i> Từ chối / Hủy giao dịch thanh toán
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="TuChoiGiaoDich" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@p.Id" />
                <div class="modal-body p-4">
                    <p class="mb-3 text-muted">
                        Bạn có chắc chắn muốn từ chối hoặc hủy giao dịch <strong>@p.TransactionCode</strong> của sinh viên <strong>@(sv?.HoTen)</strong>?
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Lý do từ chối <span class="text-danger">*</span></label>
                        <textarea name="lyDo" rows="3" class="form-control" required placeholder="VD: Sinh viên tạo nhầm đơn / Hết hạn thanh toán / Số tiền không khớp"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger rounded-3 fw-bold px-3">
                        <i class="bi bi-trash me-1"></i> Xác nhận hủy giao dịch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-payment.js" asp-append-version="true"></script>
}
